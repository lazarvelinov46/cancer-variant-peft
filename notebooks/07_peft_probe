} cc {cap[0]}.{cap[1]} | torch {torch.__version__}\")\nassert cap == (7, 5), f\"need T4 for comparability, got cc {cap}\"\n\ntry:\n    import bitsandbytes as bnb\n    from bitsandbytes.nn import Linear4bit\n    print(f\"bitsandbytes {bnb.__version__} imported OK\")\nexcept Exception as e:\n    print(f\"IMPORT FAILED: {type(e).__name__}: {e}\")\n    print(\">>> VERDICT: QLoRA blocked — proceed with a 2-arm grid\"); sys.exit()\n\n# ---- does 4-bit quantisation actually compute on this card? ------------------\ntorch.manual_seed(0)\nref = torch.nn.Linear(768, 256).cuda().half()\nq = Linear4bit(768, 256, bias=True, compute_dtype=torch.float16,\n               quant_type=\"nf4\", compress_statistics=True)\nq.weight = bnb.nn.Params4bit(ref.weight.data.clone(), requires_grad=False,\n                             quant_type=\"nf4\")\nq.bias = torch.nn.Parameter(ref.bias.data.clone())\nq = q.cuda()\n\nx = torch.randn(16, 768, device=\"cuda\", dtype=torch.float16)\ntry:\n    with torch.no_grad():\n        y_ref, y_q = ref(x), q(x)\n    err = (y_q.float() - y_ref.float()).abs().mean() / y_ref.float().abs().mean()\n    print(f\"4-bit forward OK | finite {torch.isfinite(y_q).all().item()} \"\n          f\"| mean rel error {err:.4f}\")\n    assert torch.isfinite(y_q).all() and err < 0.25, \"4-bit output degenerate\"\nexcept Exception as e:\n    print(f\"4-BIT FORWARD FAILED: {type(e).__name__}: {e}\")\n    print(\">>> VERDICT: QLoRA blocked — proceed with a 2-arm grid\"); sys.exit()\n\n# ---- gradient flow through a frozen 4-bit layer ------------------------------\nx = torch.randn(16, 768, device=\"cuda\", dtype=torch.float16, requires_grad=True)\nq(x).float().sum().backward()\nok = x.grad is not None and torch.isfinite(x.grad).all()\nprint(f\"backward through 4-bit layer: {'OK' if ok else 'FAILED'}\")\n\nprint(f\"\\nmemory: fp16 weights {ref.weight.numel()*2/2**20:.2f} MB \"\n      f\"-> 4-bit {q.weight.numel()*0.5/2**20 if hasattr(q.weight,'numel') else 0:.2f} MB (nominal)\")\n