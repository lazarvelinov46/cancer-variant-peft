03, \"steps_run\": 1000, \"ms_per_step\": 786.5818122979986, \"params_backbone\": 116477952, \"params_head\": 198914, \"lr_bb\": 2e-05, \"lr_head\": 0.0001, \"regime\": \"lpft_full\", \"subset_fp\": \"5f80a1a0c0a87af4\", \"gate\": 0.7094, \"gate_sd\": 0.0034}\n\npeft config: targets ['Wqkv', 'dense', 'gated_layers', 'wo'] | dropout 0.05 | bias none | task_type None\npins recorded at probe time: {\"transformers\": \"4.43.4\", \"peft\": \"0.19.1\", \"bitsandbytes\": \"0.50.0\", \"torch\": \"2.10.0+cu128\"}\n\n>>> guards PASS — proceed to cell 3 (data load + subset/plan fingerprints) <<<\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# 08_lora_grid · cell 3 — data, embeddings, fingerprint guards (CPU, ~25 s)\nimport hashlib, numpy as np, pandas as pd\n\nB_TRAIN, B_EVAL, STEPS, MAXLEN = 24, 64, 1000, 256\nN_GRID, SEEDS = [256, 512, 1024, 2048, 4096], [0, 1, 2]\n\ndf = pd.read_parquet(PATHS[\"parquet\"])\nprint(f\"parquet {df.shape[0]:,} rows x {df.shape[1]} cols\")\n\ntr_f = df[df.split == \"train\"].reset_index(drop=True).assign(_i=lambda d: np.arange(len(d)))\nva_f = df[df.split == \"val\"  ].reset_index(drop=True).assign(_i=lambda d: np.arange(len(d)))\n\n# ---------- attachment guard (stale kernel pins fail silently) ----------------\nEXPECT = {\"train\": (434, 37_241, 5_309), \"val\": (155, 6_450, 1_125),\n          \"test\":  (40,  48_328, 9_284)}\nprint(f\"\\n{'split':<6} {'genes':>6} {'rows':>8} {'pos':>7} {'pos%':>7}\")\nfor nm in (\"train\", \"val\", \"test\"):\n    f = df[df.split == nm]\n    got = (f.gene.nunique(), len(f), int(f.label.sum()))\n    print(f\"{nm:<6} {got[0]:>6} {got[1]:>8,} {got[2]:>7,} {got[2]/got[1]:>6.1%}\")\n    assert got == EXPECT[nm], f\"{nm} drift: {got} != {EXPECT[nm]}\"\nassert df.gene.nunique() == 629, df.gene.nunique()\nassert int(df.hard_eval.sum()) == 1_216, int(df.hard_eval.sum())\n\n# geometry: use the schema's own guarantees, then verify the load-bearing one\nassert (df.win_len == 1024).all() and (df.offset == 512).all()\nassert df.ref_window.str.len().eq(1024).all(), \"ref_window not uniform 1024 bp\"\nmismatch = (df.ref_window.str[512] != df.ref)\nassert not mismatch.any(), f\"ref base != window[512] on {int(mismatch.sum()):,} rows\"\nprint(f\"attachment guard PASS — 629 genes, 1,216 movers, \"\n      f\"ref==window[512] on all {len(df):,} rows\")\n\nGENE2SYM = dict(zip(df.gene.astype(str), df.cgc_symbols.astype(str)))   # tables only\n\n# ---------- cached frozen embeddings -----------------------------------------\ndef load_emb(nm, frame):\n    z = np.load(PATHS[f\"emb_{nm}\"], allow_pickle=True)\n    keys = list(z.keys())\n    print(f\"\\nemb_{nm}: {keys}\")\n    for k in keys:\n        print(f\"  {k:<12} {str(z[k].shape):>16}  {z[k].dtype}\")\n    lab = z[\"label\"].astype(np.int64)\n    assert np.array_equal(lab, frame.label.values.astype(np.int64)), f\"{nm} npz misaligned\"\n    if   \"diff\" in keys: D, how = z[\"diff\"].astype(np.float32), \"diff\"\n    elif \"d\"    in keys: D, how = z[\"d\"].astype(np.float32),    \"d\"\n    else:\n        rk = next(k for k in keys if k in (\"h_ref\", \"ref\", \"emb_ref\"))\n        ak = next(k for k in keys if k in (\"h_alt\", \"alt\", \"emb_alt\"))\n        D, how = z[ak].astype(np.float32) - z[rk].astype(np.float32), f\"{ak} - {rk}\"\n    assert D.shape == (len(frame), 768), D.shape\n    print(f\"  -> D = {how}\")\n    return D, lab\n\nDtr, ytr = load_emb(\"train\", tr_f)\nDva, yva = load_emb(\"val\",   va_f)\nprint(f\"\\nmean ||d||: train {np.linalg.norm(Dtr, axis=1).mean():.4f} | \"\n      f\"val {np.linalg.norm(Dva, axis=1).mean():.4f}    (nb06 cache: 0.055)\")\n\n# ---------- generators: verbatim from nb06, fingerprints must reproduce -------\ndef fingerprint(frame):\n    return hashlib.sha256(\"|\".join(f\"{r.chrom}:{r.pos}{r.ref}>{r.alt}\"\n                                   for r in frame.itertuples()).encode()).hexdigest()[:16]\n\ndef make_subset(N, seed):\n    rng = np.random.default_rng(seed)\n   