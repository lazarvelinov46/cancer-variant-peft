: fp, \"subset_fp\": fingerprint(sub),\n                    \"n_train\": N, \"seed\": s, \"cached_sel_auc\": float(auc),\n                    \"converged_step\": int(step), \"genes\": int(sub.gene.nunique()),\n                    \"pos_genes\": int(pg), \"lr\": LR_LP, \"wd\": WD,\n                    \"steps\": LP_STEPS, \"batch\": B_TRAIN}, path)\n        chk = torch.load(path, map_location=\"cpu\", weights_only=False)\n        assert head_fp(chk[\"state_dict\"]) == fp, \"reload mismatch\"\n        INDEX[f\"{N}_{s}\"] = {\"path\": path, \"fingerprint\": fp, \"sel_auc\": round(float(auc), 4),\n                             \"step\": int(step), \"genes\": int(sub.gene.nunique()),\n                             \"pos_genes\": int(pg), \"subset_fp\": fingerprint(sub)}\n        print(f\"{N:>6} {s:>5} {sub.gene.nunique():>6} {pg:>10} {auc:>9.4f} \"\n              f\"{step:>5} {fp:<17}{time.perf_counter()-t0:>4.0f}s\")\n\nassert INDEX[\"4096_0\"][\"fingerprint\"] == \"9587d93d9bf6acd7\"\nassert len(set(v[\"fingerprint\"] for v in INDEX.values())) == 15, \"duplicate head inits\"\njson.dump(INDEX, open(f\"{SHARED}/head_index.json\", \"w\"), indent=2)\nprint(f\"\\n15 head inits written to {SHARED} | index -> head_index.json\")\nprint(\">>> proceed to cell 8 (the runner) <<<\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T08:44:45.527156Z","iopub.execute_input":"2026-07-30T08:44:45.527920Z","iopub.status.idle":"2026-07-30T08:45:34.919650Z","shell.execute_reply.started":"2026-07-30T08:44:45.527887Z","shell.execute_reply":"2026-07-30T08:45:34.918628Z"}},"outputs":[{"name":"stdout","text":"(4096, 0) sel AUC 0.7023 @ step 100 | fp 9587d93d9bf6acd7\nANCHOR HEAD REPRODUCED BITWISE — generator verified against nb06\n\n     N  seed  genes  pos-genes   sel AUC  step fp                   s\n   256     0    107         59    0.6598    50 9325bd2886493b65    3s\n   256     1    106         63    0.6263   100 e76072c87e02d5c0    3s\n   256     2    112         66