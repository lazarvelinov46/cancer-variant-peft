nt(ys.sum())\n    tp = np.cumsum(ys)\n    k  = np.arange(1, len(ys) + 1, dtype=np.int64)\n    fp, fn = k - tp, P - tp\n    tn = N - fp\n    num = (tp * tn - fp * fn).astype(float)\n    den = np.sqrt((tp + fp).astype(float) * (tp + fn) * (tn + fp) * (tn + fn))\n    mcc = np.divide(num, den, out=np.zeros_like(num), where=den > 0)\n    keep = np.r_[np.diff(ps) != 0, True]\n    return ps[keep], mcc[keep]\n\ndef tune_threshold(p, y):\n    th, m = mcc_curve(p, y)\n    i = int(np.argmax(m))\n    return float(th[i]), float(m[i])\n\ndef metrics_at(p, y, thr):\n    yhat = (p >= thr).astype(int)\n    tp = int(((yhat == 1) & (y == 1)).sum()); tn = int(((yhat == 0) & (y == 0)).sum())\n    fp = int(((yhat == 1) & (y == 0)).sum()); fn = int(((yhat == 0) & (y == 1)).sum())\n    prec = tp / (tp + fp) if tp + fp else 0.0\n    rec  = tp / (tp + fn) if tp + fn else 0.0\n    return {\"auc\": float(roc_auc_score(y, p)), \"auprc\": float(average_precision_score(y, p)),\n            \"f1\": 2 * prec * rec / (prec + rec) if prec + rec else 0.0,\n            \"precision\": prec, \"recall\": rec, \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn}\n\n# ---------- config ------------------------------------------------------------\n@dataclass\nclass CellConfig:\n    arm: str; N: int; seed: int\n    lr_bb: float; lr_head: float = 1e-4\n    r: int = 16; steps: int = STEPS; B: int = B_TRAIN\n    eval_every: int = EVAL_EVERY; warmup: int = WARMUP\n    select_by: str = \"auc\"       # fixed in advance; MCC also recorded for all top-3\n    head_init: str = \"\"          # explicit, so a QLoRA arm can override\n    tag: str = \"\"\n    def __post_init__(self):\n        if not self.head_init:\n            self.head_init = HEAD_INDEX[f\"{self.N}_{self.seed}\"][\"path\"]\n    @property\n    def run_id(self):\n        r = f\"_r{self.r}\" if self.arm != \"full\" else \"\"\n        return f\"{self.arm}{r}_lr{self.lr_bb:g}_n{self.N}_s{self.seed}{self.tag}\"\n\n# ---------- helpers -----------------------------------------------------------\ndef build(cfg):\n    bb = fresh_backbone()\n    if cfg.arm == \"lora\":\n        bb = build_lora(bb, cfg.r)\n    m  = SiameseVariantClassifier(bb, new_head())\n    hd = torch.load(cfg.head_init, map_location=\"cpu\", weights_only=False)\n    assert head_fp(hd[\"state_dict\"]) == HEAD_INDEX[f\"{cfg.N}_{cfg.seed}\"][\"fingerprint\"]\n    m.head.load_state_dict(hd[\"state_dict\"])\n    ok, _ = eager_ok(m.backbone); assert ok, \"eager attention lost\"\n    return m.cuda(), hd\n\ndef trainable_sd(m):\n    return {n: p.detach().cpu().clone() for n, p in m.named_parameters() if p.requires_grad}\n\ndef y_of(batches):\n    \"\"\"Labels in the exact order `evaluate` returns predictions.\"\"\"\n    return torch.cat([b[4] for b in batches]).numpy()\n\ndef evaluate(m, batches):\n    m.eval(); out = []\n    with torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n        for ri, rm, ai, am_, y in batches:\n            out.append(torch.softmax(m(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n                                     .float(), 1)[:, 1].cpu())\n    return torch.cat(out).numpy()\n\ndef probe_loss(m):\n    ri, rm, ai, am_, y = PROBE_BATCH\n    m.eval()\n    with torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n        lg = m(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n    return float(nn.functional.cross_entropy(lg.float(), y.cuda()))\n\n# ---------- the runner --------------------------------------------------------\ndef run_cell(cfg, val_batches=None, verbose=True):\n    val_batches = VAL_BATCHES if val_batches is None else val_batches\n    y_ev = y_of(val_batches)\n    rd = os.path.join(OUT_ROOT, cfg.run_id); os.makedirs(rd, exist_ok=True)\n    resume = os.path.join(rd, \"resume.pt\")\n\n    sub  = SUBSETS[(cfg.N, cfg.seed)]\n    plan = build_plan(sub, cfg.B, cfg.steps, cfg.seed)\n    torch.manual_seed(cfg.seed); torch.cuda.manual_seed_all(cfg.seed)\n    model, hd = build(cfg)\n    opt = torch.optim.Ad