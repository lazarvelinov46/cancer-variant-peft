th.getmtime(p))):<17} {p}\")\n\n# ---------- recipe recovered from notebook 06, not from the brief -------------\nman = json.load(open(PATHS[\"baselines\"]))\nrec = man[\"recipe\"]\nprint(f\"\\nrecipe recorded by nb06: {json.dumps(rec)}\")\nfor key, want in [(\"regime\", \"LP-FT\"), (\"lr_backbone\", 2e-5), (\"lr_head\", 1e-4),\n                  (\"steps\", 1000), (\"batch\", 24), (\"warmup\", 100),\n                  (\"eval_every\", 50), (\"patience\", 5), (\"topk\", 3)]:\n    assert rec[key] == want, f\"recipe drift: {key} = {rec[key]!r}, expected {want!r}\"\nprint(\"recipe assertions PASS — head LR 1e-4 confirmed from artifact\")\n\nfor k, want in [(\"train_subset_n4096\", \"5f80a1a0c0a87af4\"),\n                (\"val_selection_2000\", \"46fbf402505ab8a1\")]:\n    got = man[\"fingerprints\"][k]\n    assert got == want, f\"{k}: {got} != {want}\"\nassert man[\"head_init\"][\"fingerprint\"] == \"9587d93d9bf6acd7\", man[\"head_init\"][\"fingerprint\"]\nprint(\"manifest fingerprints PASS (subset, val selection, head init)\")\n\n# ---------- anchor cell provenance -------------------------------------------\nanc = json.load(open(PATHS[\"anchor\"]))\nprint(f\"\\nanchor (4096, full, seed 0): {json.dumps(anc)}\")\n\n# ---------- LoRA targets from notebook 07 ------------------------------------\npc = json.load(open(PATHS[\"peft_cfg\"]))\nassert pc[\"lora_target_modules\"] == [\"Wqkv\", \"dense\", \"gated_layers\", \"wo\"], pc\nassert pc[\"lora_dropout\"] == 0.05 and pc[\"bias\"] == \"none\" and pc[\"task_type\"] is None\nprint(f\"\\npeft config: targets {pc['lora_target_modules']} | dropout {pc['lora_dropout']} \"\n      f\"| bias {pc['bias']} | task_type {pc['task_type']}\")\nprint(f\"pins recorded at probe time: {json.dumps(pc['pins'])}\")\nprint(\"\\n>>> guards PASS — proceed to cell 3 (data load + subset/plan fingerprints) <<<\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T08:43:15.004126Z","iopub.execute_input":"2026-07-30T08:43:15.004