POOLED over {len(d)} pairs: {m:+.4f} +/- {sd:.4f} | SE {se:.4f}\")\nprint(f\"  95% normal-approx: {m-t*se:+.4f} .. {m+t*se:+.4f}\")\ntt = stats.ttest_rel(W.auc_lora, W.auc_full)\nws = stats.wilcoxon(W.auc_lora, W.auc_full)\nprint(f\"  paired t: t={tt.statistic:+.3f} p={tt.pvalue:.3f} | \"\n      f\"Wilcoxon: W={ws.statistic:.0f} p={ws.pvalue:.3f}\")\n\n# ---------- paired bootstrap -------------------------------------------------\nrng = np.random.default_rng(0)\nB = 2000\nbs = np.array([rng.choice(d, len(d), replace=True).mean() for _ in range(B)])\nlo, hi = np.percentile(bs, [2.5, 97.5])\nprint(f\"\\npaired bootstrap ({B:,} resamples of the 15 PAIRS, not the 30 runs):\")\nprint(f\"  mean {bs.mean():+.4f} | 95% percentile {lo:+.4f} .. {hi:+.4f}\")\nprint(f\"  P(LoRA better) = {(bs > 0).mean():.3f}\")\nprint(f\"  NOTE: 15 units is few; percentile interval is coarse. Report it\")\nprint(f\"        alongside the normal-approx, not instead of it.\")\n\n# ---------- monotonicity (brief: MUST accompany the pooled figure) ----------\nprint(f\"\\n{'='*88}\\nTREND IN N — pooling assumes a constant difference. It is not.\\n{'='*88}\")\nprint(\"  per-N means: \" + \", \".join(f\"{p['mean']:+.4f}\" for p in per))\nsp = stats.spearmanr([p[\"N\"] for p in per], [p[\"mean\"] for p in per])\nlr = stats.linregress(np.log2(W.N), W.d_auc)\nprint(f\"  Spearman(N, mean) rho={sp.statistic:+.3f} p={sp.pvalue:.3f} (n=5 cells)\")\nprint(f\"  OLS on log2(N), all 15 pairs: slope {lr.slope:+.5f} \"\n      f\"+/- {lr.stderr:.5f} | p={lr.pvalue:.3f} | R2={lr.rvalue**2:.3f}\")\nprint(f\"  No per-N interval excludes zero -> trend in POINT ESTIMATES only.\")\n\n# ---------- skipped_steps ----------------------------------------------------\nprint(f\"\\n{'='*88}\\nskipped_steps vs lift (final_grad_scale dropped: same variable)\\n{'='*88}\")\nfor arm, g in A.groupby(\"arm\"):\n    pe = stats.pearsonr(g.skipped, g.lift)\n    sr = stats.spearmanr(g.skipped, g.lift)\n    print(f\"  {arm:<5} n={len(g)} 