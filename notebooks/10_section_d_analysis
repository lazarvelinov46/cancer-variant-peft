001b[0m \u001b[0mby\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   7195\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   7196\u001b[0m             \u001b[0;31m# need to rewrap columns in Series to apply key function\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.12/dist-packages/pandas/core/generic.py\u001b[0m in \u001b[0;36m_get_label_or_level_values\u001b[0;34m(self, key, axis)\u001b[0m\n\u001b[1;32m   1912\u001b[0m             \u001b[0mvalues\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0maxes\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0maxis\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mget_level_values\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_values\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1913\u001b[0m         \u001b[0;32melse\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1914\u001b[0;31m             \u001b[0;32mraise\u001b[0m \u001b[0mKeyError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1915\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1916\u001b[0m         \u001b[0;31m# Check for duplicates\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyError\u001b[0m: 'kind'"],"ename":"KeyError","evalue":"'kind'","output_type":"error"}],"execution_count":1},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D0c — Gate D0-c (patched) + duplicate detection\n# CPU, seconds. Uses df / RUNS from D0. Writes nothing.\n\nimport os, json\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\n\ndef max_mcc(p, y):\n    o  = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P  = int(ys.sum()); Nn = len(ys) - P\n    tp = np.cumsum(ys); k = np.arange(1, len(ys)+1, dtype=np.int64)\n    fp, fn = k - tp, P - tp\n    tn = Nn - fp\n    num = (tp*tn - fp*fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float)*(tp+fn)*(tn+fp)*(tn+fn))\n    return float(np.divide(num, den, out=np.zeros_like(num), where=den > 0).max())\n\ndef load_logits(rid, npzname):\n    \"\"\"Two conventions exist. Post-nb08: label + p_s{step}. nb08-era: y + p + step.\"\"\"\n    z = np.load(os.path.join(RUNS, rid, npzname))\n    if \"label\" in z.files:\n        return z[\"label\"], {int(k[3:]): z[k] for k in z.files if k.startswith(\"p_s\")}\n    return z[\"y\"], {int(z[\"step\"]): z[\"p\"]}\n\nY0, preds_all, rows = None, {}, []\nfor r in df.itertuples():\n    if not r.npz: continue\n    y, preds = load_logits(r.run_id, r.npz)\n    if Y0 is None: Y0 = y\n    same_y = bool(np.array_equal(y, Y0))\n    if r.step in preds:\n        p = preds[r.step]\n        rows.append({\"run_id\": r.run_id, \"kind\": r.kind,\n                     \"d_auc\": abs(roc_auc_score(y, p) - r.auc),\n                     \"d_mcc\": abs(max_mcc(p, y) - r.mcc), \"same_y\": same_y})\n        preds_all[r.run_id] = p\n    else:\n        rows.append({\"run_id\": r.run_id, \"kind\": r.kind, \"d_auc\": np.nan,\n                     \"d_mcc\": np.nan, \"same_y\": same_y})\n\nchk = pd.DataFrame(rows)\nbad = chk[chk.d_auc.isna()]\n\nprint(f\"{'='*72}\\nGATE D0-c — recompute AUC / max-MCC from stored logits\\n{'='*72}\")\nprint(f\"checked {chk.d_auc.notna().sum()} of {len(chk)} runs\")\nprint(f\"  max |delta AUC| {chk.d_auc.max():.2e}\")\nprint(f\"  max |delta MCC| {chk.d_mcc.max():.2e}\")\nprint(f\"  identical label array: {chk.same_y.all()} \"\n      f\"({len(Y0):,} rows, {int(Y0.sum()):,} pos, {Y0.mean():.1%})\")\nif len(bad):\n    print(f\"  no logits at selected step: {list(bad.run_id)}\")\nok_c = chk.d_auc.max() < 1e-6 and chk.d_mcc.max() < 1e-6 and chk.same_y.all()\nprint(\"PASS — stored logits reproduce reported metrics. All of Section D is CPU.\"\n      if ok_c else \"*** FAIL — investigate before proceeding. ***\")\n\n# ---------- GATE D0-d: duplicate runs ---------------------------------------\nprint(f\"\\n{'='*72}\\nGATE D0-d — duplicate runs (identical prediction vectors)\\n{'='*72}\")\nids, dupes = list(preds_all), []\nfor i in range(len(ids)):\n    for j in range(i+1, len(ids)):\n        if np.array_equal(preds_all[ids[i]], preds_all[ids[j]]):\n            dupes.append((ids[i], ids[j]))\nif dupes:\n    for a, b in dupes:\n        print(f\"  IDENTICAL: {a}\\n          == {b}\")\n    print(f\"\\n  {len(dupes)} duplicate pair(s). These MUST NOT both enter any\")\n    print(f\"  aggregate. Expected: the nb08-era anchor, and _nopatience runs whose\")\n    print(f\"  selected checkpoint predates the point their cached twin stopped.\")\nelse:\n    print(\"  none — every run has a distinct prediction vector.\")\n\n# ---------- the scale/skipped identity ---------------------------------------\nprint(f\"\\n{'='*72}\\nfinal_grad_scale vs skipped_steps\\n{'='*72}\")\ng = df.dropna(subset=[\"scale\", \"skipped\"]).copy()\ng[\"implied\"] = 16 - np.log2(g[\"scale\"])\ng[\"excess\"]  = g[\"skipped\"] - g[\"implied\"]\nprint(f\"  runs with both fields: {len(g)}\")\nfor e, sub in g.groupby(\"excess\"):\n    print(f\"  skipped - (16 - log2 scale) = {e:+.0f}  |  {len(sub)} runs  |  \"\n          f\"steps_run {sorted(set(sub.steps_run.dropna().astype(int)))}\")\nprint(\"  -> scale is a deterministic function of skipped (plus scaler growth on\")\nprint(\"     runs past the 2,000-step growth interval). ONE variable, not two.\")\nprint(\"     Section D uses skipped_steps; final_grad_scale is dropped.\")\n\n# ---------- analysis population ----------------------------------------------\nDROP_DUP = {b for _, b in dupes} | {\"siamese_lpft_n4096_seed0\"}\nGRID = df[(df.kind == \"GRID\")].copy()\nNO_VERDICT = [r.run_id for r in GRID.itertuples() if r.verdict == \"—\"]\nprint(f\"\\nGRID: {len(GRID)} cells, {len(GRID.groupby(['N','seed']))} pairs\")\nprint(f\"  missing `verdict` (nb08-era): {NO_VERDICT}\")\nprint(f\"  -> never compare m.get('verdict') to a string; recompute from lift.\")\nprint(f\"excluded from aggregates: {sorted(DROP_DUP)}\")\nprint(\"D0c OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-06T13:37:26.97459Z","iopub.execute_input":"2026-09-06T13:37:26.974916Z","iopub.status.idle":"2026-09-06T13:37:26.998299Z","shell.execute_reply.started":"2026-09-06T13:37:26.974886Z","shell.execute_reply":"2026-09-06T13:37:26.997201Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/89327125.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     24\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     25\u001b[0m \u001b[0mY0\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mpreds_all\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mrows\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;32mNone\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m{\u001b[0m\u001b[0;34m}\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m[\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 26\u001b[0;31m \u001b[0;32mfor\u001b[0m \u001b[0mr\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mdf\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mitertuples\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     27\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0mr\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnpz\u001b[0m\u001b[0;34m:\u001b[0m \u001b[0;32mcontinue\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     28\u001b[0m     \u001b[0my\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mpreds\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mload_logits\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mr\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mrun_id\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mr\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnpz\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mNameError\u001b[0m: name 'df' is not defined"],"ename":"NameError","evalue":"name 'df' is not defined","output_type":"error"}],"execution_count":2},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D1 — analysis frame, recomputed verdicts,\n# boundary flags. CPU, seconds. Uses df / RUNS / DROP_DUP from D0/D0c.\n\nimport os, json\nimport numpy as np, pandas as pd\n\nPB = json.load(open(f\"{RUNS}/shared/probe_baselines_full_val.json\"))\nprint(f\"probe_baselines: {len(PB)} cells | fields: {sorted(next(iter(PB.values())))}\")\n\nLIFT_GAIN = 0.02\nrecs = []\nfor r in df[df.kind == \"GRID\"].itertuples():\n    if r.run_id in DROP_DUP: continue\n    p = os.path.join(RUNS, r.run_id)\n    m    = json.load(open(f\"{p}/metrics.json\"))\n    hist = json.load(open(f\"{p}/history.json\"))\n    pb   = PB[f\"{int(r.N)}_{int(r.seed)}\"]\n\n    sel_hist  = [h[\"sel_auc\"] for h in hist]\n    probe_sel = pb[\"sel_auc\"]\n    lift      = m[\"auc\"] - pb[\"full_val_auc\"]\n    ever_up   = max(sel_hist) > probe_sel\n    peak_i    = int(np.argmax(sel_hist))\n\n    if   lift >= LIFT_GAIN: v = \"GAIN\"\n    elif lift > 0:          v = \"MARGINAL\"\n    elif ever_up:           v = \"DEGRADED (learned then lost)\"\n    else:                   v = \"NULL (never learned)\"\n\n    stopped_early = m[\"steps_run\"] < m[\"steps\"]\n    recs.append({\n        \"run_id\": r.run_id, \"arm\": m[\"arm\"], \"N\": m[\"N\"], \"seed\": m[\"seed\"],\n        \"auc\": m[\"auc\"], \"mcc\": m[\"mcc\"], \"auprc\": m[\"auprc\"], \"f1\": m[\"f1\"],\n        \"probe_auc\": pb[\"full_val_auc\"], \"probe_mcc\": pb[\"full_val_mcc\"],\n        \"lift\": lift, \"lift_mcc\": m[\"mcc\"] - pb[\"full_val_mcc\"],\n        \"step\": m[\"step\"], \"steps_run\": m[\"steps_run\"], \"steps\": m[\"steps\"],\n        \"n_evals\": len(hist), \"peak_eval\": peak_i + 1,\n        \"peak_at_first\": peak_i == 0, \"ever_above_probe\": ever_up,\n        \"skipped\": m[\"skipped_steps\"], \"ms\": m[\"ms_per_step\"],\n        \"gb\": m[\"peak_gb\"], \"session\": m.get(\"session_id\"),\n        \"verdict_old\": m.get(\"verdict\", \"MISSING\"), \"verdict_new\": v,\n        \"boundary\": \"patience\" if stopped_early else \"budget\",\n        \"at_risk\": stopped_early and peak_i > 0})\n\nA = pd.DataFrame(recs).sort_values([\"arm\", \"N\", \"seed\"]).reset_index(drop=True)\nassert len(A) == 30, len(A)\n\nprint(f\"\\n{'='*112}\")\nprint(A[[\"run_id\", \"arm\", \"N\", \"seed\", \"probe_auc\", \"auc\", \"lift\", \"step\",\n         \"steps_run\", \"skipped\", \"boundary\", \"verdict_old\",\n         \"verdict_new\"]].to_string(index=False))\nprint(f\"{'='*112}\")\n\n# ---------- how much the verdict changes ------------------------------------\nprint(\"\\nrecomputed verdict distribution:\")\nprint(A.groupby([\"arm\", \"verdict_new\"]).size().to_string())\nprint(\"\\nold vs new (the vacuous-clean defect, quantified):\")\nct = pd.crosstab(A.verdict_old, A.verdict_new)\nprint(ct.to_string())\nvac = A[(A.verdict_old == \"clean\") & (A.lift <= 0)]\nprint(f\"\\n{len(vac)} runs labelled `clean` while at or below their own probe:\")\nprint(vac[[\"run_id\", \"lift\", \"verdict_new\"]].to_string(index=False))\nprint(f\"{(A.verdict_old == 'MISSING').sum()} runs have NO stored verdict \"\n      f\"(nb08-era): {list(A[A.verdict_old=='MISSING'].run_id)}\")\n\n# ---------- below-probe counts, the corrected version ------------------------\nprint(f\"\\nbelow own probe (lift <= 0):\")\nfor arm, sub in A.groupby(\"arm\"):\n    print(f\"  {arm:<5} {(sub.lift <= 0).sum()} of {len(sub)}   \"\n          f\"lift sd {sub.lift.std():.4f}  range \"\n          f\"{sub.lift.min():+.4f} .. {sub.lift.max():+.4f}\")\n\n# ---------- patience exposure, post-F5 ---------------------------------------\nprint(f\"\\npatience exposure (F5 showed never-learned runs gain nothing from more steps):\")\nfor arm, sub in A.groupby(\"arm\"):\n    e = sub[sub.boundary == \"patience\"]\n    print(f\"  {arm:<5} stopped early {len(e):>2} | of those, peak at FIRST eval \"\n          f\"{int(e.peak_at_first.sum()):>2} (not at risk) | \"\n          f\"peak later {int((~e.peak_at_first).sum()):>2} (AT RISK)\")\nrisk = A[A.at_risk]\nprint(f\"\\n{len(risk)} runs genuinely at risk of patience truncation:\")\nprint(risk[[\"run_id\", \"lift\", \"step\", \"steps_run\", \"peak_eval\",\n            \"ever_above_probe\"]].to_string(index=False) if len(risk) else \"  none\")\n\nA.to_csv(\"/kaggle/working/d1_analysis_frame.csv\", index=False)\nprint(\"\\nframe -> /kaggle/working/d1_analysis_frame.csv | D1 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:04.012112Z","iopub.execute_input":"2026-09-01T07:58:04.012447Z","iopub.status.idle":"2026-09-01T07:58:04.400586Z","shell.execute_reply.started":"2026-09-01T07:58:04.012421Z","shell.execute_reply":"2026-09-01T07:58:04.399424Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D2 — pre-declared analysis #1 (paired LoRA vs\n# full), bootstrap CI, monotonicity, and the skipped_steps diagnostic.\n# CPU, seconds. Uses A from D1.\n\nimport numpy as np, pandas as pd\nfrom scipy import stats\n\nW = A.pivot_table(index=[\"N\", \"seed\"], columns=\"arm\",\n                  values=[\"auc\", \"mcc\", \"lift\", \"skipped\", \"ms\", \"gb\",\n                          \"steps_run\", \"session\"], aggfunc=\"first\")\nW.columns = [f\"{a}_{b}\" for a, b in W.columns]\nW = W.reset_index()\nW[\"d_auc\"]  = W[\"auc_lora\"]  - W[\"auc_full\"]\nW[\"d_mcc\"]  = W[\"mcc_lora\"]  - W[\"mcc_full\"]\nW[\"d_lift\"] = W[\"lift_lora\"] - W[\"lift_full\"]\nassert len(W) == 15, len(W)\n\nprint(f\"{'='*88}\\nPAIRED DIFFERENCES (LoRA - full FT), full-val AUC\\n{'='*88}\")\nprint(W[[\"N\", \"seed\", \"auc_full\", \"auc_lora\", \"d_auc\", \"lift_full\",\n         \"lift_lora\", \"d_lift\"]].to_string(index=False))\n\n# ---------- per-N ------------------------------------------------------------\nprint(f\"\\n{'N':>6}{'n':>3}{'mean':>10}{'sd':>10}{'SE':>10}{'2-SE band':>24}\")\nper = []\nfor N, g in W.groupby(\"N\"):\n    m, sd = g.d_auc.mean(), g.d_auc.std(ddof=1)\n    se = sd / np.sqrt(len(g))\n    per.append({\"N\": N, \"mean\": m, \"se\": se})\n    print(f\"{N:>6}{len(g):>3}{m:>+10.4f}{sd:>10.4f}{se:>10.4f}\"\n          f\"   {m-2*se:>+8.4f} .. {m+2*se:>+8.4f}\")\n\nd  = W.d_auc.values\nm, sd = d.mean(), d.std(ddof=1)\nse = sd / np.sqrt(len(d))\nt  = stats.t.ppf(0.975, len(d) - 1)\nprint(f\"\\nPOOLED over {len(d)} pairs: {m:+.4f} +/- {sd:.4f} | SE {se:.4f}\")\nprint(f\"  95% normal-approx: {m-t*se:+.4f} .. {m+t*se:+.4f}\")\ntt = stats.ttest_rel(W.auc_lora, W.auc_full)\nws = stats.wilcoxon(W.auc_lora, W.auc_full)\nprint(f\"  paired t: t={tt.statistic:+.3f} p={tt.pvalue:.3f} | \"\n      f\"Wilcoxon: W={ws.statistic:.0f} p={ws.pvalue:.3f}\")\n\n# ---------- paired bootstrap -------------------------------------------------\nrng = np.random.default_rng(0)\nB = 2000\nbs = np.array([rng.choice(d, len(d), replace=True).mean() for _ in range(B)])\nlo, hi = np.percentile(bs, [2.5, 97.5])\nprint(f\"\\npaired bootstrap ({B:,} resamples of the 15 PAIRS, not the 30 runs):\")\nprint(f\"  mean {bs.mean():+.4f} | 95% percentile {lo:+.4f} .. {hi:+.4f}\")\nprint(f\"  P(LoRA better) = {(bs > 0).mean():.3f}\")\nprint(f\"  NOTE: 15 units is few; percentile interval is coarse. Report it\")\nprint(f\"        alongside the normal-approx, not instead of it.\")\n\n# ---------- monotonicity (brief: MUST accompany the pooled figure) ----------\nprint(f\"\\n{'='*88}\\nTREND IN N — pooling assumes a constant difference. It is not.\\n{'='*88}\")\nprint(\"  per-N means: \" + \", \".join(f\"{p['mean']:+.4f}\" for p in per))\nsp = stats.spearmanr([p[\"N\"] for p in per], [p[\"mean\"] for p in per])\nlr = stats.linregress(np.log2(W.N), W.d_auc)\nprint(f\"  Spearman(N, mean) rho={sp.statistic:+.3f} p={sp.pvalue:.3f} (n=5 cells)\")\nprint(f\"  OLS on log2(N), all 15 pairs: slope {lr.slope:+.5f} \"\n      f\"+/- {lr.stderr:.5f} | p={lr.pvalue:.3f} | R2={lr.rvalue**2:.3f}\")\nprint(f\"  No per-N interval excludes zero -> trend in POINT ESTIMATES only.\")\n\n# ---------- skipped_steps ----------------------------------------------------\nprint(f\"\\n{'='*88}\\nskipped_steps vs lift (final_grad_scale dropped: same variable)\\n{'='*88}\")\nfor arm, g in A.groupby(\"arm\"):\n    pe = stats.pearsonr(g.skipped, g.lift)\n    sr = stats.spearmanr(g.skipped, g.lift)\n    print(f\"  {arm:<5} n={len(g)} | Pearson r={pe.statistic:+.3f} p={pe.pvalue:.3f}\"\n          f\" | Spearman rho={sr.statistic:+.3f} p={sr.pvalue:.3f}\")\nprint(\"\\n  mean lift by skipped_steps:\")\npiv = A.pivot_table(index=\"skipped\", columns=\"arm\", values=\"lift\",\n                    aggfunc=[\"mean\", \"count\"])\nprint(piv.to_string())\nzi = stats.linregress(A[A.arm==\"full\"].skipped, A[A.arm==\"full\"].lift)\nprint(f\"\\n  full-arm OLS: slope {zi.slope:+.5f} +/- {zi.stderr:.5f} \"\n      f\"p={zi.pvalue:.4f} R2={zi.rvalue**2:.3f}\")\nprint(\"  CAVEAT: skipped_steps is endogenous — a run heading for collapse may\")\nprint(\"  produce the large gradients that cause the overflows. Only the FINAL\")\nprint(\"  count is stored, so temporal precedence cannot be established. Report\")\nprint(\"  as a correlate and a practical warning sign, never as a cause.\")\n\n# ---------- cost -------------------------------------------------------------\nprint(f\"\\n{'='*88}\\nCOST (within-session pairs only)\\n{'='*88}\")\nC = W[W.session_full == W.session_lora].copy()\nC[\"pct\"] = 100 * (C.ms_lora - C.ms_full) / C.ms_full\nprint(f\"  {len(C)} of 15 grid pairs share a session\")\nprint(f\"  ms/step: LoRA {C.pct.mean():+.2f}% +/- {C.pct.std(ddof=1):.2f} \"\n      f\"| range {C.pct.min():+.1f} .. {C.pct.max():+.1f}\")\nV = C[C.steps_run_full == C.steps_run_lora]\nprint(f\"  peak VRAM (matched steps_run only, n={len(V)}): \"\n      f\"{(V.gb_lora - V.gb_full).mean():+.4f} +/- \"\n      f\"{(V.gb_lora - V.gb_full).std(ddof=1):.4f} GB\")\n\nW.to_csv(\"/kaggle/working/d2_paired.csv\", index=False)\nprint(\"\\npaired frame -> /kaggle/working/d2_paired.csv | D2 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:11.700385Z","iopub.execute_input":"2026-09-01T07:58:11.700952Z","iopub.status.idle":"2026-09-01T07:58:11.890671Z","shell.execute_reply.started":"2026-09-01T07:58:11.700917Z","shell.execute_reply":"2026-09-01T07:58:11.88857Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D3 — selection optimism (top-3 max vs average)\n# and pre-declared analysis #6 (init_probe_loss). CPU, seconds.\n# Uses A, W, RUNS, DROP_DUP from D1/D2.\n\nimport os, json\nimport numpy as np, pandas as pd\nfrom scipy import stats\nfrom sklearn.metrics import roc_auc_score\n\ndef max_mcc(p, y):\n    o  = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P  = int(ys.sum()); Nn = len(ys) - P\n    tp = np.cumsum(ys); k = np.arange(1, len(ys)+1, dtype=np.int64)\n    fp, fn = k - tp, P - tp\n    tn = Nn - fp\n    num = (tp*tn - fp*fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float)*(tp+fn)*(tn+fp)*(tn+fn))\n    return float(np.divide(num, den, out=np.zeros_like(num), where=den > 0).max())\n\n# ---------- 1. selection optimism -------------------------------------------\nrows = []\nfor r in A.itertuples():\n    z = np.load(os.path.join(RUNS, r.run_id, \"val_logits_top3.npz\"))\n    y = z[\"label\"]\n    ks = sorted([k for k in z.files if k.startswith(\"p_s\")],\n                key=lambda k: int(k[3:]))\n    aucs = {int(k[3:]): roc_auc_score(y, z[k]) for k in ks}\n    P = np.mean([z[k] for k in ks], axis=0)          # ensemble of the top 3\n    rows.append({\"run_id\": r.run_id, \"arm\": r.arm, \"N\": r.N, \"seed\": r.seed,\n                 \"k\": len(ks), \"reported\": r.auc,\n                 \"top3_max\": max(aucs.values()),\n                 \"top3_mean\": float(np.mean(list(aucs.values()))),\n                 \"top3_min\": min(aucs.values()),\n                 \"ens_auc\": float(roc_auc_score(y, P)),\n                 \"ens_mcc\": max_mcc(P, y), \"mcc\": r.mcc,\n                 \"spread\": max(aucs.values()) - min(aucs.values())})\nS = pd.DataFrame(rows)\nassert np.allclose(S.reported, S.top3_max), \"reported AUC is not the top-3 max\"\n\nprint(f\"{'='*84}\\nSELECTION OPTIMISM — every reported AUC is a max over 3 evaluations\\n{'='*84}\")\nS[\"optimism\"] = S.top3_max - S.top3_mean\nfor arm, g in S.groupby(\"arm\"):\n    print(f\"  {arm:<5} optimism (max - mean) {g.optimism.mean():+.4f} \"\n          f\"+/- {g.optimism.std(ddof=1):.4f} | max {g.optimism.max():+.4f} \"\n          f\"| top-3 spread {g.spread.mean():.4f}\")\no = S.pivot_table(index=[\"N\",\"seed\"], columns=\"arm\", values=\"optimism\")\ndiff = (o[\"lora\"] - o[\"full\"]).dropna()\ntt = stats.ttest_rel(o[\"lora\"], o[\"full\"])\nprint(f\"\\n  asymmetry (LoRA - full optimism): {diff.mean():+.4f} \"\n      f\"+/- {diff.std(ddof=1):.4f} | paired t p={tt.pvalue:.3f}\")\nprint(f\"  -> if ~0, the top-3 max bias is symmetric and does NOT distort the\")\nprint(f\"     pooled paired estimate; it inflates both arms' absolute numbers.\")\n\nprint(f\"\\n  ensembling the top 3 instead of taking the max:\")\nS[\"d_ens\"] = S.ens_auc - S.top3_max\nfor arm, g in S.groupby(\"arm\"):\n    print(f\"    {arm:<5} AUC {g.d_ens.mean():+.4f} +/- {g.d_ens.std(ddof=1):.4f}\"\n          f\" | beats max in {(g.d_ens > 0).sum()}/{len(g)} runs\"\n          f\" | MCC {(g.ens_mcc - g.mcc).mean():+.4f}\")\nprint(f\"  (ensembling is NOT the locked recipe — reported for the writeup only)\")\n\n# ---------- 2. pre-declared analysis #6 -------------------------------------\nPB = json.load(open(f\"{RUNS}/shared/probe_baselines_full_val.json\"))\nA2 = A.copy()\nA2[\"ipl\"]  = [PB[f\"{int(n)}_{int(s)}\"][\"init_probe_loss\"] for n, s in zip(A2.N, A2.seed)]\nA2[\"risk\"] = [PB[f\"{int(n)}_{int(s)}\"][\"risk\"] for n, s in zip(A2.N, A2.seed)]\n\nprint(f\"\\n{'='*84}\\nPRE-DECLARED ANALYSIS #6 — init_probe_loss\\n{'='*84}\")\nprint(\"  declared form: split at init_probe_loss < 1.0\")\nfor arm, g in A2.groupby(\"arm\"):\n    lo_, hi_ = g[g.ipl < 1.0].lift, g[g.ipl >= 1.0].lift\n    ts = stats.ttest_ind(lo_, hi_, equal_var=False)\n    print(f\"    {arm:<5} LOW n={len(lo_)} lift {lo_.mean():+.4f} | \"\n          f\"HIGH n={len(hi_)} lift {hi_.mean():+.4f} | \"\n          f\"diff {lo_.mean()-hi_.mean():+.4f} | Welch p={ts.pvalue:.3f}\")\nprint(\"\\n  continuous form (uses more information at n=15):\")\nfor arm, g in A2.groupby(\"arm\"):\n    pe = stats.pearsonr(g.ipl, g.lift)\n    print(f\"    {arm:<5} Pearson r={pe.statistic:+.3f} p={pe.pvalue:.3f}\")\nprint(\"\\n  outcome by risk label (B5's calibration flag):\")\nprint(A2.pivot_table(index=\"risk\", columns=\"arm\", values=\"lift\",\n                     aggfunc=[\"mean\", \"count\"]).to_string())\n\n# ---------- 3. does skipped_steps survive controlling for init_probe_loss? ---\nprint(f\"\\n  full-arm: skipped_steps vs init_probe_loss as competing predictors\")\nF = A2[A2.arm == \"full\"]\nX = np.column_stack([np.ones(len(F)), F.skipped, F.ipl])\nbeta, *_ = np.linalg.lstsq(X, F.lift.values, rcond=None)\nresid = F.lift.values - X @ beta\ndof = len(F) - 3\nse = np.sqrt(np.diag(np.linalg.pinv(X.T @ X)) * (resid @ resid) / dof)\nfor nm, b, s in zip([\"intercept\", \"skipped\", \"init_probe_loss\"], beta, se):\n    print(f\"    {nm:<18}{b:>+10.5f} +/- {s:.5f} | t={b/s:+.2f} \"\n          f\"| p={2*(1-stats.t.cdf(abs(b/s), dof)):.4f}\")\nprint(f\"    R2 = {1 - (resid@resid)/((F.lift-F.lift.mean())**2).sum():.3f}\")\n\nS.to_csv(\"/kaggle/working/d3_selection.csv\", index=False)\nprint(\"\\n-> /kaggle/working/d3_selection.csv | D3 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:20.101266Z","iopub.execute_input":"2026-09-01T07:58:20.10177Z","iopub.status.idle":"2026-09-01T07:58:20.894584Z","shell.execute_reply.started":"2026-09-01T07:58:20.101731Z","shell.execute_reply":"2026-09-01T07:58:20.893162Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np, glob, collections\np = sorted(glob.glob(\"/kaggle/input/**/emb_val_1024bp.npz\", recursive=True))[0]\nz = np.load(p, allow_pickle=True)\nprint(p, \"\\nkeys:\", z.files)\nmc, y = z[\"mc\"], z[\"label\"]\nprint(\"\\nrows\", len(y), \"| pos\", int(y.sum()))\nfor k, n in collections.Counter(mc).most_common():\n    s = y[mc == k]\n    print(f\"  {str(k):<28} n={n:>5}  pos={int(s.sum()):>5} ({s.mean():.1%})\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:42.197284Z","iopub.execute_input":"2026-09-01T07:58:42.198343Z","iopub.status.idle":"2026-09-01T07:58:42.392021Z","shell.execute_reply.started":"2026-09-01T07:58:42.198245Z","shell.execute_reply":"2026-09-01T07:58:42.391053Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D4 — consequence stratification.\n# (a) exact consequence-only baseline, (b) per-stratum model AUC,\n# (c) missense-only comparison = the scientifically meaningful evaluation,\n# (d) non-coding stratum feasibility for the secondary RQ.\n# CPU, seconds.\n\nimport os, glob, json\nimport numpy as np, pandas as pd\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\nEMB = sorted(glob.glob(\"/kaggle/input/**/emb_val_1024bp.npz\", recursive=True))[0]\nz = np.load(EMB, allow_pickle=True)\nmc_raw, y_emb, hard = z[\"mc\"], z[\"label\"].astype(int), z[\"hard_eval\"]\n\nref = np.load(os.path.join(RUNS, \"step0_fulldata_n37241_s0\",\n                           \"val_logits_step0.npz\"))[\"label\"].astype(int)\nassert np.array_equal(y_emb, ref), \"emb_val row order != logits row order — STOP\"\nprint(f\"alignment OK | {len(y_emb):,} rows | {y_emb.sum():,} pos ({y_emb.mean():.1%})\")\nprint(f\"hard_eval rows in val: {int(np.asarray(hard).astype(bool).sum())}\")\n\nLOF  = {\"SO:0001587\", \"SO:0001575\", \"SO:0001574\"}          # nonsense, splice d/a\nMIS  = {\"SO:0001583\", \"SO:0001582\"}                        # missense, initiator\ndef stratum(s):\n    ts = {t.split(\"|\")[0] for t in str(s).split(\",\") if t}\n    if ts & LOF: return \"LoF\"\n    if ts & MIS: return \"missense\"\n    return \"silent/non-coding\"\nstrat = np.array([stratum(s) for s in mc_raw])\n\nprint(f\"\\n{'stratum':<20}{'rows':>7}{'pos':>7}{'rate':>8}\")\nfor k in (\"LoF\", \"missense\", \"silent/non-coding\"):\n    m = strat == k\n    print(f\"{k:<20}{m.sum():>7,}{y_emb[m].sum():>7,}{y_emb[m].mean():>8.1%}\")\n\n# ---------- (a) consequence-only baseline -----------------------------------\ntier = np.select([strat == \"LoF\", strat == \"missense\"], [2.0, 1.0], default=0.0)\nprint(f\"\\n{'='*76}\\nCONSEQUENCE-ONLY BASELINE (no sequence, no model)\\n{'='*76}\")\nprint(f\"  3-tier rule LoF > missense > silent:\")\nprint(f\"    AUC   {roc_auc_score(y_emb, tier):.4f}\")\nprint(f\"    AUPRC {average_precision_score(y_emb, tier):.4f}\")\nprint(f\"  LoF-vs-rest binary rule: AUC {roc_auc_score(y_emb, (tier==2).astype(float)):.4f}\")\nprint(f\"\\n  best model in study (F4 full FT): AUC 0.8066\")\nprint(f\"  frozen probe on full data:        AUC 0.7328\")\n\n# ---------- (b,c) per-stratum model performance ------------------------------\ndef preds(rid):\n    f = os.path.join(RUNS, rid)\n    n = \"val_logits_step0.npz\" if rid.startswith(\"step0\") else \"val_logits_top3.npz\"\n    zz = np.load(os.path.join(f, n))\n    m = json.load(open(f\"{f}/metrics.json\"))\n    return zz[f\"p_s{m['step']}\"]\n\nMODELS = {\n    \"step 0 (frozen probe)\": \"step0_fulldata_n37241_s0\",\n    \"full FT (F4, best)\":    \"full_lr2e-05_n37241_s0_fd_nopatience\",\n    \"LoRA (F3)\":             \"lora_r16_lr0.0001_n37241_s0_fulldata\",\n    \"full FT grid N=4096\":   \"full_lr2e-05_n4096_s0\",\n    \"LoRA grid N=4096\":      \"lora_r16_lr0.0001_n4096_s0\",\n}\nprint(f\"\\n{'='*76}\\nAUC BY STRATUM — where does the model's signal actually live?\\n{'='*76}\")\nprint(f\"{'model':<24}{'overall':>9}{'LoF':>9}{'missense':>10}{'silent/nc':>11}\")\nout = []\nfor nm, rid in MODELS.items():\n    p = preds(rid)\n    row = {\"model\": nm, \"overall\": roc_auc_score(y_emb, p)}\n    for k, lab in ((\"LoF\", \"LoF\"), (\"missense\", \"missense\"),\n                   (\"silent/non-coding\", \"silent/nc\")):\n        m = strat == k\n        row[lab] = (roc_auc_score(y_emb[m], p[m])\n                    if 0 < y_emb[m].sum() < m.sum() else np.nan)\n    out.append(row)\n    print(f\"{nm:<24}{row['overall']:>9.4f}{row['LoF']:>9.4f}\"\n          f\"{row['missense']:>10.4f}{row['silent/nc']:>11.4f}\")\nprint(f\"{'consequence-only rule':<24}{roc_auc_score(y_emb, tier):>9.4f}\"\n      f\"{'0.5000':>9}{'0.5000':>10}{'0.5000':>11}   <- uninformative WITHIN strata\")\n\nprint(f\"\\n  READ THIS: the consequence rule scores ~0.5 inside every stratum by\")\nprint(f\"  construction. Any within-stratum AUC above 0.5 is signal the\")\nprint(f\"  annotation does not provide. MISSENSE is the meaningful comparison:\")\nprint(f\"  ~35% positive, and consequence class carries no information there.\")\n\n# ---------- missense-only paired grid comparison ------------------------------\nmm = strat == \"missense\"\nprint(f\"\\n{'='*76}\\nMISSENSE-ONLY: paired LoRA - full FT across the 15 grid cells\\n{'='*76}\")\nd = []\nfor (N, s), g in A.groupby([\"N\", \"seed\"]):\n    a = {r.arm: roc_auc_score(y_emb[mm], preds(r.run_id)[mm]) for r in g.itertuples()}\n    d.append({\"N\": N, \"seed\": s, \"full\": a[\"full\"], \"lora\": a[\"lora\"],\n              \"diff\": a[\"lora\"] - a[\"full\"]})\nD = pd.DataFrame(d)\nprint(D.to_string(index=False))\nprint(f\"\\n  pooled missense-only diff: {D['diff'].mean():+.4f} \"\n      f\"+/- {D['diff'].std(ddof=1):.4f} | SE {D['diff'].std(ddof=1)/np.sqrt(len(D)):.4f}\")\nprint(f\"  (overall-set pooled was -0.0045 +/- 0.0301)\")\nprint(f\"  mean missense AUC: full {D.full.mean():.4f} | LoRA {D.lora.mean():.4f}\")\n\npd.DataFrame(out).to_csv(\"/kaggle/working/d4_strata.csv\", index=False)\nprint(\"\\n-> /kaggle/working/d4_strata.csv | D4 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:49.797509Z","iopub.execute_input":"2026-09-01T07:58:49.797911Z","iopub.status.idle":"2026-09-01T07:58:50.309829Z","shell.execute_reply.started":"2026-09-01T07:58:49.797884Z","shell.execute_reply":"2026-09-01T07:58:50.30818Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D5 — verification of the two D4 claims, plus a\n# parameter-free test of whether the model adds anything to the annotation.\n# CPU, ~1-2 min (bootstraps). Writes d5_verified.csv.\n#\n# Claim 1: missense signal is real (F4 > chance, F4 > frozen probe)\n# Claim 2: full FT > LoRA on missense, and this is SPECIFIC to missense\n# Claim 3: does the model add information the consequence rule lacks?\n\nimport numpy as np, pandas as pd\nfrom scipy import stats\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\nfor nm in (\"y_emb\", \"strat\", \"preds\", \"MODELS\", \"A\", \"tier\"):\n    assert nm in globals(), f\"{nm} missing — re-run D4 before D5\"\n\nB_BOOT = 2000\nMM, LOF = strat == \"missense\", strat == \"LoF\"\nprint(f\"missense {MM.sum():,} rows / {y_emb[MM].sum():,} pos | \"\n      f\"LoF {LOF.sum():,} rows / {y_emb[LOF].sum():,} pos\")\n\ndef boot_idx(n, B, seed):\n    rng = np.random.default_rng(seed)\n    return [rng.integers(0, n, n) for _ in range(B)]\n\ndef boot_auc(y, p, ixs):\n    out = []\n    for ix in ixs:\n        yy = y[ix]\n        if 0 < yy.sum() < len(yy):\n            out.append(roc_auc_score(yy, p[ix]))\n    return np.array(out)\n\ndef boot_auc_diff(y, pa, pb, ixs):\n    \"\"\"Paired: same resample for both models, so the CI accounts for the\n    correlation between two models scored on the same rows.\"\"\"\n    out = []\n    for ix in ixs:\n        yy = y[ix]\n        if 0 < yy.sum() < len(yy):\n            out.append(roc_auc_score(yy, pa[ix]) - roc_auc_score(yy, pb[ix]))\n    return np.array(out)\n\n# ---------- CLAIM 1 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 1 — is the missense signal real?\\n{'='*78}\")\nixs_m = boot_idx(int(MM.sum()), B_BOOT, 0)\nym = y_emb[MM]\nP = {nm: preds(rid)[MM] for nm, rid in MODELS.items()}\n\nprint(f\"{'model':<24}{'AUC':>8}{'95% CI':>22}{'P(>0.5)':>10}\")\nrows = []\nfor nm, p in P.items():\n    a = roc_auc_score(ym, p)\n    bs = boot_auc(ym, p, ixs_m)\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    rows.append({\"model\": nm, \"missense_auc\": a, \"lo\": lo, \"hi\": hi})\n    print(f\"{nm:<24}{a:>8.4f}   {lo:>7.4f} .. {hi:<7.4f}{(bs > 0.5).mean():>10.3f}\")\n\nprint(f\"\\n  paired: does fine-tuning beat the frozen probe WITHIN missense?\")\nfor nm in (\"full FT (F4, best)\", \"LoRA (F3)\"):\n    bs = boot_auc_diff(ym, P[nm], P[\"step 0 (frozen probe)\"], ixs_m)\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    print(f\"    {nm:<22} - probe = {bs.mean():+.4f} | 95% {lo:+.4f} .. {hi:+.4f}\"\n          f\" | P(>0) {(bs > 0).mean():.3f}\")\n\n# ---------- CLAIM 2 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 2 — full FT vs LoRA, by stratum (15 paired grid cells)\\n{'='*78}\")\ndef paired_by_stratum(mask, label):\n    d = []\n    for (N, s), g in A.groupby([\"N\", \"seed\"]):\n        a = {r.arm: roc_auc_score(y_emb[mask], preds(r.run_id)[mask])\n             for r in g.itertuples()}\n        d.append(a[\"lora\"] - a[\"full\"])\n    d = np.array(d)\n    se = d.std(ddof=1) / np.sqrt(len(d))\n    tt = stats.ttest_1samp(d, 0)\n    wx = stats.wilcoxon(d)\n    nneg = int((d < 0).sum())\n    sg = stats.binomtest(nneg, len(d), 0.5)\n    rng = np.random.default_rng(1)\n    bs = np.array([rng.choice(d, len(d), replace=True).mean()\n                   for _ in range(B_BOOT)])\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    print(f\"\\n  {label}\")\n    print(f\"    mean {d.mean():+.4f} +/- {d.std(ddof=1):.4f} | SE {se:.4f}\")\n    print(f\"    paired t   t={tt.statistic:+.3f}  p={tt.pvalue:.4f}\")\n    print(f\"    Wilcoxon   W={wx.statistic:.0f}      p={wx.pvalue:.4f}\")\n    print(f\"    sign test  {nneg}/{len(d)} favour full FT, p={sg.pvalue:.4f}\")\n    print(f\"    bootstrap  95% {lo:+.4f} .. {hi:+.4f} | P(LoRA better) {(bs>0).mean():.3f}\")\n    return d\n\nd_mis = paired_by_stratum(MM,  \"MISSENSE (hard: annotation uninformative)\")\nd_lof = paired_by_stratum(LOF, \"LoF (easy: annotation nearly determines label)\")\nd_all = paired_by_stratum(np.ones(len(y_emb), bool), \"OVERALL (for reference)\")\n\nprint(f\"\\n  SPECIFICITY CHECK — is the arm difference missense-specific?\")\nprint(f\"    missense {d_mis.mean():+.4f} | LoF {d_lof.mean():+.4f} \"\n      f\"| overall {d_all.mean():+.4f}\")\nts = stats.ttest_rel(d_mis, d_lof)\nprint(f\"    missense vs LoF difference-of-differences: {(d_mis-d_lof).mean():+.4f} \"\n      f\"| paired t p={ts.pvalue:.4f}\")\nprint(f\"    If full FT wins everywhere, the capacity story is unsupported.\")\nprint(f\"    If it wins on missense only, capacity matters where the task is hard.\")\n\n# ---------- CLAIM 3 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 3 — does the model add anything to the annotation?\\n{'='*78}\")\nprint(\"  Composite = rank by consequence tier, break ties by model score.\")\nprint(\"  No fitting, no learned weights — a deterministic composition.\\n\")\nrule_auc = roc_auc_score(y_emb, tier)\nrule_ap  = average_precision_score(y_emb, tier)\nprint(f\"{'ranking':<30}{'AUC':>9}{'AUPRC':>9}{'