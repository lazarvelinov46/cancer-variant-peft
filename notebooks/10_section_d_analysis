)\n              if os.path.isdir(os.path.join(RUNS, d)) and d != \"shared\")\nprint(f\"\\n{len(dirs)} run directories\")\n\nGRID_RE = re.compile(r\"^(full_lr2e-05|lora_r16_lr0\\.0001)_n(\\d+)_s(\\d)$\")\ndef classify(rid):\n    m = GRID_RE.match(rid)\n    if m and int(m.group(2)) in (256, 512, 1024, 2048, 4096):\n        return \"GRID\"\n    if rid.startswith(\"step0\"):            return \"step0\"\n    if rid.endswith(\"_fulldata\"):          return \"out-of-grid (full data)\"\n    if rid.endswith(\"_nopatience\"):        return \"out-of-grid (patience probe)\"\n    return \"other (nb08-era / smoke)\"\n\nrows, schema, missing_files, ckpt_found = [], {}, [], []\nfor d in dirs:\n    p = os.path.join(RUNS, d)\n    files = set(os.listdir(p))\n    npz = ([f for f in files if f.startswith(\"val_logits\") and f.endswith(\".npz\")]\n           or [None])[0]\n    have = {\"metrics\": \"metrics.json\" in files, \"history\": \"history.json\" in files,\n            \"top\": \"top.json\" in files, \"logits\": npz is not None}\n    if not have[\"metrics\"]:\n        missing_files.append((d, \"metrics.json\")); continue\n    ck = [f for f in files if f.startswith(\"ck_\") or f == \"resume.pt\"]\n    if ck: ckpt_found.append((d, len(ck)))\n\n    m = json.load(open(os.path.join(p, \"metrics.json\")))\n    for k in m: schema.setdefault(k, 0); schema[k] += 1\n    rows.append({\"run_id\": d, \"kind\": classify(d), \"arm\": m.get(\"arm\"),\n                 \"N\": m.get(\"N\", m.get(\"n_train\")), \"seed\": m.get(\"seed\"),\n                 \"auc\": m.get(\"auc\"), \"mcc\": m.get(\"mcc\"),\n                 \"step\": m.get(\"step\"), \"steps_run\": m.get(\"steps_run\"),\n                 \"n_eval\": m.get(\"n_eval\"), \"verdict\": m.get(\"verdict\", \"—\"),\n                 \"scale\": m.get(\"final_grad_scale\"),\n                 \"skipped\": m.get(\"skipped_steps\"),\n                 \"ms\": m.get(\"ms_per_step\"), \"gb\": m.get(\"peak_gb\"),\n                 \"npz\": npz,\n                 \"files_ok\": all(have.values()) or classify(d) == \"step0\"})\n\ndf = pd.DataFrame(rows).sort_values([\"kind\", \"arm\", \"N\", \"seed\"]).reset_index(drop=True)\nprint(df.groupby(\"kind\").size().to_string(), \"\\n\")\nprint(df[[\"run_id\", \"kind\", \"arm\", \"N\", \"seed\", \"auc\", \"mcc\", \"step\",\n          \"steps_run\", \"scale\", \"skipped\", \"files_ok\"]].to_string(index=False))\n\n# ---------- GATE D0-a: file completeness ------------------------------------\nprint(f\"\\n{'='*72}\\nGATE D0-a — file completeness\\n{'='*72}\")\nbad = df[~df.files_ok]\nif len(bad) == 0 and not missing_files:\n    print(\"PASS — every run dir has metrics/history/top/logits.\")\nelse:\n    print(f\"*** {len(bad)} dirs incomplete, {len(missing_files)} missing metrics.json\")\n    print(bad[[\"run_id\", \"kind\"]].to_string(index=False))\n\nprint(f\"\\nmodel checkpoints (ck_*.pt / resume.pt): \"\n      f\"{len(ckpt_found)} dirs\" if ckpt_found else\n      \"\\nmodel checkpoints: NONE persisted (excluded from staging, as expected).\")\nprint(\"  -> metrics can be recomputed from stored logits, but no re-scoring on\")\nprint(\"     new data is possible without retraining. Val prevalence is 17.4%,\")\nprint(\"     so no re-scoring is needed.\")\n\n# ---------- GATE D0-b: schema audit -----------------------------------------\nprint(f\"\\n{'='*72}\\nGATE D0-b — metrics.json schema\\n{'='*72}\")\nn_runs = len(df)\npartial = {k: v for k, v in schema.items() if v < n_runs}\nprint(f\"{len(schema)} distinct keys across {n_runs} runs; \"\n      f\"{len(schema)-len(partial)} present in all\")\nif partial:\n    print(\"\\nkeys NOT present in every run (expected for arm-specific / era-specific):\")\n    for k, v in sorted(partial.items(), key=lambda kv: -kv[1]):\n        who = df[df.run_id.isin([r[\"run_id\"] for r in rows\n                                 if k not in json.load(open(\n                                     os.path.join(RUNS, r[\"run_id\"], \"metrics.json\")))])]\n        print(f\"  {k:<22} in {v:>2}/{n_runs}  missing from: \"\n              f\"{', '.join(who.kind.unique()) if len(who) else '?'}\")\nprint(\"\\nNOTE: `verdict` missing => nb08-era cell. Never test `m.get('verdict')\")\nprint(\"      == 'clean'`; that returns None and silently misfiles those rows.\")\n\n# ---------- GATE D0-c: recompute from logits --------------------------------\ndef max_mcc(p, y):\n    o  = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P  = int(ys.sum()); Nn = len(ys) - P\n    tp = np.cumsum(ys); k = np.arange(1, len(ys)+1, dtype=np.int64)\n    fp, fn = k - tp, P - tp\n    tn = Nn - fp\n    num = (tp*tn - fp*fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float)*(tp+fn)*(tn+fp)*(tn+fn))\n    return float(np.divide(num, den, out=np.zeros_like(num), where=den > 0).max())\n\nprint(f\"\\n{'='*72}\\nGATE D0-c — recompute AUC / max-MCC from stored logits\\n{'='*72}\")\nd_auc, d_mcc, prev, checked, skipped = [], [], set(), 0, []\nfor r in df.itertuples():\n    if not r.npz: skipped.append(r.run_id); continue\n    z = np.load(os.path.join(RUNS, r.run_id, r.npz))\n    y = z[\"label\"]; prev.add((len(y), int(y.sum())))\n    key = f\"p_s{r.step}\"\n    if key not in z.files: skipped.append(f\"{r.run_id} (no {key})\"); continue\n    p = z[key]\n    d_auc.append(abs(roc_auc_score(y, p) - r.auc))\n    d_mcc.append(abs(max_mcc(p, y) - r.mcc))\n    checked += 1\n\nprint(f\"checked {checked} runs | max |delta AUC| {max(d_auc):.2e} \"\n      f\"| max |delta MCC| {max(d_mcc):.2e}\")\nif skipped: print(f\"skipped: {skipped}\")\nif max(d_auc) < 1e-6 and max(d_mcc) < 1e-6:\n    print(\"PASS — stored logits fully reproduce reported metrics.\")\n    print(\"  All of Section D is CPU work on saved artifacts. No GPU needed.\")\nelse:\n    print(\"*** FAIL — recomputation disagrees. Investigate before proceeding. ***\")\n\nprint(f\"\\nlabel arrays across all npz: {sorted(prev)}\")\nprint(f\"  -> val prevalence {list(prev)[0][1]/list(prev)[