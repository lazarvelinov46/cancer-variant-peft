ntinue\n    p = os.path.join(RUNS, r.run_id)\n    m    = json.load(open(f\"{p}/metrics.json\"))\n    hist = json.load(open(f\"{p}/history.json\"))\n    pb   = PB[f\"{int(r.N)}_{int(r.seed)}\"]\n\n    sel_hist  = [h[\"sel_auc\"] for h in hist]\n    probe_sel = pb[\"sel_auc\"]\n    lift      = m[\"auc\"] - pb[\"full_val_auc\"]\n    ever_up   = max(sel_hist) > probe_sel\n    peak_i    = int(np.argmax(sel_hist))\n\n    if   lift >= LIFT_GAIN: v = \"GAIN\"\n    elif lift > 0:          v = \"MARGINAL\"\n    elif ever_up:           v = \"DEGRADED (learned then lost)\"\n    else:                   v = \"NULL (never learned)\"\n\n    stopped_early = m[\"steps_run\"] < m[\"steps\"]\n    recs.append({\n        \"run_id\": r.run_id, \"arm\": m[\"arm\"], \"N\": m[\"N\"], \"seed\": m[\"seed\"],\n        \"auc\": m[\"auc\"], \"mcc\": m[\"mcc\"], \"auprc\": m[\"auprc\"], \"f1\": m[\"f1\"],\n        \"probe_auc\": pb[\"full_val_auc\"], \"probe_mcc\": pb[\"full_val_mcc\"],\n        \"lift\": lift, \"lift_mcc\": m[\"mcc\"] - pb[\"full_val_mcc\"],\n        \"step\": m[\"step\"], \"steps_run\": m[\"steps_run\"], \"steps\": m[\"steps\"],\n        \"n_evals\": len(hist), \"peak_eval\": peak_i + 1,\n        \"peak_at_first\": peak_i == 0, \"ever_above_probe\": ever_up,\n        \"skipped\": m[\"skipped_steps\"], \"ms\": m[\"ms_per_step\"],\n        \"gb\": m[\"peak_gb\"], \"session\": m.get(\"session_id\"),\n        \"verdict_old\": m.get(\"verdict\", \"MISSING\"), \"verdict_new\": v,\n        \"boundary\": \"patience\" if stopped_early else \"budget\",\n        \"at_risk\": stopped_early and peak_i > 0})\n\nA = pd.DataFrame(recs).sort_values([\"arm\", \"N\", \"seed\"]).reset_index(drop=True)\nassert len(A) == 30, len(A)\n\nprint(f\"\\n{'='*112}\")\nprint(A[[\"run_id\", \"arm\", \"N\", \"seed\", \"probe_auc\", \"auc\", \"lift\", \"step\",\n         \"steps_run\", \"skipped\", \"boundary\", \"verdict_old\",\n         \"verdict_new\"]].to_string(index=False))\nprint(f\"{'='*112}\")\n\n# ----