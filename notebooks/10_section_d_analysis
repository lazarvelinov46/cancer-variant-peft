un_id] = p\n    else:\n        rows.append({\"run_id\": r.run_id, \"kind\": r.kind, \"d_auc\": np.nan,\n                     \"d_mcc\": np.nan, \"same_y\": same_y})\n\nchk = pd.DataFrame(rows)\nbad = chk[chk.d_auc.isna()]\n\nprint(f\"{'='*72}\\nGATE D0-c — recompute AUC / max-MCC from stored logits\\n{'='*72}\")\nprint(f\"checked {chk.d_auc.notna().sum()} of {len(chk)} runs\")\nprint(f\"  max |delta AUC| {chk.d_auc.max():.2e}\")\nprint(f\"  max |delta MCC| {chk.d_mcc.max():.2e}\")\nprint(f\"  identical label array: {chk.same_y.all()} \"\n      f\"({len(Y0):,} rows, {int(Y0.sum()):,} pos, {Y0.mean():.1%})\")\nif len(bad):\n    print(f\"  no logits at selected step: {list(bad.run_id)}\")\nok_c = chk.d_auc.max() < 1e-6 and chk.d_mcc.max() < 1e-6 and chk.same_y.all()\nprint(\"PASS — stored logits reproduce reported metrics. All of Section D is CPU.\"\n      if ok_c else \"*** FAIL — investigate before proceeding. ***\")\n\n# ---------- GATE D0-d: duplicate runs ---------------------------------------\nprint(f\"\\n{'='*72}\\nGATE D0-d — duplicate runs (identical prediction vectors)\\n{'='*72}\")\nids, dupes = list(preds_all), []\nfor i in range(len(ids)):\n    for j in range(i+1, len(ids)):\n        if np.array_equal(preds_all[ids[i]], preds_all[ids[j]]):\n            dupes.append((ids[i], ids[j]))\nif dupes:\n    for a, b in dupes:\n        print(f\"  IDENTICAL: {a}\\n          == {b}\")\n    print(f\"\\n  {len(dupes)} duplicate pair(s). These MUST NOT both enter any\")\n    print(f\"  aggregate. Expected: the nb08-era anchor, and _nopatience runs whose\")\n    print(f\"  selected checkpoint predates the point their cached twin stopped.\")\nelse:\n    print(\"  none — every run has a distinct prediction vector.\")\n\n# ---------- the scale/skipped identity ---------------------------------------\nprint(f\"\\n{'='*72}\\nfinal_grad_scale vs skipped_steps\\n{'='*72}\")\ng = df.dropna(subset=[\"scale\", \"skipped\"]).copy()\ng[\"implied\"] = 16 - np.log2(g[\"scale\"])\ng[\"excess\"]  = g[\"skipped\"] - g[\"implied\"]\nprint(f\"  runs with both fields: {len(g)}\")\nfor e, sub in g.groupby(\"excess\"):\n    print(f\"  skipped - (16 - log2 scale) = {e:+.0f}  |  {len(sub)} runs  |  \"\n          f\"steps_run {sorted(set(sub.steps_run.dropna().astype(int)))}\")\nprint(\"  -> scale is a deterministic function of skipped (plus scaler growth on\")\nprint(\"     runs past the 2,000-step growth interval). ONE variable, not two.\")\nprint(\"     Section D uses skipped_steps; final_grad_scale is dropped.\")\n\n# ---------- analysis population ----------------------------------------------\nDROP_DUP = {b for _, b in dupes} | {\"siamese_lpft_n4096_seed0\"}\nGRID = df[(df.kind == \"GRID\")].copy()\nNO_VERDICT = [r.run_id for r in GRID.itertuples() if r.verdict == \"—\"]\nprint(f\"\\nGRID: {len(GRID)} cells, {len(GRID.groupby(['N','seed']))} pairs\")\nprint(f\"  missing `verdict` (nb08-era): {NO_VERDICT}\")\nprint(f\"  -> never compare m.get('verdict') to a string; recompute from lift.\")\nprint(f\"excluded from aggregates: {sorted(DROP_DUP)}\")\nprint(\"D0c OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:57:58.308228Z","iopub.execute_input":"2026-09-01T07:57:58.308899Z","iopub.status.idle":"2026-09-01T07:57:58.81832Z","shell.execute_reply.started":"2026-09-01T07:57:58.308843Z","shell.execute_reply":"2026-09-01T07:57:58.816507Z"}},"outputs":[{"name":"stdout","text":"========================================================================\nGATE D0-c — recompute AUC / max-MCC from stored logits\n========================================================================\nchecked 42 of 42 runs\n  max |delta AUC| 0.00e+00\n  max |delta MCC| 0.00e+00\n  identical label array: True (6,450 rows, 1,125 pos, 17.4%)\nPASS — stored logits reproduce reported metrics. All of Section D is CPU.\n\n========================================================================\nGATE D0-d — duplicate runs (identical prediction vectors)\n======