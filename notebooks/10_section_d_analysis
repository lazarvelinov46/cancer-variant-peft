 \"SO:0001575\", \"SO:0001574\"}          # nonsense, splice d/a\nMIS  = {\"SO:0001583\", \"SO:0001582\"}                        # missense, initiator\ndef stratum(s):\n    ts = {t.split(\"|\")[0] for t in str(s).split(\",\") if t}\n    if ts & LOF: return \"LoF\"\n    if ts & MIS: return \"missense\"\n    return \"silent/non-coding\"\nstrat = np.array([stratum(s) for s in mc_raw])\n\nprint(f\"\\n{'stratum':<20}{'rows':>7}{'pos':>7}{'rate':>8}\")\nfor k in (\"LoF\", \"missense\", \"silent/non-coding\"):\n    m = strat == k\n    print(f\"{k:<20}{m.sum():>7,}{y_emb[m].sum():>7,}{y_emb[m].mean():>8.1%}\")\n\n# ---------- (a) consequence-only baseline -----------------------------------\ntier = np.select([strat == \"LoF\", strat == \"missense\"], [2.0, 1.0], default=0.0)\nprint(f\"\\n{'='*76}\\nCONSEQUENCE-ONLY BASELINE (no sequence, no model)\\n{'='*76}\")\nprint(f\"  3-tier rule LoF > missense > silent:\")\nprint(f\"    AUC   {roc_auc_score(y_emb, tier):.4f}\")\nprint(f\"    AUPRC {average_precision_score(y_emb, tier):.4f}\")\nprint(f\"  LoF-vs-rest binary rule: AUC {roc_auc_score(y_emb, (tier==2).astype(float)):.4f}\")\nprint(f\"\\n  best model in study (F4 full FT): AUC 0.8066\")\nprint(f\"  frozen probe on full data:        AUC 0.7328\")\n\n# ---------- (b,c) per-stratum model performance ------------------------------\ndef preds(rid):\n    f = os.path.join(RUNS, rid)\n    n = \"val_logits_step0.npz\" if rid.startswith(\"step0\") else \"val_logits_top3.npz\"\n    zz = np.load(os.path.join(f, n))\n    m = json.load(open(f\"{f}/metrics.json\"))\n    return zz[f\"p_s{m['step']}\"]\n\nMODELS = {\n    \"step 0 (frozen probe)\": \"step0_fulldata_n37241_s0\",\n    \"full FT (F4, best)\":    \"full_lr2e-05_n37241_s0_fd_nopatience\",\n    \"LoRA (F3)\":             \"lora_r16_lr0.0001_n37241_s0_fulldata\",\n    \"full FT grid N=4096\":   \"full_lr2e-05_n4096_s0\",\n    \"LoRA grid N=4096\":      \"lora_r16_lr0.0001_n4096_s0\",\n}\nprint(f\"\\n{'='*76}\\nAUC BY STRATUM — where does the model's signal actually live?\\n{'='*76}\")\nprint(f\"{'model':<24}{'overall':>9}{'LoF':>9}{'missense':>10}{'silent/nc':>11}\")\nout = []\nfor nm, rid in MODELS.items():\n    p = preds(rid)\n    row = {\"model\": nm, \"overall\": roc_auc_score(y_emb, p)}\n    for k, lab in ((\"LoF\", \"LoF\"), (\"missense\", \"missense\"),\n                   (\"silent/non-coding\", \"silent/nc\")):\n        m = strat == k\n        row[lab] = (roc_auc_score(y_emb[m], p[m])\n                    if 0 < y_emb[m].sum() < m.sum() else np.nan)\n    out.append(row)\n    print(f\"{nm:<24}{row['overall']:>9.4f}{row['LoF']:>9.4f}\"\n          f\"{row['missense']:>10.4f}{row['silent/nc']:>11.4f}\")\nprint(f\"{'consequence-only rule':<24}{roc_auc_score(y_emb, tier):>9.4f}\"\n      f\"{'0.5000':>9}{'0.5000':>10}{'0.5000':>11}   <- uninformative WITHIN strata\")\n\nprint(f\"\\n  READ THIS: the consequence rule scores ~0.5 inside every stratum by\")\nprint(f\"  construction. Any within-stratum AUC above 0.5 is signal the\")\nprint(f\"  annotation does not provide. MISSENSE is the meaningful comparison:\")\nprint(f\"  ~35% positive, and consequence class carries no information there.\")\n\n# ---------- missense-only paired grid comparison ------------------------------\nmm = strat == \"missense\"\nprint(f\"\\n{'='*76}\\nMISSENSE-ONLY: paired LoRA - full FT across the 15 grid cells\\n{'='*76}\")\nd = []\nfor (N, s), g in A.groupby([\"N\", \"seed\"]):\n    a = {r.arm: roc_auc_score(y_emb[mm], preds(r.run_id)[mm]) for r in g.itertuples()}\n    d.append({\"N\": N, \"seed\": s, \"full\": a[\"full\"], \"lora\": a[\"lora\"],\n              \"diff\": a[\"lora\"] - a[\"full\"]})\nD = pd.DataFrame(d)\nprint(D.to_string(index=False))\nprint(f\"\\n  pooled missense-only diff: {D['diff'].mean():+.4f} \"\n      f\"+/- {D['diff'].std(ddof=1):.4f} | SE {D['diff'].std(ddof=1)/np.sqrt(len(D)):.4f}\")\nprint(f\"  (overall-set pooled was -0.0045 +/- 0.0301)\")\nprint(f\"  mean missense AUC: full {D.full.mean():.4f} | LoRA {D.lora.mean():.4f}\")\n\npd.DataFrame(out).to_csv(\"/kaggle/working/d4_strata.csv\", index=False)\nprint(\"\\n-> /kaggle/working/d4_strata.csv | D4 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:49.797509Z","iopub.execute_input":"2026-09-01T07:58:49.797911Z","iopub.status.idle":"2026-09-01T07:58:50.309829Z","shell.execute_reply.started":"2026-09-01T07:58:49.797884Z","shell.execute_reply":"2026-09-01T07:58:50.30818Z"}},"outputs":[{"name":"stdout","text":"alignment OK | 6,450 rows | 1,125 pos (17.4%)\nhard_eval rows in val: 0\n\nstratum                rows    pos    rate\nLoF                     582    575   98.8%\nmissense              1,514    535   35.3%\nsilent/non-coding     4,354     15    0.3%\n\n============================================================================\nCONSEQUENCE-ONLY BASELINE (no sequence, no model)\n============================================================================\n  3-tier rule LoF > missense > silent:\n    AUC   0.9474\n    AUPRC 0.7591\n  LoF-vs-rest binary rule: AUC 0.7549\n\n  best model in study (F4 full FT): AUC 0.8066\n  frozen probe on full data:        AUC 0.7328\n\n============================================================================\nAUC BY STRATUM — where does the model's signal actually live?\n============================================================================\nmodel                     overall      LoF  missense  silent/nc\nstep 0 (frozen probe)      0.7328   0.8129    0.5572     0.7600\nfull FT (F4, best)         0.8066   0.8557    0.6223     0.8872\nLoRA (F3)                  0.7924   0.9034    0.5844     0.9004\nfull FT grid N=4096        0.7549   0.8547    0.5709     0.7632\nLoRA grid N=4096           0.7435   0.7317    0.5617     0.7884\nconsequence-only rule      0.9474   0.5000    0.5000     0.5000   <- uninformative WITHIN strata\n\n  READ THIS: the consequence rule scores ~0.5 inside every stratum by\n  construction. Any within-stratum AUC above 0.5 is signal the\n  annotation does not provide. MISSENSE is the meaningful comparison:\n  ~35% positive, and consequence class carries no information there.\n\n============================================================================\nMISSENSE-ONLY: paired LoRA - full FT across the 15 grid cells\n============================================================================\n   N  seed     full     lora      diff\n 256     0 0.512547 0.513182  0.000636\n 256     1 0.512692 0.508531 -0.004160\n 256     2 0.540361 0.509606 -0.030754\n 512     0 0.549876 0.530499 -0.019377\n 512     1 0.551369 0.543925 -0.007444\n 512     2 0.554779 0.511718 -0.043061\n1024     0 0.565177 0.549094 -0.016084\n1024     1 0.549443 0.559394  0.009951\n1024     2 0.511594 0.500838 -0.010756\n2048     0 0.533161 0.537900  0.004739\n2048     1 0.533468 0.542982  0.009514\n2048     2 0.564709 0.554714 -0.009995\n4096     0 0.570947 0.561714 -0.009233\n4096     1 0.545084 0.544861 -0.000223\n4096     2 0.577041 0.543727 -0.033315\n\n  pooled missense-only diff: -0.0106 +/- 0.0157 | SE 0.0040\n  (overall-set pooled was -0.0045 +/- 0.0301)\n  mean missense AUC: full 0.5448 | LoRA 0.5342\n\n-> /kaggle/working/d4_strata.csv | D4 OK\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# Notebook 10 · Section D · cell D5 — verification of the two D4 claims, plus a\n# parameter-free test of whether the model adds anything to the annotation.\n# CPU, ~1-2 min (bootstraps). Writes d5_verified.csv.\n#\n# Claim 1: missense signal is real (F4 > chance, F4 > frozen probe)\n# Claim 2: full FT > LoRA on missense, and this is SPECIFIC to missense\n# Claim 3: does the model add information the consequence rule lacks?\n\nimport numpy as np, pandas as pd\nfrom scipy import stats\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\nfor nm in (\"y_emb\", \"strat\", \"preds\", \"MODELS\", \"A\", \"tier\"):\n    assert nm in globals(), f\"{nm} missing — re-run D4 before D5\"\n\nB_BOOT = 2000\nMM, LOF = strat == \"missense\", strat == \"LoF\"\nprint(f\"missense {MM.sum():,} rows / {y_emb[MM].sum():,} pos | \"\n      f\"LoF {LOF.sum():,} rows / {y_emb[LOF].sum():,} pos\")\n\ndef boot_idx(n, B, seed):\n    rng = np.random.default_rng(seed)\n    return [rng.integers(0, n, n) for _ in range(B)]\n\ndef boot_auc(y, p, ixs):\n    out = []\n    for ix in ixs:\n        yy = y[ix]\n        if 0 < yy.sum() < len(yy):\n            out.append(roc_auc_score(yy, p[ix]))\n    return np.array(out)\n\ndef boot_auc_diff(y, pa, pb, ixs):\n    \"\"\"Paired: same resample for both models, so the CI accounts for the\n    correlation between two models scored on the same rows.\"\"\"\n    out = []\n    for ix in ixs:\n        yy = y[ix]\n        if 0 < yy.sum() < len(yy):\n            out.append(roc_auc_score(yy, pa[ix]) - roc_auc_score(yy, pb[ix]))\n    return np.array(out)\n\n# ---------- CLAIM 1 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 1 — is the missense signal real?\\n{'='*78}\")\nixs_m = boot_idx(int(MM.sum()), B_BOOT, 0)\nym = y_emb[MM]\nP = {nm: preds(rid)[MM] for nm, rid in MODELS.items()}\n\nprint(f\"{'model':<24}{'AUC':>8}{'95% CI':>22}{'P(>0.5)':>10}\")\nrows = []\nfor nm, p in P.items():\n    a = roc_auc_score(ym, p)\n    bs = boot_auc(ym, p, ixs_m)\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    rows.append({\"model\": nm, \"missense_auc\": a, \"lo\": lo, \"hi\": hi})\n    print(f\"{nm:<24}{a:>8.4f}   {lo:>7.4f} .. {hi:<7.4f}{(bs > 0.5).mean():>10.3f}\")\n\nprint(f\"\\n  paired: does fine-tuning beat the frozen probe WITHIN missense?\")\nfor nm in (\"full FT (F4, best)\", \"LoRA (F3)\"):\n    bs = boot_auc_diff(ym, P[nm], P[\"step 0 (frozen probe)\"], ixs_m)\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    print(f\"    {nm:<22} - probe = {bs.mean():+.4f} | 95% {lo:+.4f} .. {hi:+.4f}\"\n          f\" | P(>0) {(bs > 0).mean():.3f}\")\n\n# ---------- CLAIM 2 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 2 — full FT vs LoRA, by stratum (15 paired grid cells)\\n{'='*78}\")\ndef paired_by_stratum(mask, label):\n    d = []\n    for (N, s), g in A.groupby([\"N\", \"seed\"]):\n        a = {r.arm: roc_auc_score(y_emb[mask], preds(r.run_id)[mask])\n             for r in g.itertuples()}\n        d.append(a[\"lora\"] - a[\"full\"])\n    d = np.array(d)\n    se = d.std(ddof=1) / np.sqrt(len(d))\n    tt = stats.ttest_1samp(d, 0)\n    wx = stats.wilcoxon(d)\n    nneg = int((d < 0).sum())\n    sg = stats.binomtest(nneg, len(d), 0.5)\n    rng = np.random.default_rng(1)\n    bs = np.array([rng.choice(d, len(d), replace=True).mean()\n                   for _ in range(B_BOOT)])\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    print(f\"\\n  {label}\")\n    print(f\"    mean {d.mean():+.4f} +/- {d.std(ddof=1):.4f} | SE {se:.4f}\")\n    print(f\"    paired t   t={tt.statistic:+.3f}  p={tt.pvalue:.4f}\")\n    print(f\"    Wilcoxon   W={wx.statistic:.0f}      p={wx.pvalue:.4f}\")\n    print(f\"    sign test  {nneg}/{len(d)} favour full FT, p={sg.pvalue:.4f}\")\n    print(f\"    bootstrap  95% {lo:+.4f} .. {hi:+.4f} | P(LoRA better) {(bs>0).mean():.3f}\")\n    return d\n\nd_mis = paired_by_stratum(MM,  \"MISSENSE (hard: annotation uninformative)\")\nd_lof = paired_by_stratum(LOF, \"LoF (easy: annotation nearly determines label)\")\nd_all = paired_by_stratum(np.ones(len(y_emb), bool), \"OVERALL (for reference)\")\n\nprint(f\"\\n  SPECIFICITY CHECK — is the arm difference missense-specific?\")\nprint(f\"    missense {d_mis.mean():+.4f} | LoF {d_lof.mean():+.4f} \"\n      f\"| overall {d_all.mean():+.4f}\")\nts = stats.ttest_rel(d_mis, d_lof)\nprint(f\"    missense vs LoF difference-of-differences: {(d_mis-d_lof).mean():+.4f} \"\n      f\"| paired t p={ts.pvalue:.4f}\")\nprint(f\"    If full FT wins everywhere, the capacity story is unsupported.\")\nprint(f\"    If it wins on missense only, capacity matters where the task is hard.\")\n\n# ---------- CLAIM 3 ----------------------------------------------------------\nprint(f\"\\n{'='*78}\\nCLAIM 3 — does the model add anything to the annotation?\\n{'='*78}\")\nprint(\"  Composite = rank by consequence tier, break ties by model score.\")\nprint(\"  No fitting, no learned weights — a deterministic composition.\\n\")\nrule_auc = roc_auc_score(y_emb, tier)\nrule_ap  = average_precision_score(y_emb, tier)\nprint(f\"{'ranking':<30}{'AUC':>9}{'AUPRC':>9}{'d AUC':>10}\")\nprint(f\"{'consequence rule alone':<30}{rule_auc:>9.4f}{rule_ap:>9.4f}{'—':>10}\")\nixs_a = boot_idx(len(y_emb), B_BOOT, 2)\nout = []\nfor nm, rid in MODELS.items():\n    p = preds(rid)\n    comp = 2.0 * tier + p                      # tier dominates; p breaks ties\n    ca, cp = roc_auc_score(y_emb, comp), average_precision_score(y_emb, comp)\n    bs = boot_auc_diff(y_emb, comp, tier, ixs_a)\n    lo, hi = np.percentile(bs, [2.5, 97.5])\n    out.append({\"model\": nm, \"composite_auc\": ca, \"d_auc\": ca - rule_auc,\n                \"lo\": lo, \"hi\": hi})\n    print(f\"{'rule + ' + nm:<30}{ca:>9.4f}{cp:>9.4f}{ca-rule_auc:>+10.4f}\"\n          f\"   95% {lo:+.4f} .. {hi:+.4f}\")\nprint(f\"\\n  A positive, zero-excluding interval means the model carries\")\nprint(f\"  information the annotation does not — measured, not fitted.\")\n\n# ---------- caveats ----------------------------------------------------------\nprint(f\"\\n{'='*78}\")\nprint(\"  ALL OF SECTION D4/D5 IS POST-HOC. The stratification was not\")\nprint(\"  pre-registered. Three strata x three tests = multiple comparisons with\")\nprint(\"  no correction applied. Report as exploratory; the pre-registered\")\nprint(\"  result remains the overall-set pooled null (-0.0045 +/- 0.0301).\")\nprint(f\"{'='*78}\")\n\npd.DataFrame(rows).merge(pd.DataFrame(out), on=\"model\", how=\"outer\") \\\n  .to_csv(\"/kaggle/working/d5_verified.csv\", index=False)\nprint(\"-> /kaggle/working/d5_verified.csv | D5 OK\")","metadata":{"truste