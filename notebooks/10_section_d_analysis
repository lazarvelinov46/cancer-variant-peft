 \"mcc\": r.mcc,\n                 \"spread\": max(aucs.values()) - min(aucs.values())})\nS = pd.DataFrame(rows)\nassert np.allclose(S.reported, S.top3_max), \"reported AUC is not the top-3 max\"\n\nprint(f\"{'='*84}\\nSELECTION OPTIMISM — every reported AUC is a max over 3 evaluations\\n{'='*84}\")\nS[\"optimism\"] = S.top3_max - S.top3_mean\nfor arm, g in S.groupby(\"arm\"):\n    print(f\"  {arm:<5} optimism (max - mean) {g.optimism.mean():+.4f} \"\n          f\"+/- {g.optimism.std(ddof=1):.4f} | max {g.optimism.max():+.4f} \"\n          f\"| top-3 spread {g.spread.mean():.4f}\")\no = S.pivot_table(index=[\"N\",\"seed\"], columns=\"arm\", values=\"optimism\")\ndiff = (o[\"lora\"] - o[\"full\"]).dropna()\ntt = stats.ttest_rel(o[\"lora\"], o[\"full\"])\nprint(f\"\\n  asymmetry (LoRA - full optimism): {diff.mean():+.4f} \"\n      f\"+/- {diff.std(ddof=1):.4f} | paired t p={tt.pvalue:.3f}\")\nprint(f\"  -> if ~0, the top-3 max bias is symmetric and does NOT distort the\")\nprint(f\"     pooled paired estimate; it inflates both arms' absolute numbers.\")\n\nprint(f\"\\n  ensembling the top 3 instead of taking the max:\")\nS[\"d_ens\"] = S.ens_auc - S.top3_max\nfor arm, g in S.groupby(\"arm\"):\n    print(f\"    {arm:<5} AUC {g.d_ens.mean():+.4f} +/- {g.d_ens.std(ddof=1):.4f}\"\n          f\" | beats max in {(g.d_ens > 0).sum()}/{len(g)} runs\"\n          f\" | MCC {(g.ens_mcc - g.mcc).mean():+.4f}\")\nprint(f\"  (ensembling is NOT the locked recipe — reported for the writeup only)\")\n\n# ---------- 2. pre-declared analysis #6 -------------------------------------\nPB = json.load(open(f\"{RUNS}/shared/probe_baselines_full_val.json\"))\nA2 = A.copy()\nA2[\"ipl\"]  = [PB[f\"{int(n)}_{int(s)}\"][\"init_probe_loss\"] for n, s in zip(A2.N, A2.seed)]\nA2[\"risk\"] = [PB[f\"{int(n)}_{int(s)}\"][\"risk\"] for n, s in zip(A2.N, A2.seed)]\n\nprint(f\"\\n{'='*84}\\nPRE-DECLARED ANALYSIS #6 — init_probe_loss\\n{'='*84}\")\nprint(\"  declared form: split at init_probe_loss < 1.0\")\nfor arm, g in A2.groupby(\"arm\"):\n    lo_, hi_ = g[g.ipl < 1.0].lift, g[g.ipl >= 1.0].lift\n    ts = stats.ttest_ind(lo_, hi_, equal_var=False)\n    print(f\"    {arm:<5} LOW n={len(lo_)} lift {lo_.mean():+.4f} | \"\n          f\"HIGH n={len(hi_)} lift {hi_.mean():+.4f} | \"\n          f\"diff {lo_.mean()-hi_.mean():+.4f} | Welch p={ts.pvalue:.3f}\")\nprint(\"\\n  continuous form (uses more information at n=15):\")\nfor arm, g in A2.groupby(\"arm\"):\n    pe = stats.pearsonr(g.ipl, g.lift)\n    print(f\"    {arm:<5} Pearson r={pe.statistic:+.3f} p={pe.pvalue:.3f}\")\nprint(\"\\n  outcome by risk label (B5's calibration flag):\")\nprint(A2.pivot_table(index=\"risk\", columns=\"arm\", values=\"lift\",\n                     aggfunc=[\"mean\", \"count\"]).to_string())\n\n# ---------- 3. does skipped_steps survive controlling for init_probe_loss? ---\nprint(f\"\\n  full-arm: skipped_steps vs init_probe_loss as competing predictors\")\nF = A2[A2.arm == \"full\"]\nX = np.column_stack([np.ones(len(F)), F.skipped, F.ipl])\nbeta, *_ = np.linalg.lstsq(X, F.lift.values, rcond=None)\nresid = F.lift.values - X @ beta\ndof = len(F) - 3\nse = np.sqrt(np.diag(np.linalg.pinv(X.T @ X)) * (resid @ resid) / dof)\nfor nm, b, s in zip([\"intercept\", \"skipped\", \"init_probe_loss\"], beta, se):\n    print(f\"    {nm:<18}{b:>+10.5f} +/- {s:.5f} | t={b/s:+.2f} \"\n          f\"| p={2*(1-stats.t.cdf(abs(b/s), dof)):.4f}\")\nprint(f\"    R2 = {1 - (resid@resid)/((F.lift-F.lift.mean())**2).sum():.3f}\")\n\nS.to_csv(\"/kaggle/working/d3_selection.csv\", index=False)\nprint(\"\\n-> /kaggle/working/d3_selection.csv | D3 OK\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T07:58:20.101266Z","iopub.execute_input":"2026-09-01T07:58:20.10177Z","iopub.status.idle":"2026-09-01T07:58:20.894584Z","shell.execute_reply.started":"2026-09-01T07:58:20.101731Z","shell.execute_reply":"2026-09-01T07:58:20.893162Z"}},"outputs":[{"name":"stdout","text":"==============================