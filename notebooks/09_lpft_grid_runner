       torch.tensor(rows.label.values, dtype=torch.long))\n\ndef prebatch(frame, B):\n    \"\"\"Tokenize once, reuse across all evals. Dynamic padding per batch.\"\"\"\n    return [collate(frame.iloc[i:i+B]) for i in range(0, len(frame), B)]\n\ndef y_of(batches):\n    \"\"\"Labels in the exact order `evaluate` returns predictions. NEVER a global.\"\"\"\n    return torch.cat([b[4] for b in batches]).numpy()\n\n# ---------- val batches -------------------------------------------------------\nt0 = time.perf_counter()\nVAL_BATCHES = prebatch(va_f, B_EVAL)\nlens = [b[0].shape[1] for b in VAL_BATCHES]\nprint(f\"\\nval pre-batched: {len(VAL_BATCHES)} batches of <={B_EVAL} \"\n      f\"| padded len min {min(lens)} max {max(lens)} | {time.perf_counter()-t0:.0f}s\")\nassert min(lens) == 205 and max(lens) == 232, (min(lens), max(lens))\nassert max(lens) < MAXLEN, \"truncation would fire\"\nfor i, (ri, rm, ai, am_, y) in enumerate(VAL_BATCHES):\n    assert ri.shape == ai.shape, f\"batch {i}: ref {ri.shape} vs alt {ai.shape}\"\n\nY_VAL = y_of(VAL_BATCHES)\nassert len(Y_VAL) == 6_450 and np.array_equal(Y_VAL, va_f.label.values), \\\n    \"y_of(VAL_BATCHES) is not in va_f order\"\nprint(f\"y_of(VAL_BATCHES): {len(Y_VAL):,} rows | {int(Y_VAL.sum())} pos \"\n      f\"| matches va_f order OK\")\n\n# ---------- fixed-batch loss probe, disjoint from SEL -------------------------\n_out = np.setdiff1d(np.arange(len(va_f)), SEL, assume_unique=False)\n_r   = np.random.default_rng(777)\nPROBE_IX    = np.sort(_r.choice(_out, 96, replace=False))\nPROBE_BATCH = collate(va_f.iloc[PROBE_IX])\n_py = PROBE_BATCH[4].numpy()\nassert not set(PROBE_IX) & set(SEL), \"probe batch overlaps the selection subsample\"\nprint(f\"\\nPROBE_BATCH: {len(PROBE_IX)} rows from {len(_out):,} non-SEL val rows \"\n      f\"| {int(_py.sum())} pos ({_py.mean():.1%}) | seed 777\")\nprint(f\"  padded len {PROBE_BATCH[0].shape[1]} | disjoint from SEL: OK\")\n\n# ---------- sanity: a training batch from the plan -----------