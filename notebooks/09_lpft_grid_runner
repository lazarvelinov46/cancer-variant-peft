())\n    fp = int(((yhat == 1) & (y == 0)).sum()); fn = int(((yhat == 0) & (y == 1)).sum())\n    prec = tp / (tp + fp) if tp + fp else 0.0\n    rec  = tp / (tp + fn) if tp + fn else 0.0\n    return {\"auc\": float(roc_auc_score(y, p)), \"auprc\": float(average_precision_score(y, p)),\n            \"f1\": 2 * prec * rec / (prec + rec) if prec + rec else 0.0,\n            \"precision\": prec, \"recall\": rec, \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn}\n\n# ---------- (1) the anchor, to 1e-9 ------------------------------------------\nPIN = {\"auc\": 0.7548688993218571, \"mcc\": 0.4916218829113297,\n       \"thr\": 0.7574710249900818}\nPIN_AT = {\"auprc\": 0.5779, \"f1\": 0.4981, \"precision\": 0.8316, \"recall\": 0.3556,\n          \"tp\": 400, \"fp\": 81, \"fn\": 725}\n\nza = np.load(PATHS[\"anchor val logits\"], allow_pickle=True)\nprint(f\"nb06 anchor npz keys: {sorted(za.files)}\")\nprint(f\"  shapes: \" + \", \".join(f\"{k}={np.shape(za[k])}\" for k in sorted(za.files)))\npa, ya = np.asarray(za[\"p\"], dtype=np.float64), np.asarray(za[\"y\"]).astype(np.int64)\nprint(f\"  {len(pa):,} rows | {int(ya.sum())} pos ({ya.mean():.1%}) | step {int(za['step'])}\")\nassert len(pa) == 6_450 and int(ya.sum()) == 1_125\n\nthr_a, mcc_a = tune_threshold(pa, ya)\nauc_a = float(roc_auc_score(ya, pa))\nat_a  = metrics_at(pa, ya, thr_a)\n\nprint(f\"\\n{'quantity':<12} {'recomputed':>22} {'pinned':>22} {'|delta|':>12}\")\nfor k, got in [(\"auc\", auc_a), (\"mcc\", mcc_a), (\"threshold\", thr_a)]:\n    exp = PIN[{\"auc\": \"auc\", \"mcc\": \"mcc\", \"threshold\": \"thr\"}[k]]\n    d = abs(got - exp)\n    print(f\"{k:<12} {got:>22.16f} {exp:>22.16f} {d:>12.2e}\")\n    assert d < 1e-9, f\"{k}: {got!r} vs {exp!r}, delta {d:.3e}\"\n\nprint(f\"\\nat that threshold:\")\nfor k, exp in PIN_AT.items():\n    got = at_a[k]\n    ok = (got == exp) if isinstance(exp, int) else (abs(got - exp) < 5e-5)\n    print(f\"  {k:<10} {got:>12.4f}   expected {exp:>10}   {'OK' if ok else 'MISMATCH'}\")\n 