"lr_head\"] == 1e-4, f\"head LR drift: {rec['lr_head']}\"\nprint(f\"recipe: {rec['regime']} | lr_bb {rec['lr_backbone']:g} | lr_head {rec['lr_head']:g} \"\n      f\"| {rec['steps']} steps @ B={rec['batch']}\")\nprint(f\"peft targets: {pc['lora_target_modules']} | dropout {pc['lora_dropout']}\")\n\nbcfg = BertConfig.from_pretrained(MODEL_ID, revision=REVISION)\n\ndef fresh_backbone():\n    return AutoModel.from_pretrained(MODEL_ID, revision=REVISION, trust_remote_code=True,\n                                     config=bcfg, add_pooling_layer=False)\n\ndef new_head():\n    return nn.Sequential(nn.LayerNorm(768), nn.Linear(768, 256), nn.GELU(),\n                         nn.Dropout(0.2), nn.Linear(256, 2))\n\nclass SiameseVariantClassifier(nn.Module):\n    def __init__(self, backbone, head):\n        super().__init__(); self.backbone, self.head = backbone, head\n    def _pool(self, ids, mask):\n        out = self.backbone(input_ids=ids, attention_mask=mask,\n                            token_type_ids=torch.zeros_like(ids))[0].float()\n        m = mask.unsqueeze(-1).float()\n        return (out * m).sum(1) / m.sum(1).clamp(min=1.0)\n    def forward(self, ref_ids, ref_mask, alt_ids, alt_mask):\n        B = ref_ids.size(0)\n        h = self._pool(torch.cat([ref_ids, alt_ids], 0),\n                       torch.cat([ref_mask, alt_mask], 0))\n        with torch.amp.autocast(\"cuda\", enabled=False):\n            return self.head(h[B:] - h[:B])\n\ndef eager_ok(bb):\n    \"\"\"flash_attn_* symbols must all be None, including through the PEFT wrapper.\"\"\"\n    inner = getattr(getattr(bb, \"base_model\", None), \"model\", bb)\n    mod   = sys.modules[type(inner).__module__]\n    fl    = {k: v for k, v in vars(mod).items() if \"flash\" in k.lower()}\n    return bool(fl) and all(v is None for v in fl.values()), sorted(fl)\n\ndef build_lora(bb, r):\n    return get_peft_model(bb, LoraConfig(\n        r=r, lora_alpha=2 * r, lora_dropout=pc[\"lora_dropout\"], bias=pc[\"bias\"],\n        target_modules=pc[\"lora_target_modules\"], task_type=pc[\"task_type\"]))\n\ndef n_train(m): return sum(p.numel() for p in m.parameters() if p.requires_grad)\n\n# ---------- SEL_BATCHES (omitted from B2) ------------------------------------\nSEL_BATCHES = prebatch(va_f.iloc[SEL], B_EVAL)\ny_sel = y_of(SEL_BATCHES)\nassert len(y_sel) == 2_000 and np.array_equal(y_sel, va_f.label.values[SEL])\nassert np.array_equal(y_sel, yva[SEL]), \"SEL_BATCHES disagrees with the npz\"\nprint(f\"\\nSEL_BATCHES: {len(SEL_BATCHES)} batches | {len(y_sel):,} rows \"\n      f\"| {int(y_sel.sum())} pos ({y_sel.mean():.1%})\")\n\n# ---------- structural checks -------------------------------------------------\nbb0, hd0 = fresh_backbone(), new_head()\nnb, nh = sum(p.numel() for p in bb0.parameters()), sum(p.numel() for p in hd0.parameters())\nassert (nb, nh) == (116_477_952, 198_914), (nb, nh)\nok, fl = eager_ok(bb0); assert ok, fl\nprint(f\"\\nbackbone {nb:,} | head {nh:,} | eager attention: {ok} ({len(fl)} symbols, all None)\")\n\n_enc = tok([\"ACGT\" * 64] * 2 + [\"TTGA\" * 64] * 2, padding=True, truncation=True,\n           max_length=MAXLEN, return_tensors=\"pt\")\n_ids, _am = _enc[\"input_ids\"], _enc[\"attention_mask\"]\n_ref = SiameseVariantClassifier(bb0, hd0).eval()\nwith torch.no_grad():\n    y_frozen = _ref(_ids[:2], _am[:2], _ids[2:], _am[2:])\n\nEXP_ADAPTER = {8: 1_474_560, 16: 2_949_120, 32: 5_898_240}\nprint(f\"\\n{'r':>4} {'backbone':>12} {'+head':>12} {'% of full':>10} {'reduction':>10}\")\nfor r, want in EXP_ADAPTER.items():\n    m = SiameseVariantClassifier(build_lora(fresh_backbone(), r), new_head())\n    tot = n_train(m); bbt = tot - nh\n    assert bbt == want, f\"r={r}: {bbt:,} != {want:,} — targets matched nothing\"\n    print(f\"{r:>4} {bbt:>12,} {tot:>12,} {tot/(nb+nh):>9.2%} {(nb+nh)/tot:>9.0f}x\")\n    if r == 16:\n        ok, _ = eager_ok(m.backbone); assert ok, \"eager lost through PEFT wrapper\"\n        m.eval(); m.head.load_state_dict(hd0.state_dict())\n        with torch.no_grad():\n            y_lora = m(_ids[:2], _am[:2], _ids[2:], _am[2:])\n        d = (y_lora - y_frozen).abs().max().item()\n        print(f\"     eager through wrapper: True | step-0 max|delta| {d:.3e}\")\n        assert torch.equal(y_frozen, y_lora), \"lora_B not zero-init\"\n    del m\ndel bb0, hd0, _ref; gc.collect(); torch.cuda.empty_cache()\n\n# ---------- config ------------------------------------------------------------\nfrom dataclasses import dataclass, asdict\n\n@dataclass\nclass CellConfig:\n    arm: str; N: int; seed: int\n    lr_bb: float; lr_head: float = 1e-4\n    r: int = 16; steps: int = STEPS; B: int = B_TRAIN\n    eval_every: int = EVAL_EVERY; warmup: int = WARMUP\n    select_by: str = \"auc\"\n    head_init: str = \"\"\n    tag: str = \"\"\n    def __post_init__(self):\n        if not self.head_init:\n            self.head_init = HEAD_INDEX[f\"{self.N}_{self.seed}\"][\"path\"]\n    @property\n    def run_id(self):\n        r = f\"_r{self.r}\" if self.arm != \"full\" else \"\"\n        return f\"{self.arm}{r}_lr{self.lr_bb:g}_n{self.N}_s{self.seed}{self.tag}\"\n\ndef build(cfg):\n    bb = fresh_backbone()\n    if cfg.arm == \"lora\":\n        bb = build_lora(bb, cfg.r)\n    m  = SiameseVariantClassifier(bb, new_head())\n    hd = torch.load(cfg.head_init, map_location=\"cpu\", weights_only=False)\n    assert head_fp(hd[\"state_dict\"]) == HEAD_INDEX[f\"{cfg.N}_{cfg.seed}\"][\"fingerprint\"]\n    m.head.load_state_dict(hd[\"state_dict\"])\n    ok, _ = eager_ok(m.backbone); assert ok, \"eager attention lost\"\n    return m.cuda(), hd\n\ndef trainable_sd(m):\n    return {n: p.detach().cpu().clone() for n, p in m.named_parameters() if p.requires_grad}\n\ndef evaluate(m, batches):\n    m.eval(); out = []\n    with torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n        for ri, rm, ai, am_, y in batches:\n            out.append(torch.softmax(m(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n                                     .float(), 1)[:, 1].cpu())\n    return torch.cat(out).numpy()\n\ndef probe_loss(m):\n    ri, rm, ai, am_, y = PROBE_BATCH\n    m.eval()\n    with torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n        lg = m(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n    return float(nn.functional.cross_entropy(lg.float(), y.cuda()))\n\ndef verdict(a, pl, final_auc):\n    \"\"\"a = sel_auc history, pl = probe_loss history, final_auc = full-val AUC.\n    Probe loss is compared to its OWN start, never to an absolute chance value.\"\"\"\n    a, pl = np.asarray(a), np.asarray(pl)\n    if final_auc < 0.55:                    return \"DESTROYED (no signal)\"\n    if a[-1] - a[int(a.argmax())] > -0.02:  return \"clean\"\n    if pl[-1] > pl[0]:                      return \"DESTROYED (features degraded)\"\n    return \"OVERFIT (train down, val ranking down)\"\n\n# ---------- the runner --------------------------------------------------------\ndef run_cell(cfg, val_batches=None, verbose=True):\n    val_batches = VAL_BATCHES if val_batches is None else val_batches\n    y_ev = y_of(val_batches)                       # labels from the batches, never a global\n    rd = os.path.join(OUT_ROOT, cfg.run_id); os.makedirs(rd, exist_ok=True)\n    resume = os.path.join(rd, \"resume.pt\")\n\n    sub, plan = SUBSETS[(cfg.N, cfg.seed)], PLANS[(cfg.N, cfg.seed)]\n    torch.manual_seed(cfg.seed); torch.cuda.manual_seed_all(cfg.seed)\n    model, hd = build(cfg)\n    n_tr = n_train(model)\n\n    opt = torch.optim.AdamW(\n        [{\"params\": [p for p in model.backbone.parameters() if p.requires_grad],\n          \"lr\": cfg.lr_bb},\n         {\"params\": [p for p in model.head.parameters() if p.requires_grad],\n          \"lr\": cfg.lr_head}], weight_decay=WD)\n    sched  = get_linear_schedule_with_warmup(opt, cfg.warmup, cfg.steps)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    lossfn = nn.CrossEntropyLoss()\n\n    start, hist, top, peak, n_skip, train_s = 0, [], [], 0, 0, 0.0\n    if os.path.exists(resume):\n        ck = torch.load(resume, map_location=\"cpu\", weights_only=False)\n        miss, unex = model.load_state_dict(ck[\"model\"], strict=False)\n        assert not unex, f\"resume unexpected_keys: {unex[:5]}\"\n        opt.load_state_dict(ck[\"opt\"]); sched.load_state_dict(ck[\"sched\"])\n        scaler.load_state_dict(ck[\"scaler\"])\n        start, hist, top = ck[\"step\"], ck[\"hist\"], ck[\"top\"]\n        peak, train_s, n_skip = ck[\"peak\"], ck[\"train_s\"], ck[\"n_skip\"]\n        if verbose: print(f\"  RESUMED at step {start}\")\n\n    if verbose:\n        print(f\"{cfg.run_id} | trainable {n_tr:,} ({n_tr/(nb+nh):.2%}) | \"\n              f\"lr_bb {cfg.lr_bb:g} head {cfg.lr_head:g} | {cfg.steps} steps | \"\n              f\"eval on {len(y_ev):,} rows\")\n\n    t_wall, stall, done = time.perf_counter(), 0, start\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n\n    for step in range(start + 1, cfg.steps + 1):\n        ri, rm, ai, am_, y = collate(sub.iloc[plan[step - 1]])\n        t0 = time.perf_counter()\n        model.train(); opt.zero_grad(set_to_none=True)\n        with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n            lg = model(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n        loss = lossfn(lg.float(), y.cuda())\n        scaler.scale(loss).backward()\n        scaler.unscale_(opt); torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        _s_before = scaler.get_scale()\n        scaler.step(opt); scaler.update(); sched.step()\n        n_skip += int(scaler.get_scale() < _s_before)\n        torch.cuda.synchronize(); train_s += time.perf_counter() - t0\n        peak = max(peak, torch.cuda.max_memory_allocated())      # captured post-step\n        done = step\n\n        if step % cfg.eval_every == 0:\n            a  = float(roc_auc_score(y_sel, evaluate(model, SEL_BATCHES)))\n            pl = probe_loss(model)\n            hist.append({\"step\": step, \"sel_auc\": a, 