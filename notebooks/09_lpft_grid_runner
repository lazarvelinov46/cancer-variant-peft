 == \"full\" else LR_LORA\n    return json.load(open(f\"{OUT_ROOT}/{rid_of(arm, NSZ, s, lr)}/metrics.json\"))\n\nF = [cell(\"full\", s) for s in SEEDS]\nL = [cell(\"lora\", s) for s in SEEDS]\n\nprint(f\"\\n{'='*74}\\nN=1024 COMPLETE — 3 seeds, paired\\n{'='*74}\")\nprint(f\"{'seed':>5}{'full AUC':>11}{'LoRA AUC':>11}{'d AUC':>10}\"\n      f\"{'full MCC':>11}{'LoRA MCC':>11}{'d MCC':>10}{'edge':>10}\")\nfor i, s in enumerate(SEEDS):\n    edge = \"\".join(\"B\" if m[\"step\"] == m[\"steps_run\"] else \"-\" for m in (F[i], L[i]))\n    print(f\"{s:>5}{F[i]['auc']:>11.4f}{L[i]['auc']:>11.4f}{L[i]['auc']-F[i]['auc']:>+10.4f}\"\n          f\"{F[i]['mcc']:>11.4f}{L[i]['mcc']:>11.4f}{L[i]['mcc']-F[i]['mcc']:>+10.4f}\"\n          f\"{edge:>10}\")\n\nfor name, key in ((\"AUC\", \"auc\"), (\"MCC\", \"mcc\")):\n    d = np.array([L[i][key] - F[i][key] for i in range(3)])\n    fa = np.array([m[key] for m in F]); la = np.array([m[key] for m in L])\n    print(f\"\\n{name}:\")\n    print(f\"  paired diff (LoRA-full): {d.mean():+.4f} +/- {d.std(ddof=1):.4f}  \"\n          f\"(SE {d.std(ddof=1)/np.sqrt(3):.4f})\")\n    print(f\"  full arm : {fa.mean():.4f} +/- {fa.std(ddof=1):.4f}\")\n    print(f\"  LoRA arm : {la.mean():.4f} +/- {la.std(ddof=1):.4f}\"\n          f\"   [{la.std(ddof=1)/max(fa.std(ddof=1),1e-9):.1f}x full's sd]\")\n    print(f\"  paired sd / unpaired sd of difference: \"\n          f\"{d.std(ddof=1)/np.sqrt(fa.var(ddof=1)+la.var(ddof=1)):.2f}\"\n          f\"   (<1 means pairing helped)\")\n\nd = np.array([L[i][\"auc\"] - F[i][\"auc\"] for i in range(3)])\nprint(f\"\\nIs 3 seeds enough at N=1024?\")\nprint(f\"  |mean| {abs(d.mean()):.4f} vs SE {d.std(ddof=1)/np.sqrt(3):.4f} -> \"\n      f\"{'RESOLVED' if abs(d.mean()) > 2*d.std(ddof=1)/np.sqrt(3) else 'NOT RESOLVED at 2 SE'}\")\nprint(f\"  seeds needed for |mean| = 2 SE: \"\n      f\"{int(np.ceil((2*d.std(ddof=1)/max(abs(d.mean()),1e-9))**2))}\")\n\nprint(f\"\\nCOST: ms/step full {f['ms_per_step']:.0f} vs LoRA {l['ms_p