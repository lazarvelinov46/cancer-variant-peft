g.N, cfg.seed)], PLANS[(cfg.N, cfg.seed)]\n    torch.manual_seed(cfg.seed); torch.cuda.manual_seed_all(cfg.seed)\n    model, hd = build(cfg)\n    n_tr = n_train(model)\n\n    opt = torch.optim.AdamW(\n        [{\"params\": [p for p in model.backbone.parameters() if p.requires_grad],\n          \"lr\": cfg.lr_bb},\n         {\"params\": [p for p in model.head.parameters() if p.requires_grad],\n          \"lr\": cfg.lr_head}], weight_decay=WD)\n    sched  = get_linear_schedule_with_warmup(opt, cfg.warmup, cfg.steps)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    lossfn = nn.CrossEntropyLoss()\n\n    start, hist, top, peak, n_skip, train_s = 0, [], [], 0, 0, 0.0\n    if os.path.exists(resume):\n        ck = torch.load(resume, map_location=\"cpu\", weights_only=False)\n        miss, unex = model.load_state_dict(ck[\"model\"], strict=False)\n        assert not unex, f\"resume unexpected_keys: {unex[:5]}\"\n        opt.load_state_dict(ck[\"opt\"]); sched.load_state_dict(ck[\"sched\"])\n        scaler.load_state_dict(ck[\"scaler\"])\n        start, hist, top = ck[\"step\"], ck[\"hist\"], ck[\"top\"]\n        peak, train_s, n_skip = ck[\"peak\"], ck[\"train_s\"], ck[\"n_skip\"]\n        if verbose: print(f\"  RESUMED at step {start}\")\n\n    if verbose:\n        print(f\"{cfg.run_id} | trainable {n_tr:,} ({n_tr/(nb+nh):.2%}) | \"\n              f\"lr_bb {cfg.lr_bb:g} head {cfg.lr_head:g} | {cfg.steps} steps | \"\n              f\"eval on {len(y_ev):,} rows\")\n\n    t_wall, stall, done = time.perf_counter(), 0, start\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n\n    for step in range(start + 1, cfg.steps + 1):\n        ri, rm, ai, am_, y = collate(sub.iloc[plan[step - 1]])\n        t0 = time.perf_counter()\n        model.train(); opt.zero_grad(set_to_none=True)\n        with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n            lg = model(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n        loss = lossfn(lg.float(), y.cuda())\n       