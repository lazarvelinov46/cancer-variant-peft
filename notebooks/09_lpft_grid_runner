/SEL/HEAD_PATHS live\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# Phase 4 · Notebook 09 · Section A · cell A5 — metrics regression test (CPU, ~5 s)\n# Mandatory before any GPU work. Two independent checks:\n#   (1) nb06 anchor logits -> the four pinned constants, to 1e-9\n#   (2) nb08 top-3 logits  -> the two reusable cells' own metrics.json\n# (2) also establishes how to read val_logits_top3.npz, which Section D needs.\n\nfrom sklearn.metrics import roc_auc_score, average_precision_score\n\n# ---------- metrics: nb05 verbatim, exact cut-point enumeration --------------\ndef mcc_curve(p, y):\n    \"\"\"MCC at every REALIZABLE cut point. Sort desc, predict positive for the top\n    k -> running TP/FP; `keep` drops thresholds interior to a tie group.\"\"\"\n    order = np.argsort(-p, kind=\"mergesort\")\n    ps, ys = p[order], y[order].astype(np.int64)\n    P, Ng = int(ys.sum()), len(ys) - int(ys.sum())\n    tp = np.cumsum(ys)\n    k  = np.arange(1, len(ys) + 1, dtype=np.int64)\n    fp, fn = k - tp, P - tp\n    tn = Ng - fp\n    num = (tp * tn - fp * fn).astype(float)\n    den = np.sqrt((tp + fp).astype(float) * (tp + fn) * (tn + fp) * (tn + fn))\n    mcc = np.divide(num, den, out=np.zeros_like(num), where=den > 0)\n    keep = np.r_[np.diff(ps) != 0, True]\n    return ps[keep], mcc[keep]\n\ndef tune_threshold(p, y):\n    th, m = mcc_curve(p, y)\n    i = int(np.argmax(m))\n    return float(th[i]), float(m[i])\n\ndef metrics_at(p, y, thr):\n    yhat = (p >= thr).astype(int)\n    tp = int(((yhat == 1) & (y == 1)).sum()); tn = int(((yhat == 0) & (y == 0)).sum())\n    fp = int(((yhat == 1) & (y == 0)).sum()); fn = int(((yhat == 0) & (y == 1)).sum())\n    prec = tp / (tp + fp) if tp + fp else 0.0\n    rec  = tp / (tp + fn) if tp + fn else 0.0\n    return {\"auc\": float(roc_auc_score(y, p)), \"auprc\": float(average_precision_score(y, p)),\n            \"f1\": 2 * prec * rec / (prec + rec) if prec + rec else 0.0,\n            \"precision\": prec, \"recall\": rec, \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn}\n\n# ---------- (1) the anchor, to 1e-9 ------------------------------------------\nPIN = {\"auc\": 0.7548688993218571, \"mcc\": 0.4916218829113297,\n       \"thr\": 0.7574710249900818}\nPIN_AT = {\"auprc\": 0.5779, \"f1\": 0.4981, \"precision\": 0.8316, \"recall\": 0.3556,\n          \"tp\": 400, \"fp\": 81, \"fn\": 725}\n\nza = np.load(PATHS[\"anchor val logits\"], allow_pickle=True)\nprint(f\"nb06 anchor npz keys: {sorted(za.files)}\")\nprint(f\"  shapes: \" + \", \".join(f\"{k}={np.shape(za[k])}\" for k in sorted(za.files)))\npa, ya = np.asarray(za[\"p\"], dtype=np.float64), np.asarray(za[\"y\"]).astype(np.int64)\nprint(f\"  {len(pa):,} rows | {int(ya.sum())} pos ({ya.mean():.1%}) | step {int(za['step'])}\")\nassert len(pa) == 6_450 and int(ya.sum()) == 1_125\n\nthr_a, mcc_a = tune_threshold(pa, ya)\nauc_a = float(roc_auc_score(ya, pa))\nat_a  = metrics_at(pa, ya, thr_a)\n\nprint(f\"\\n{'quantity':<12} {'recomputed':>22} {'pinned':>22} {'|delta|':>12}\")\nfor k, got in [(\"auc\", auc_a), (\"mcc\", mcc_a), (\"threshold\", thr_a)]:\n    exp = PIN[{\"auc\": \"auc\", \"mcc\": \"mcc\", \"threshold\": \"thr\"}[k]]\n    d = abs(got - exp)\n    print(f\"{k:<12} {got:>22.16f} {exp:>22.16f} {d:>12.2e}\")\n    assert d < 1e-9, f\"{k}: {got!r} vs {exp!r}, delta {d:.3e}\"\n\nprint(f\"\\nat that threshold:\")\nfor k, exp in PIN_AT.items():\n    got = at_a[k]\n    ok = (got == exp) if isinstance(exp, int) else (abs(got - exp) < 5e-5)\n    print(f\"  {k:<10} {got:>12.4f}   expected {exp:>10}   {'OK' if ok else 'MISMATCH'}\")\n    assert ok, f\"{k}: {got} vs {exp}\"\nprint(f\"  tn         {at_a['tn']:>12}   (derived)\")\nprint(\"\\n(1) PASS — metrics functions are nb05's exact procedure\")\n\n# ---------- (2) the two reusable LoRA cells, via the top-3 schema ------------\nREUSE = [\"lora_r16_lr0.0001_n4096_s0\", \"lora_r16_lr0.0001_n256_s0\"]\n\nd0 = runs[REUSE[0]][0]\nz0 = np.load(os.path.join(d0, \"val_logits_top3.npz\"), allow_pickle=True)\nprint(f\"\\nnb08 top-3 npz keys: {sorted(z0.files)}\")\nprint(f\"  shapes: \" + \", \".join(f\"{k}={np.shape(z0[k])}\" for k in sorted(z0.files)))\nprint(f\"  top.json steps: {[t.get('step') for t in json.load(open(f'{d0}/top.json'))]}\")\n\ndef read_top3(run_dir, step):\n    \"\"\"Return (probs, labels, key) for `step` from val_logits_top3.npz.\n    Schema confirmed from nb08 artifacts: 'label' + one 'p_s{step}' per top-3 entry.\"\"\"\n    z   = np.load(os.path.join(run_dir, \"val_logits_top3.npz\"), allow_pickle=True)\n    key = f\"p_s{int(step)}\"\n    assert key in z.files, f\"{key} not in {sorted(z.files)}\"\n    return np.asarray(z[key], dtype=np.float64), np.asarray(z[\"label\"]).astype(np.int64), key\n\nprint(f\"\\n{'run_id':<28} {'AUC':>18} {'MCC':>18} {'thr':>10} status\")\nfor rid in REUSE:\n    d, m, _ = runs[rid]\n    p, y, key = read_top3(d, m[\"step\"])\n    thr, mcc = tune_threshold(p, y)\n    auc = float(roc_auc_score(y, p))\n    da, dm, dt = abs(auc - m[\"auc\"]), abs(mcc - m[\"mcc\"]), abs(thr - m[\"thr\"])\n    ok = da < 1e-9 and dm < 1e-9 and dt < 1e-9\n    print(f\"{rid:<28} {auc:>18.16f} {mcc:>18.16f} {thr:>10.4f} \"\n          f\"{'OK' if ok else f'MISMATCH d={da:.1e}/{dm:.1e}/{dt:.1e}'}  [key {key!r}]\")\n    assert len(y) == 6_450, f\"{rid}: {len(y)} eval rows, expected 6450\"\n    assert ok, f\"{rid}: recomputation disagrees with its own metrics.json\"\n\nprint(\"\\n(2) PASS — top-3 logits schema reads correctly for both reusable cells\")\nprint(\"\\nA5 OK — Section A complete, no GPU used. Proceed to B1 (staging).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-18T15:09:27.849822Z","iopub.execute_input":"2026-08-18T15:09:27.850297Z","iopub.status.idle":"2026-08-18T15:09:28.947381Z","shell.execute_reply.started":"2026-08-18T15:09:27.850266Z","shell.execute_reply":"2026-08-18T15:09:28.946197Z"}},"outputs":[{"name":"stdout","text":"nb06 anchor npz keys: ['p', 'step', 'y']\n  shapes: p=(6450,), step=(), y=(6450,)\n  6,450 rows | 1125 pos (17.4%) | step 950\n\nquantity                 recomputed                 pinned      |delta|\nauc              0.7548688993218571     0.7548688993218571     0.00e+00\nmcc              0.4916218829113297     0.4916218829113297     0.00e+00\nthreshold        0.7574710249900818     0.7574710249900818     0.00e+00\n\nat that threshold:\n  auprc            0.5779   expected     0.5779   OK\n  f1               0.4981   expected     0.4981   OK\n  precision        0.8316   expected     0.8316   OK\n  recall           0.3556   expected     0.3556   OK\n  tp             400.0000   expected        400   OK\n  fp              81.0000   expected         81   OK\n  fn             725.0000   expected        725   OK\n  tn                 5244   (derived)\n\n(1) PASS — metrics functions are nb05's exact procedure\n\nnb08 top-3 npz keys: ['label', 'p_s1000', 'p_s900', 'p_s950']\n  shapes: label=(6450,), p_s1000=(6450,), p_s900=(6450,), p_s950=(6450,)\n  top.json steps: [950, 1000, 900]\n\nrun_id                                      AUC                MCC        thr status\nlora_r16_lr0.0001_n4096_s0   0.7435302660406886 0.4810970008675848     0.6405 OK  [key 'p_s950']\nlora_r16_lr0.0001_n256_s0    0.6700800000000000 0.2993030162256379     0.9390 OK  [key 'p_s50']\n\n(2) PASS — top-3 logits schema reads correctly for both reusable cells\n\nA5 OK — Section A complete, no GPU used. Proceed to B1 (staging).\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# Phase 4 · Notebook 09 · Section B · cell B1 — stage artifacts into a writable root (CPU, ~10 s)\n# Idempotent. Fixes two porting defects —\n#   (1) head_index paths point at a /kaggle/working that no longer exists\n#   (2) load_or_run's OUT_ROOT would not see cells completed in earlier sessions\n# Expects 3 cached grid cells: 2 reusable nb08 LoRA cells + gate 1.\n\nimport shutil\n\nOUT_ROOT = \"/kaggle/working/runs\"\nSHARED   = f\"{OUT_ROOT}/shared\"\nos.makedirs(SHARED, exist_ok=True)\n\n# ---------- 1. the 15 head inits ---------------------------------------------\nfor k, src in HEAD_PATHS.items():\n    shutil.copyfile(src, os.path.join(SHARED, os.path.basename(src)))\nprint(f\"staged {len(HEAD_PATHS)} head inits -> {SHARED}\")\n\n# ---------- 2. shared JSONs ---------------------------------------------------\nfor key in [\"baselines.json\", \"peft_config.json\", \"predictions_08\",\n            \"outcomes_08\", \"lr_sweep_lora\"]:\n    shutil.copyfile(PATHS[key], os.path.join(SHARED, os.path.basename(PATHS[key])))\nprint(\"staged 5 shared JSONs\")\n\n# ---------- 3. head_index with rewritten paths --------------------------------\nHEAD_INDEX = {k: dict(v) for k, v in head_index.items()}\nfor k, v in HEAD_INDEX.items():\n    v[\"path\"] = os.path.join(SHARED, os.path.basename(v[\"path\"]))\n    assert os.path.exists(v[\"path\"]), v[\"path\"]\njson.dump(HEAD_INDEX, open(f\"{SHARED}/head_index.json\", \"w\"), indent=2)\nprint(f\"head_index rewritten: 15/15 paths now resolve under {SHARED}\")\n\nfor k, v in HEAD_INDEX.items():\n    chk = torch.load(v[\"path\"], map_location=\"cpu\", weights_only=False)\n    assert head_fp(chk[\"state_dict\"]) == v[\"fingerprint\"], f\"{k} corrupted in transit\"\nprint(\"15/15 staged head fingerprints re-verified after copy\")\n\n# ---------- 4. completed run directories (no checkpoints) ---------------------\nSKIP = shutil.ignore_patterns(\"ck_*.pt\", \"resume.pt\", \"*.ckpt\")\nstaged = []\nfor src in run_dirs:                      # already deduped by basename in A1\n    dst = os.path.join(OUT_ROOT, os.path.basename(src))\n    if os.path.exists(dst): shutil.rmtree(dst)\n    shutil.copytree(src, dst, ignore=SKIP)\n    staged.append(os.path.basename(dst))\nprint(f\"\\nstaged {len(staged)} run directories (ck_*.pt and resume.pt excluded)\")\n\n# ---------- 5. pre-register all 30 grid run_ids ------------------------------\nLR_FULL, LR_LORA, R = 2e-5, 1e-4, 16\n\ndef rid_of(arm, N, seed, lr_bb, r=R, tag=\"\"):\n    \"\"\"Replicates CellConfig.run_id exactly — verified against nb08's run names.\"\"\"\n    rr = f\"_r{r}\" if arm != \"full\" else \"\"\n    return f\"{arm}{rr}_lr{lr_bb:g}_n{N}_s{seed}{tag}\"\n\nassert rid_of(\"lora\", 4096, 0, 1e-4) == \"lora_r16_lr0.0001_n4096_s0\"\nassert rid_of(\"full\", 4096, 0, 2e-5) == \"full_lr2e-05_n4096_s0\"\n\nGRID = [(\"full\", N, s, LR_FULL) for N in N_GRID for s in SEEDS] + \\\n       [(\"lora\", N, s, LR_LORA) for N in N_GRID for s in SEEDS]\n\nprint(f\"\\n{'run_id':<30} {'arm':>5} {'N':>5} {'sd':>3} {'lr_bb':>8}  status\")\nn_cached, CACHED = 0, []\nfor arm, N, s, lr in GRID:\n    rid = rid_of(arm, N, s, lr)\n    mp  = os.path.join(OUT_ROOT, rid, \"metrics.json\")\n    if os.path.exists(mp):\n        m = json.load(open(mp)); n_cached += 1; CACHED.append(rid)\n        st = f\"CACHED  AUC {m['auc']:.4f}  MCC {m['mcc']:.4f}\"\n    else:\n        st = \"to run\"\n    print(f\"{rid:<30} {arm:>5} {N:>5} {s:>3} {lr:>8.0e}  {st}\")\n\nprint(f\"\\n{n_cached} cached / {len(GRID) - n_cached} to run\")\n# Floor, not equality — grows as the grid fills. Bump by 2 after each completed pair.\n# Guards the real failure mode: notebook 09's output not attached before A1 ran.\nMIN_CACHED = 6   # 2 nb08 LoRA + gate 1 + gate 2 + P1 (full, LoRA)\nassert n_cached >= MIN_CACHED, (\n    f\"expected at least {MIN_CACHED} cached cells, found {n_cached}: {CACHED}\\n\"\n    \"Completed cells are missing — attach 09-lpft-grid-runner BEFORE running A1.\")\nprint(f\"cached: {n_cached} (floor {MIN_CACHED}) | \"\n      f\"complete pairs: {sum(1 for N in N_GRID for s in SEEDS if all(os.path.exists(os.path.join(OUT_ROOT, rid_of(a, N, s, lr), 'metrics.json')) for a, lr in (('full', LR_FULL), ('lora', LR_LORA))))}/15\")\n\n# ---------- 6. every cached cell must be COMPLETE and self-consistent --------\n# Logits are the irreplaceable artifact. Re-verified each session as the grid grows.\nPINNED = {\"full_lr2e-05_n4096_s0\": (0