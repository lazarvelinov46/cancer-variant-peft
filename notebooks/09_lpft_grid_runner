.ref_window.str.len().eq(1024).all()\nassert df.ref.str.len().eq(1).all() and df.alt.str.len().eq(1).all()\nassert set(df.label.unique()) <= {0, 1}\nmid_ok = (df.ref_window.str[512] == df.ref).all()\nprint(f\"\\nwin_len==1024, offset==512, ref/alt single-base: OK\")\nprint(f\"ref_window[512] == ref on all {len(df):,} rows: {mid_ok}\")\nassert mid_ok, \"midpoint convention broken — alt construction would be wrong\"\n\n# ---------- 3. embedding caches are row-aligned to the dataframe -------------\nprint(f\"\\n{'cache':>6} {'keys':<46} {'rows':>7} {'label align':>12} {'gene align':>11}\")\nfor sp, key in [(\"train\", \"emb train\"), (\"val\", \"emb val\")]:\n    z = np.load(PATHS[key], allow_pickle=True)\n    d = df[df.split == sp].reset_index(drop=True)\n    lab_ok  = np.array_equal(z[\"label\"].astype(np.int64), d.label.values.astype(np.int64))\n    gene_ok = np.array_equal(z[\"gene\"].astype(np.int64),  d.gene.values.astype(np.int64))\n    print(f\"{sp:>6} {str(sorted(z.files)):<46} {len(z['label']):>7,} \"\n          f\"{str(lab_ok):>12} {str(gene_ok):>11}\")\n    assert len(z[\"label\"]) == len(d), f\"{sp}: cache {len(z['label'])} vs df {len(d)}\"\n    assert lab_ok and gene_ok, (\n        f\"{sp} cache is not in df[df.split=='{sp}'].reset_index(drop=True) order — \"\n        \"every index into the cache would be wrong\")\n\n# ---------- 4. molecular consequence, for the secondary question ------------\nval = df[df.split == \"val\"]\nprint(f\"\\nmc terms: {df.mc.nunique()} distinct across corpus, {val.mc.nunique()} in val\")\ntop = val.mc.value_counts().head(5)\nprint(\"  most frequent in val:\")\nfor term, cnt in top.items():\n    pos = int(val[val.mc == term].label.sum())\n    print(f\"    {term:<38} {cnt:>5,} rows  {100*pos/cnt:>5.1f}% pos\")\n\nprint(\"\\nA3 OK — attachment verified, caches row-aligned\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T10:33:39.528705Z","iopub.execute_input":"2026-08-20T10:33:39.529238Z","iopub.status.idle":"2026-08-20T10:33:41.491935Z","shell.execute_reply.started":"2026-08-20T10:33:39.529203Z","shell.execute_reply":"2026-08-20T10:33:41.49109Z"}},"outputs":[{"name":"stdout","text":"parquet: 92,019 rows x 20 cols\ncolumns: ['variation_id', 'chrom', 'pos', 'ref', 'alt', 'label', 'clnsig', 'clnrevstat', 'cgc_gene_ids', 'cgc_symbols', 'cgc_tiers', 'all_gene_ids', 'mc', 'ref_window', 'offset', 'win_len', 'is_hard_test', 'gene', 'split', 'hard_eval']\n\n split   genes     rows     pos   pos %   status\n train     434   37,241   5,309   14.3%   OK\n   val     155    6,450   1,125   17.4%   OK\n  test      40   48,328   9,284   19.2%   OK\n\n629 genes total | 1,216 hard-eval movers\n  train/val gene overlap: 0\n  train/test gene overlap: 0\n  val/test gene overlap: 0\n\nwin_len==1024, offset==512, ref/alt single-base: OK\nref_window[512] == ref on all 92,019 rows: True\n\n cache keys                                              rows  label align  gene align\n train ['gene', 'h_alt', 'h_ref', 'hard_eval', 'label', 'mc']  37,241         True        True\n   val ['gene', 'h_alt', 'h_ref', 'hard_eval', 'label', 'mc']   6,450         True        True\n\nmc terms: 140 distinct across corpus, 69 in val\n  most frequent in val:\n    SO:0001819|synonymous_variant          2,009 rows    0.3% pos\n    SO:0001627|intron_variant              1,434 rows    0.6% pos\n    SO:0001583|missense_variant            1,174 rows   35.6% pos\n    SO:0001587|nonsense                      340 rows   99.4% pos\n    SO:0001619|non-coding_transcript_variant,SO:0001819|synonymous_variant   246 rows    0.4% pos\n\nA3 OK — attachment verified, caches row-aligned\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# Phase 4 · Notebook 09 · Section A · cell A4 — fingerprint guard (CPU, ~40 s)\n# Reconstructs nb08's generators and validates them against 61 pre-registered\n# fingerprints. make_subset is reconstructed; the fingerprints are its proof.\n\nimport hashlib, time, torch\n\nB_TRAIN, B_EVAL, STEPS, MAXLEN = 24, 64, 1000, 256\nN_GRID, SEEDS = [256, 512, 1024, 2048, 4096], [0, 1, 2]\n\ntr_f = df[df.split == \"train\"].reset_index(drop=True).assign(_i=lambda d: np.arange(len(d)))\nva_f = df[df.split == \"val\"  ].reset_index(drop=True).assign(_i=lambda d: np.arange(len(d)))\n\n# ---------- generators, verbatim from nb06/nb08 ------------------------------\ndef fingerprint(f):\n    return hashlib.sha256(\"|\".join(f\"{r.chrom}:{r.pos}{r.ref}>{r.alt}\"\n                                   for r in f.itertuples()).encode()).hexdigest()[:16]\n\ndef head_fp(sd):\n    h = hashlib.sha256()\n    for k in sorted(sd):\n        h.update(k.encode()); h.update(sd[k].detach().cpu().numpy().tobytes())\n    return h.hexdigest()[:16]\n\nplan_fp = lambda p: hashlib.sha256(p.tobytes()).hexdigest()[:16]\n\ndef build_plan(frame, B, steps, seed):\n    r = np.random.default_rng(seed)\n    pos, neg = (np.flatnonzero(frame.label.values == 1),\n                np.flatnonzero(frame.label.values == 0))\n    plan = np.empty((steps, B), dtype=np.int64)\n    for s in range(steps):\n        ix = np.concatenate([r.choice(pos, B // 2, replace=False),\n                             r.choice(neg, B // 2, replace=False)])\n        r.shuffle(ix); plan[s] = ix\n    return plan\n\ndef make_subset(N, seed):\n    \"\"\"RECONSTRUCTED — validated by the 15 pre-registered subset fingerprints.\"\"\"\n    r = np.random.default_rng(seed)\n    pos, neg = (np.flatnonzero(tr_f.label.values == 1),\n                np.flatnonzero(tr_f.label.values == 0))\n    p = r.choice(pos, N // 2, replace=False)\n    n = r.choice(neg, N // 2, replace=False)\n    return tr_f.iloc[np.sort(np.concatenate([p, n]))].reset_index(drop=True)\n\n# ---------- 1. val selection subsample ---------------------------------------\nzva  = np.load(PATHS[\"emb val\"], allow_pickle=True)\nyva  = zva[\"label\"].astype(np.int64)\n\nvs   = va_f.sort_values([\"chrom\", \"pos\", \"ref\", \"alt\"], kind=\"mergesort\").reset_index(drop=True)\nr2   = np.random.default_rng(12345)\nnpos = round(2000 * vs.label.mean())\nsel  = vs.iloc[np.sort(np.concatenate([\n         r2.choice(np.flatnonzero(vs.label.values == 1), npos,        replace=False),\n         r2.choice(np.flatnonzero(vs.label.values == 0), 2000 - npos, replace=False)]))]\nSEL  = sel._i.values\ngot  = fingerprint(sel)\nassert got == \"46fbf402505ab8a1\", f\"val selection drift: {got}\"\nassert np.array_equal(yva[SEL], va_f.label.values[SEL]), \"SEL does not index the npz\"\n# Diagnostic, not an assertion. The brief warns SEL must not be *assumed* ascending;\n# it does not require it to be non-ascending. Whether it is depends on whether the\n# stored val slice already happens to be in (chrom,pos,ref,alt) order.\n_pre_sorted = np.array_equal(vs._i.values, np.arange(len(vs)))\n_sel_asc    = bool(np.all(np.diff(SEL) > 0))\nprint(f\"val slice already in (chrom,pos,ref,alt) order: {_pre_sorted}\")\nprint(f\"SEL ascending: {_sel_asc}  \"\n      f\"({'mergesort is a no-op here' if _pre_sorted else 'sort reorders rows'})\")\nassert _sel_asc == _pre_sorted, (\n    \"SEL ordering does not match the sortedness of the val slice — \"\n    \"the _i round-trip is broken\")\nprint(f\"val selection: {len(SEL):,} rows | {int(yva[SEL].sum())} pos \"\n      f\"({yva[SEL].mean():.1%}) | fp {got} OK  [SEL non-ascending, as expected]\")\n\n# ---------- 2. all 15 subsets + plans, against the pre-registered table ------\nPREREG = {  # (N, seed): (genes, pos_genes, subset_fp, plan_fp)\n (256,0):(107,59,\"eb654e3bd1917255\",\"f914392b4bbb0a1e\"), (256,1):(106,63,\"3071e96a6f15c9fc\",\"fdeaf97ac1377fa9\"),\n (256,2):(112,66,\"9a232495473f01c1\",\"c63b2d0e2c392ac5\"), (512,0):(137,88,\"4ca38e01df4bb458\",\"97766a57bb79958b\"),\n (512,1):(145,88,\"19b71645eeb20a9b\",\"4d6d144db7e9a94e\"), (512,2):(140,78,\"21c649eb73acb944\",\"69c2b1a2d8f73ecd\"),\n (1024,0):(166,100,\"cb34673402cbe4a9\",\"cf0d4f9b960ffede\"),(1024,1):(166,109,\"0d942e26154a8c54\",\"a1d54eab6e2