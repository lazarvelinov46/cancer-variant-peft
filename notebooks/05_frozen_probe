    "# bitsandbytes is NOT needed for Phase 3 (full FT) and its CUDA 12.8 gap is a\n",
    "# Phase 4 issue — excluded here deliberately.\n",
    "!pip uninstall -q -y triton\n",
    "!pip install -q \"transformers==4.43.4\" einops scikit-learn\n",
    "print(\"\\ntriton removed and pins installed.\")\n",
    "print(\">>> NOW RESTART THE KERNEL (Run -> Restart session), then run cell 2. <<<\")\n",
    "print(\"    triton is cached in sys.modules from the failed bitsandbytes import;\")\n",
    "print(\"    without a restart DNABERT-2 will still find it.\")"
