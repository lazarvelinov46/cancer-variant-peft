    "# Phase 3 · Step 6c — Throughput measurement (nothing is saved)\n",
    "import time, math, gc, numpy as np, torch\n",
    "\n",
    "train_df = df[df.split == \"train\"]\n",
    "VAL_N, TEST_N = 6450, 48328\n",
    "\n",
    "def make_batch(bs, seed):\n",
    "    b = train_df.sample(bs, random_state=seed)\n",
    "    prs = [ref_alt(r, cfg.window_bp) for r in b.itertuples()]\n",
    "    e = tok([a for a, _ in prs], [x for _, x in prs], padding=True,\n",
    "            truncation=True, max_length=cfg.max_length, return_tensors=\"pt\")\n",
    "    if cfg.zero_token_type_ids:\n",
    "        e[\"token_type_ids\"] = torch.zeros_like(e[\"input_ids\"])\n",
    "    return ({k: v.cuda() for k, v in e.items()},\n",
    "            torch.tensor(b.label.values, dtype=torch.long).cuda())\n",
    "\n",
    "def free():\n",
    "    model.zero_grad(set_to_none=True)\n",
    "    gc.collect(); torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n",
    "\n",
    "def time_train(bs, n_warm=3, n_meas=10):\n",
    "    free()\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay)\n",
    "    scaler = torch.amp.GradScaler(\"cuda\", enabled=cfg.amp)\n",
    "    model.train()\n",
    "    batches = [make_batch(bs, s) for s in range(n_warm + n_meas)]\n",
    "    ts = []\n",
    "    for i, (e, y) in enumerate(batches):\n",
    "        torch.cuda.synchronize(); t0 = time.perf_counter()\n",
    "        with torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=cfg.amp):\n",
    "            out = model(**e, labels=y)\n",
    "        scaler.scale(out.loss).backward()\n",
    "        scaler.unscale_(opt)\n",
    "        torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.max_grad_norm)\n",
    "        scaler.step(opt); scaler.update(); opt.zero_grad(set_to_none=True)\n",
    "        torch.cuda.synchronize()\n",
    "        if i >= n_warm: ts.append(time.perf_counter() - t0)\n",
    "    peak = torch.cuda.max_memory_allocated() / 1e9\n",
    "    del opt, scaler, batches; free()\n",
    "    return float(np.median(ts)), peak\n",
    "\n",
    "def time_eval(bs, n_warm=2, n_meas=8):\n",
    "    free(); model.eval()\n",
    "    batches = [make_batch(bs, 1000 + s) for s in range(n_warm + n_meas)]\n",
    "    ts = []\n",
    "    with torch.no_grad():\n",
    "        for i, (e, _) in enumerate(batches):\n",
    "            torch.cuda.synchronize(); t0 = time.perf_counter()\n",
    "            with torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=cfg.amp):\n",
    "                model(**e)\n",
    "            torch.cuda.synchronize()\n",
    "            if i >= n_warm: ts.append(time.perf_counter() - t0)\n",
    "    peak = torch.cuda.max_memory_allocated() / 1e9\n",
    "    del batches; free()\n",
    "    return float(np.median(ts)), peak\n",
    "\n",
    "# --- training throughput ----------------------------------------------------\n",
    "print(\"TRAIN (fwd + bwd + AdamW step)\")\n",
    "train_res = {}\n",
    "for bs in [16, 32, 64, 96]:\n",
    "    try:\n",
    "        t, m = time_train(bs)\n",
    "        train_res[bs] = (t, m)\n",
    "        print(f\"  bs {bs:>3}  {t*1000:7.1f} ms/step  {bs/t:7.1f} ex/s  peak {m:5.2f} GB\")\n",
    "    except torch.cuda.OutOfMemoryError:\n",
    "        print(f\"  bs {bs:>3}  OOM\"); free(); break\n",
    "\n",
    "# --- eval throughput --------------------------------------------------------\n",
    "print(\"\\nEVAL (forward only, no_grad)\")\n",
    "eval_res = {}\n",
    "for bs in [64, 128, 256]:\n",
    "    try:\n",
    "        t, m = time_eval(bs)\n",
    "        eval_res[bs] = (t, m)\n",
    "        print(f\"  bs {bs:>3}  {t*1000:7.1f} ms/batch  {bs/t:7.1f} ex/s  peak {m:5.2f} GB\")\n",
    "    except torch.cuda.OutOfMemoryError:\n",
    "        print(f\"  bs {bs:>3}  OOM\"); free(); break\n",
    "\n",
    "# --- budget arithmetic ------------------------------------------------------\n",
    "TRAIN_BS = 32\n",
    "EVAL_BS  = max(eval_res)\n",
    "t_step   = train_res[TRAIN_BS][0]\n",
    "t_fwd    = eval_res[EVAL_BS][0]\n",
    "val_pass, test_pass = math.ceil(VAL_N / EVAL_BS), math.ceil(TEST_N / EVAL_BS)\n",
    "\n",
    "print(f\"\\n--- budget @ train bs {TRAIN_BS}, eval bs {EVAL_BS} ---\")\n",
    "print(f\"one full val pass : {val_pass:>4} batches = {val_pass*t_fwd:6.1f} s\")\n",
    "print(f\"one full test pass: {test_pass:>4} batches = {test_pass*t_fwd:6.1f} s\")\n",
    "\n",
    "for steps, every in [(600, 50), (600, 100), (1000, 100), (1500, 150)]:\n",
    "    n_ev  = steps // every\n",
    "    tr_s  = steps * t_step\n",
    "    val_s = n_ev * val_pass * t_fwd\n",
    "    run_s = tr_s + val_s + test_pass * t_fwd\n",
    "    print(f\"\\nsteps {steps:>4} | eval every {every:>3} ({n_ev} evals)\")\n",
    "    print(f\"  train {tr_s/60:5.1f} min | val {val_s/60:5.1f} min \"\n",
    "          f\"({100*val_s/tr_s:4.0f}% of train) | +test {test_pass*t_fwd/60:4.1f} min\")\n",
    "    print(f\"  per run {run_s/60:5.1f} min | 45 training runs = {45*run_s/3600:5.1f} GPU-hr\")\n",
    "\n",
    "print(f\"\\nweekly quota ~30 GPU-hr | N=4096 at bs {TRAIN_BS} = \"\n",
    "      f\"{4096/TRAIN_BS:.0f} steps/epoch\")"
