    "# Phase 3 · Step 6d — cell 2 of 3: evaluation, metrics, threshold tuning\n",
    "import numpy as np, torch, json, os\n",
    "from dataclasses import replace\n",
    "from sklearn.metrics import roc_auc_score, average_precision_score\n",
    "\n",
    "cfg = replace(cfg, max_steps=1000)     # Step 6c decision; 600 was a stale default\n",
    "print(f\"{cfg.run_id} | max_steps {cfg.max_steps} | eval_every {cfg.eval_every} \"\n",
    "      f\"| {cfg.max_steps/steps_per_epoch:.1f} epochs\")\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict(model, loader, amp=True):\n",
    "    \"\"\"Forward-only. Returns (logits float32 [N,2], labels int64 [N]) on CPU.\n",
    "    Order matches the loader's frame exactly (all eval loaders are shuffle=False).\"\"\"\n",
    "    model.eval()\n",
    "    L, Y = [], []\n",
    "    for enc, ys in loader:\n",
    "        enc = {k: v.cuda(non_blocking=True) for k, v in enc.items()}\n",
    "        with torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=amp):\n",
    "            out = model(**enc)\n",
    "        L.append(out.logits.detach().float().cpu())\n",
    "        Y.append(ys)\n",
    "    return torch.cat(L).numpy(), torch.cat(Y).numpy()\n",
    "\n",
    "\n",
    "def prob_pos(logits):\n",
    "    z = logits - logits.max(axis=1, keepdims=True)\n",
    "    e = np.exp(z)\n",
    "    return e[:, 1] / e.sum(axis=1)\n",
    "\n",
    "\n",
    "def mcc_curve(p, y):\n",
    "    \"\"\"MCC at every distinct cut point, vectorised — O(n log n), not O(n^2).\n",
    "    Sort by score desc; predicting positive for the top k gives running TP/FP.\"\"\"\n",
    "    order = np.argsort(-p, kind=\"mergesort\")\n",
    "    ps, ys = p[order], y[order].astype(np.int64)\n",
    "    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n",
    "    tp = np.cumsum(ys)\n",
    "    k  = np.arange(1, len(ys) + 1, dtype=np.int64)\n",
    "    fp, fn = k - tp, P - tp\n",
    "    tn = N - fp\n",
    "    num = (tp * tn - fp * fn).astype(float)\n",
    "    den = np.sqrt((tp + fp).astype(float) * (tp + fn) * (tn + fp) * (tn + fn))\n",
    "    mcc = np.divide(num, den, out=np.zeros_like(num), where=den > 0)\n",
    "    keep = np.r_[np.diff(ps) != 0, True]      # only real cut points\n",
    "    return ps[keep], mcc[keep]\n",
    "\n",
    "\n",
    "def tune_threshold(p, y):\n",
    "    th, m = mcc_curve(p, y)\n",
    "    i = int(np.argmax(m))\n",
    "    return float(th[i]), float(m[i])\n",
    "\n",
    "\n",
    "def metrics_at(p, y, thr):\n",
    "    yhat = (p >= thr).astype(int)\n",
    "    tp = int(((yhat == 1) & (y == 1)).sum()); tn = int(((yhat == 0) & (y == 0)).sum())\n",
    "    fp = int(((yhat == 1) & (y == 0)).sum()); fn = int(((yhat == 0) & (y == 1)).sum())\n",
    "    den = np.sqrt(float(tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))\n",
    "    mcc = 0.0 if den == 0 else (tp * tn - fp * fn) / den\n",
    "    prec = tp / (tp + fp) if tp + fp else 0.0\n",
    "    rec  = tp / (tp + fn) if tp + fn else 0.0\n",
    "    f1   = 2 * prec * rec / (prec + rec) if prec + rec else 0.0\n",
    "    out = {\"threshold\": float(thr), \"mcc\": float(mcc), \"f1\": float(f1),\n",
    "           \"precision\": float(prec), \"recall\": float(rec),\n",
    "           \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn,\n",
    "           \"n\": int(len(y)), \"n_pos\": int(y.sum())}\n",
    "    if 0 < y.sum() < len(y):                  # threshold-free, needs both classes\n",
    "        out[\"roc_auc\"] = float(roc_auc_score(y, p))\n",
    "        out[\"auprc\"]   = float(average_precision_score(y, p))\n",
    "    return out\n",
    "\n",
    "\n",
    "def param_report(model):\n",
    "    \"\"\"Split trainable params: head / adapter / backbone. Phase-4 ready.\"\"\"\n",
    "    tot = tr = head = adapter = backbone = 0\n",
    "    for n, p in model.named_parameters():\n",
    "        tot += p.numel()\n",
    "        if not p.requires_grad:\n",
    "            continue\n",
    "        tr += p.numel()\n",
    "        if any(t in n for t in (\"lora_\", \"lora_magnitude\", \"dora_\")):\n",
    "            adapter += p.numel()\n",
    "        elif n.startswith((\"bert.embeddings\", \"bert.encoder\")):\n",
    "            backbone += p.numel()\n",
    "        else:\n",
    "            head += p.numel()\n",
    "    return {\"total\": tot, \"trainable\": tr, \"trainable_pct\": round(100 * tr / tot, 4),\n",
    "            \"head\": head, \"adapter\": adapter, \"backbone\": backbone}\n",
    "\n",
    "\n",
    "def save_logits(path, **arrays):\n",
    "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
    "    np.savez_compressed(path, **arrays)\n",
    "\n",
    "\n",
    "# --- sanity: an untrained model must score at chance ------------------------\n",
    "print(\"\\nparams:\", json.dumps(param_report(model), indent=2))\n",
    "\n",
    "lg, yv = predict(model, val_sel_loader, amp=cfg.amp)\n",
    "p = prob_pos(lg)\n",
    "print(f\"\\nval-subsample predict: logits {lg.shape} | labels {yv.shape} \"\n",
    "      f\"| p range [{p.min():.4f}, {p.max():.4f}]\")\n",
    "assert len(yv) == len(val_sel) and (yv == val_sel.label.values).all(), \\\n",
    "    \"loader order does not match the frame — index alignment broken\"\n",
    "\n",
    "thr, best = tune_threshold(p, yv)\n",
    "m = metrics_at(p, yv, thr)\n",
    "print(f\"\\nuntrained @ max-MCC threshold {thr:.4f}\")\n",
    "for k in (\"mcc\", \"f1\", \"roc_auc\", \"auprc\", \"precision\", \"recall\"):\n",
    "    if k in m: print(f\"  {k:10} {m[k]:+.4f}\")\n",
    "print(f\"  confusion  tp {m['tp']} tn {m['tn']} fp {m['fp']} fn {m['fn']}\")\n",
    "\n",
    "th_c, m_c = mcc_curve(p, yv)\n",
    "print(f\"\\nthreshold sweep: {len(th_c)} cut points | \"\n",
    "      f\"MCC range [{m_c.min():+.4f}, {m_c.max():+.4f}] | @0.5 {metrics_at(p, yv, 0.5)['mcc']:+.4f}\")\n",
    "assert abs(m.get(\"roc_auc\", 0.5) - 0.5) < 0.12, \\\n",
    "    f\"untrained ROC-AUC {m.get('roc_auc'):.3f} — a random head should sit near 0.5\"\n",
    "print(\"\\ncell 2 ready\")"
