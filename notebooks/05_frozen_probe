   trust_remote_code=True)\nhf_cfg = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision,\n                                    num_labels=cfg.num_labels)\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    cfg.model_name, revision=cfg.revision, trust_remote_code=True, config=hf_cfg)\nprint(\"\\nloaded:\", type(model).__name__, \"|\", type(model).__module__)\nassert \"transformers_modules\" in type(model).__module__, \"got stock BERT, not DNABERT-2\"\nprint(\"params:\", f\"{sum(p.numel() for p in model.parameters()):,}\")\n\n# --- attention path: read the module global, don't trust the warning -------\nmm = sys.modules[type(model).__module__]\nflash = {k: v for k, v in vars(mm).items() if \"flash\" in k.lower()}\nprint(\"\\nflash-related globals in bert_layers:\")\nfor k, v in flash.items():\n    print(f\"  {k:32} {v}\")\nassert flash, \"no flash globals found — inspect bert_layers manually before trusting timings\"\nassert all(v is None for v in flash.values()), \\\n    \"Triton FlashAttention is ACTIVE — timings will not match the validated eager path\"\nprint(\"-> eager PyTorch attention confirmed\")\n\nmodel = model.cuda()\n\n# --- tokenize; token_type_ids forced to zero (Step 4) ----------------------\nenc = tok([a for a, _ in pairs], [b for _, b in pairs],\n          padding=True, truncation=True, max_length=cfg.max_length,\n          return_tensors=\"pt\")\nprint(f\"\\ntokenized: input_ids {tuple(enc['input_ids'].shape)} \"\n      f\"| tti unique before zeroing {set(enc['token_type_ids'].flatten().tolist())}\")\nif cfg.zero_token_type_ids:\n    enc[\"token_type_ids\"] = torch.zeros_like(enc[\"input_ids\"])\nbatch = {k: v.cuda() for k, v in enc.items()}\nlabels = labels.cuda()\n\n# --- one instrumented forward + backward -----------------------------------\nmodel.train()\nopt = torch.optim.AdamW(model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay)\nscaler = torch.amp.GradScaler(\"cuda\", enabled=cfg.amp)\n\ntorch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\nwith torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=cfg.amp):\n    out = model(**batch, labels=labels)\nscaler.scale(out.loss).backward()\nscaler.unscale_(opt)\ngnorm = torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.max_grad_norm)\nscaler.step(opt); scaler.update(); opt.zero_grad(set_to_none=True)\n\nloss = float(out.loss)\nprint(f\"\\nloss {loss:.4f} | grad_norm {float(gnorm):.4f} | logits {tuple(out.logits.shape)}\")\nassert np.isfinite(loss) and np.isfinite(float(gnorm)), \\\n    \"non-finite under AMP — set cfg.amp=False and re-measure the time budget\"\nprint(f\"peak VRAM this step: {torch.cuda.max_memory_allocated()/1e9:.2f} GB of {vram:.1f} GB\")\n\n# --- hidden_states: the Step 5 loose end -----------------------------------\nhs = out.hidden_states\nif hs is None:\n    print(\"hidden_states: None (no extra memory held)\")\nelif isinstance(hs, torch.Tensor):\n    print(f\"hidden_states: single tensor {tuple(hs.shape)} — likely the encoder output\")\nelse:\n    print(f\"hidden_states: {len(hs)} tensors, each {tuple(hs[0].shape)} — \"\n          \"drop before accumulating\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-23T14:23:06.281129Z","iopub.execute_input":"2026-07-23T14:23:06.28207Z","iopub.status.idle":"2026-07-23T14:23:18.804716Z","shell.execute_reply.started":"2026-07-23T14:23:06.28204Z","shell.execute_reply":"2026-07-23T14:23:18.803845Z"}},"outputs":[{"name":"stdout","text":"v2 confirmed: val 6,450 rows / 1,125 pos (17.4%)\nbatch: 32 pairs @ 512 bp | 3 positive\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/158 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2889948dc8564d71802db2989b39ad70"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-