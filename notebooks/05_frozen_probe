    "# Phase 3 · Step 6d — cell 1 of 3: dataset, collator, subset construction\n",
    "import os, random, numpy as np, pandas as pd, torch\n",
    "from dataclasses import replace\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "\n",
    "os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"   # avoids fork deadlock warnings\n",
    "\n",
    "VAL_SELECT_N    = 2000     # fixed subsample used for checkpoint selection\n",
    "VAL_SELECT_SEED = 12345    # CONSTANT across every run — never cfg.seed\n",
    "\n",
    "cfg = replace(cfg, n_train=4096)                 # the Phase 3 anchor\n",
    "print(f\"config: {cfg.run_id} | batch {cfg.batch_size} | max_steps {cfg.max_steps}\")\n",
    "\n",
    "\n",
    "def set_seed(s: int):\n",
    "    random.seed(s); np.random.seed(s)\n",
    "    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n",
    "\n",
    "\n",
    "# --- representation: crop 1024bp -> window_bp, derive alt by base swap -------\n",
    "def crop(seq, off, L):\n",
    "    n = len(seq)\n",
    "    if n <= L:\n",
    "        return seq, off\n",
    "    start = max(0, min(off - L // 2, n - L))\n",
    "    return seq[start:start + L], off - start\n",
    "\n",
    "\n",
    "class VariantDataset(Dataset):\n",
    "    \"\"\"Holds raw sequence; cropping and alt derivation happen per item,\n",
    "    tokenization happens in the collator. Keeps window_bp a live config knob.\"\"\"\n",
    "    def __init__(self, frame, window_bp):\n",
    "        self.win  = frame[\"ref_window\"].tolist()\n",
    "        self.off  = frame[\"offset\"].astype(int).tolist()\n",
    "        self.ref  = frame[\"ref\"].tolist()\n",
    "        self.alt  = frame[\"alt\"].tolist()\n",
    "        self.y    = frame[\"label\"].astype(int).tolist()\n",
    "        self.L    = window_bp\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.y)\n",
    "\n",
    "    def __getitem__(self, i):\n",
    "        w, o = crop(self.win[i], self.off[i], self.L)\n",
    "        assert w[o] == self.ref[i], f\"offset/ref mismatch at row {i}\"\n",
    "        return w, w[:o] + self.alt[i] + w[o + 1:], self.y[i]\n",
    "\n",
    "\n",
    "def make_collate(tok, cfg):\n",
    "    def collate(batch):\n",
    "        refs = [b[0] for b in batch]\n",
    "        alts = [b[1] for b in batch]\n",
    "        ys   = torch.tensor([b[2] for b in batch], dtype=torch.long)\n",
    "        enc = tok(refs, alts, padding=True, truncation=True,\n",
    "                  max_length=cfg.max_length, return_tensors=\"pt\")\n",
    "        if cfg.zero_token_type_ids:                      # segment row 1 untrained (Step 4)\n",
    "            enc[\"token_type_ids\"] = torch.zeros_like(enc[\"input_ids\"])\n",
    "        return enc, ys\n",
    "    return collate\n",
    "\n",
    "\n",
    "# --- training subset: balanced draw, or full pool with class weights --------\n",
    "def build_train_subset(df, n_train, seed):\n",
    "    tr = df[df.split == \"train\"]\n",
    "    if n_train is None:                                   # ceiling run\n",
    "        n_pos = int(tr.label.sum()); n_neg = len(tr) - n_pos\n",
    "        w = torch.tensor([len(tr) / (2 * n_neg), len(tr) / (2 * n_pos)],\n",
    "                         dtype=torch.float)\n",
    "        return tr.sample(frac=1, random_state=seed), w\n",
    "    half = n_train // 2\n",
    "    pos, neg = tr[tr.label == 1], tr[tr.label == 0]\n",
    "    assert len(pos) >= half, f\"need {half} positives, pool has {len(pos)}\"\n",
    "    assert len(neg) >= half, f\"need {half} negatives, pool has {len(neg)}\"\n",
    "    sub = pd.concat([pos.sample(half, random_state=seed),\n",
    "                     neg.sample(half, random_state=seed)])\n",
    "    return sub.sample(frac=1, random_state=seed).reset_index(drop=True), None\n",
    "\n",
    "\n",
    "set_seed(cfg.seed)\n",
    "train_sub, class_w = build_train_subset(df, cfg.n_train, cfg.seed)\n",
    "n_pos = int(train_sub.label.sum())\n",
    "print(f\"\\ntrain subset: {len(train_sub):,} rows | {n_pos:,} pos \"\n",
    "      f\"({n_pos/len(train_sub):.1%}) | {train_sub.gene.nunique()} genes\")\n",
    "print(f\"class weights: {None if class_w is None else class_w.tolist()}\")\n",
    "\n",
    "# per-gene concentration — uncapped draw, so check hotspot dominance\n",
    "gc_ = train_sub.gene.value_counts()\n",
    "gp_ = train_sub[train_sub.label == 1].gene.value_counts()\n",
    "print(f\"  all rows : top gene {gc_.iloc[0]/gc_.sum():.1%}, top-5 {gc_.iloc[:5].sum()/gc_.sum():.1%}\")\n",
    "print(f\"  positives: top gene {gp_.iloc[0]/gp_.sum():.1%}, top-5 {gp_.iloc[:5].sum()/gp_.sum():.1%}, \"\n",
    "      f\"across {gp_.size} genes\")\n",
    "\n",
    "# --- fixed stratified val subsample (identical in every run) ----------------\n",
    "val_full = df[df.split == \"val\"]\n",
    "n_sel_pos = round(VAL_SELECT_N * val_full.label.mean())\n",
    "val_sel = pd.concat([\n",
    "    val_full[val_full.label == 1].sample(n_sel_pos, random_state=VAL_SELECT_SEED),\n",
    "    val_full[val_full.label == 0].sample(VAL_SELECT_N - n_sel_pos,\n",
    "                                         random_state=VAL_SELECT_SEED)]).reset_index(drop=True)\n",
    "test_full = df[df.split == \"test\"]\n",
    "print(f\"\\nval selection subsample: {len(val_sel):,} rows | {int(val_sel.label.sum())} pos \"\n",
    "      f\"({val_sel.label.mean():.1%}) vs full val {val_full.label.mean():.1%}\")\n",
    "print(f\"val full {len(val_full):,} | test {len(test_full):,} | \"\n",
    "      f\"hard-eval {int(test_full.hard_eval.sum()):,}\")\n",
    "\n",
    "# --- loaders ----------------------------------------------------------------\n",
    "collate = make_collate(tok, cfg)\n",
    "g = torch.Generator(); g.manual_seed(cfg.seed)\n",
    "\n",
    "train_loader = DataLoader(VariantDataset(train_sub, cfg.window_bp),\n",
    "                          batch_size=cfg.batch_size, shuffle=True, drop_last=True,\n",
    "                          collate_fn=collate, num_workers=2, generator=g)\n",
    "val_sel_loader  = DataLoader(VariantDataset(val_sel,  cfg.window_bp),\n",
    "                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\n",
    "val_full_loader = DataLoader(VariantDataset(val_full, cfg.window_bp),\n",
    "                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\n",
    "test_loader     = DataLoader(VariantDataset(test_full, cfg.window_bp),\n",
    "                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\n",
    "\n",
    "def cycle(loader):\n",
    "    while True:\n",
    "        for b in loader:\n",
    "            yield b\n",
    "\n",
    "steps_per_epoch = len(train_sub) // cfg.batch_size\n",
    "print(f\"\\nsteps/epoch {steps_per_epoch} | {cfg.max_steps} steps = \"\n",
    "      f\"{cfg.max_steps/steps_per_epoch:.1f} epochs\")\n",
    "\n",
    "# --- verify one collated batch against the Step 4 budget --------------------\n",
    "enc, ys = next(iter(train_loader))\n",
    "print(f\"\\nbatch: input_ids {tuple(enc['input_ids'].shape)} | labels {tuple(ys.shape)} \"\n",
    "      f\"| {int(ys.sum())} pos\")\n",
    "print(f\"  token_type_ids all zero: {bool((enc['token_type_ids'] == 0).all())}\")\n",
    "print(f\"  tokens used {enc['input_ids'].shape[1]} of max_length {cfg.max_length}\")\n",
    "assert enc[\"input_ids\"].shape[1] <= cfg.max_length\n",
    "assert (enc[\"token_type_ids\"] == 0).all(), \"segment ids leaked — see Step 4\"\n",
    "print(\"\\ncell 1 ready\")"
   ]
