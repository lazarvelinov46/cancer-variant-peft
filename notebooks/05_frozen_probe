    "# Phase 3 · Step 6a — cell 2 of 2 (AFTER kernel restart): verify + configure\n",
    "import os\n",
    "os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"0\"   # T4 x2 -> DataParallel would corrupt VRAM metric\n",
    "\n",
    "import sys, torch, platform, importlib.util\n",
    "from dataclasses import dataclass, asdict\n",
    "from typing import Optional\n",
    "\n",
    "print(\"python      \", sys.version.split()[0])\n",
    "print(\"torch       \", torch.__version__, \"| cuda\", torch.version.cuda)\n",
    "assert torch.cuda.is_available(), \"No GPU — set the accelerator to GPU T4 in the sidebar\"\n",
    "assert torch.cuda.device_count() == 1, f\"{torch.cuda.device_count()} GPUs visible — DataParallel risk\"\n",
    "\n",
    "name = torch.cuda.get_device_name(0)\n",
    "cc   = torch.cuda.get_device_capability(0)\n",
    "vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "print(f\"device       {name} | cc {cc[0]}.{cc[1]} | {vram:.1f} GB | visible GPUs 1\")\n",
    "assert cc >= (7, 5), (f\"{name} is cc {cc[0]}.{cc[1]}; bitsandbytes 4-bit needs >= 7.5. \"\n",
    "                      \"All runs must use T4 for the QLoRA arm to be comparable.\")\n",
    "AMP_OK = True   # T4 has tensor cores\n",
    "\n",
    "# triton must be gone — otherwise DNABERT-2 may take a different attention path\n",
    "assert importlib.util.find_spec(\"triton\") is None, \"triton still installed — rerun cell 1\"\n",
    "assert \"triton\" not in sys.modules, \"triton cached in sys.modules — restart the kernel\"\n",
    "print(\"triton       absent from disk and sys.modules (eager attention guaranteed)\")\n",
    "\n",
    "import transformers, peft\n",
    "print(\"\\ntransformers\", transformers.__version__)\n",
    "print(\"peft        \", peft.__version__)\n",
    "assert transformers.__version__ == \"4.43.4\", \"pin broken — DNABERT-2 remote code will fail\"\n",
    "print(\"bitsandbytes not imported (Phase 3 needs no quantization)\")\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class RunConfig:\n",
    "    regime: str = \"full_ft\"              # full_ft | lora | qlora | zeroshot\n",
    "    n_train: Optional[int] = None        # balanced N; None = full train pool\n",
    "    seed: int = 0\n",
    "\n",
    "    model_name: str = \"zhihan1996/DNABERT-2-117M\"\n",
    "    revision: str  = \"7bce263b15377fc15361f52cfab88f8b586abda0\"\n",
    "    num_labels: int = 2\n",
    "\n",
    "    window_bp: int = 512                 # centred crop from the stored 1024 bp window\n",
    "    max_length: int = 256                # p99 231, max observed 237\n",
    "    zero_token_type_ids: bool = True     # segment row 1 is untrained (Step 4)\n",
    "\n",
    "    lr: float = 3e-5                     # PLACEHOLDER until the per-regime sweep\n",
    "    weight_decay: float = 0.01\n",
    "    warmup_ratio: float = 0.1\n",
    "    max_steps: int = 600                 # fixed step budget across all N\n",
    "    batch_size: int = 32\n",
    "    grad_accum: int = 1\n",
    "    max_grad_norm: float = 1.0\n",
    "    amp: bool = AMP_OK\n",
    "\n",
    "    eval_every: int = 50\n",
    "    eval_batch_size: int = 64\n",
    "    out_root: str = \"/kaggle/working/runs\"\n",
    "\n",
    "    @property\n",
    "    def run_id(self) -> str:\n",
    "        n = \"full\" if self.n_train is None else f\"n{self.n_train}\"\n",
    "        return f\"{self.regime}_{n}_seed{self.seed}\"\n",
    "\n",
    "    def manifest(self) -> dict:\n",
    "        return {**asdict(self), \"run_id\": self.run_id, \"gpu\": name,\n",
    "                \"compute_capability\": f\"{cc[0]}.{cc[1]}\", \"vram_gb\": round(vram, 1),\n",
    "                \"n_gpus_visible\": torch.cuda.device_count(),\n",
    "                \"torch\": torch.__version__, \"transformers\": transformers.__version__,\n",
    "                \"peft\": peft.__version__, \"triton\": None,\n",
    "                \"platform\": platform.platform()}\n",
    "\n",
    "cfg = RunConfig()\n",
    "print(f\"\\nrun_id: {cfg.run_id}\")\n",
    "for k, v in cfg.manifest().items():\n",
    "    print(f\"  {k:22} {v}\")"
