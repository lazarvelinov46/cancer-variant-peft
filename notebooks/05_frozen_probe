    "# Phase 3 · Step 10 — Cache frozen mean-pooled embeddings at 1024 bp (GPU)\n",
    "import os, time, numpy as np, torch, hashlib, json\n",
    "from transformers import AutoModel\n",
    "from transformers.models.bert.configuration_bert import BertConfig\n",
    "\n",
    "CACHE_BP  = 1024                              # Step 8d: signal best at 1024\n",
    "CACHE_DIR = \"/kaggle/working/embeddings\"\n",
    "os.makedirs(CACHE_DIR, exist_ok=True)\n",
    "\n",
    "# --- fresh FROZEN backbone (AutoModel = backbone only, no classifier head) --\n",
    "bb_cfg = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision)\n",
    "backbone = AutoModel.from_pretrained(cfg.model_name, revision=cfg.revision,\n",
    "                                     trust_remote_code=True, config=bb_cfg).cuda().eval()\n",
    "for p in backbone.parameters():\n",
    "    p.requires_grad = False\n",
    "\n",
    "mm = __import__(\"sys\").modules[type(backbone).__module__]\n",
    "assert all(v is None for k, v in vars(mm).items() if \"flash\" in k.lower()), \\\n",
    "    \"Triton FlashAttention active — restart with triton removed\"\n",
    "print(f\"frozen backbone | {sum(p.numel() for p in backbone.parameters()):,} params | eager\")\n",
    "\n",
    "@torch.no_grad()\n",
    "def embed(frame, L, bs=48):\n",
    "    \"\"\"Mean-pooled h_ref and h_alt for every row. Order matches `frame` exactly.\"\"\"\n",
    "    rows = list(frame.itertuples())\n",
    "    HR = np.empty((len(rows), 768), dtype=np.float32)\n",
    "    HA = np.empty((len(rows), 768), dtype=np.float32)\n",
    "    t0 = time.perf_counter()\n",
    "    for i in range(0, len(rows), bs):\n",
    "        ch = rows[i:i+bs]\n",
    "        refs, alts = [], []\n",
    "        for r in ch:\n",
    "            w, o = crop(r.ref_window, r.offset, L)\n",
    "            assert w[o] == r.ref\n",
    "            refs.append(w); alts.append(w[:o] + r.alt + w[o+1:])\n",
    "        for tag, seqs, out in [(\"r\", refs, HR), (\"a\", alts, HA)]:\n",
    "            b = tok(seqs, padding=True, truncation=True, max_length=cfg.max_length,\n",
    "                    return_tensors=\"pt\")\n",
    "            b = {k: v.cuda() for k, v in b.items()}\n",
    "            b[\"token_type_ids\"] = torch.zeros_like(b[\"input_ids\"])\n",
    "            with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n",
    "                h = backbone(**b)[0].float()\n",
    "            m = b[\"attention_mask\"].unsqueeze(-1).float()\n",
    "            out[i:i+len(ch)] = ((h * m).sum(1) / m.sum(1)).cpu().numpy()\n",
    "        if i % (bs * 40) == 0:\n",
    "            done = i + len(ch)\n",
    "            print(f\"  {done:>6}/{len(rows)}  {done/(time.perf_counter()-t0):6.0f} rows/s\")\n",
    "    return HR, HA\n",
    "\n",
    "for split in [\"train\", \"val\"]:\n",
    "    sub = df[df.split == split].reset_index(drop=True)\n",
    "    print(f\"\\n{split}: {len(sub):,} rows\")\n",
    "    hr, ha = embed(sub, CACHE_BP)\n",
    "    y = sub.label.values.astype(np.int8)\n",
    "    genes = sub.gene.values.astype(str)\n",
    "    path = f\"{CACHE_DIR}/emb_{split}_{CACHE_BP}bp.npz\"\n",
    "    np.savez_compressed(path, h_ref=hr, h_alt=ha, label=y, gene=genes,\n",
    "                        mc=sub.mc.values.astype(str),\n",
    "                        hard_eval=(sub.hard_eval.values if \"hard_eval\" in sub else\n",
    "                                   np.zeros(len(sub), bool)))\n",
    "    # integrity: L2-norm AUC must reproduce the probe (0.6511 on the val subsample)\n",
    "    from sklearn.metrics import roc_auc_score\n",
    "    l2 = np.linalg.norm(hr - ha, axis=1)\n",
    "    a = roc_auc_score(y, l2); a = max(a, 1 - a)\n",
    "    md5 = hashlib.md5(open(path, \"rb\").read()).hexdigest()[:8]\n",
    "    print(f\"  saved {os.path.getsize(path)/1e6:.0f} MB | L2-norm full-{split} AUC {a:.4f} \"\n",
    "          f\"| mean |h_alt-h_ref| {l2.mean():.3f} | md5 {md5}\")\n",
    "\n",
    "print(\"\\ncache complete:\", sorted(os.listdir(CACHE_DIR)))\n",
    "print(\">>> Save Version now — do not let this session idle out. <<<\")"
   ]
