    "LOCAL_K = 2          # tokens either side of the variant token for local pooling\n",
    "\n",
    "@torch.no_grad()\n",
    "def pooled(seqs, offs, L, bs=32):\n",
    "    \"\"\"Returns (mean-pool, CLS, local-pool) representations for a list of sequences.\"\"\"\n",
    "    MP, CL, LO = [], [], []\n",
    "    for i in range(0, len(seqs), bs):\n",
    "        s, o = seqs[i:i+bs], offs[i:i+bs]\n",
    "        b = tok(s, padding=True, truncation=True, max_length=cfg.max_length,\n",
    "                return_tensors=\"pt\", return_offsets_mapping=True)\n",
    "        om = b.pop(\"offset_mapping\")\n",
    "        b = {k: v.cuda() for k, v in b.items()}\n",
    "        b[\"token_type_ids\"] = torch.zeros_like(b[\"input_ids\"])\n",
    "        with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n",
    "            h = base(**b)[0].float()\n",
    "        am = b[\"attention_mask\"].unsqueeze(-1).float()\n",
    "        MP.append(((h * am).sum(1) / am.sum(1)).cpu())\n",
    "        CL.append(h[:, 0].cpu())\n",
    "        loc = []\n",
    "        for j, off in enumerate(o):\n",
    "            hit = ((om[j, :, 0] <= off) & (off < om[j, :, 1])).nonzero()\n",
    "            c = int(hit[0]) if len(hit) else 1\n",
    "            lo, hi = max(1, c - LOCAL_K), min(int(b[\"attention_mask\"][j].sum()) - 1, c + LOCAL_K + 1)\n",
    "            loc.append(h[j, lo:hi].mean(0))\n",
    "        LO.append(torch.stack(loc).cpu())\n",
