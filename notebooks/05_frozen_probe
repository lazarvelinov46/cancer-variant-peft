    "# Phase 3 · Step 8 — Feasibility probe: does FROZEN DNABERT-2 encode variant effect?\n",
    "# Self-contained: needs only SETUP + cell 1. No trained model required.\n",
    "import os, torch, numpy as np, json\n",
    "from sklearn.metrics import roc_auc_score\n",
    "from transformers import AutoModelForMaskedLM\n",
    "\n",
    "RUN_DIR = os.path.join(cfg.out_root, cfg.run_id)      # defined in cell 3; recreate here\n",
    "os.makedirs(RUN_DIR, exist_ok=True)\n",
    "print(\"prior artifacts on disk:\", sorted(os.listdir(RUN_DIR)) or \"(none)\")\n",
    "\n",
    "def ref_alt(row, L):                                   # defined in step 6b; recreate here\n",
    "    w, o = crop(row.ref_window, row.offset, L)\n",
    "    assert w[o] == row.ref, f\"offset mismatch at {row.chrom}:{row.pos}\"\n",
    "    return w, w[:o] + row.alt + w[o + 1:]\n",
    "\n",
    "probe = val_sel                      # 2,000 rows, 349 pos, same subsample as selection\n",
    "y = probe.label.values.astype(int)\n",
    "assert tok.is_fast, \"need a fast tokenizer for offset mapping\"\n",
    "\n",
    "# --- fresh pretrained model with the MLM head ------------------------------\n",
    "mlm_cfg = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision)\n",
    "mlm, info = AutoModelForMaskedLM.from_pretrained(\n",
    "    cfg.model_name, revision=cfg.revision, trust_remote_code=True,\n",
    "    config=mlm_cfg, output_loading_info=True)\n",
    "mlm = mlm.cuda().eval()\n",
    "base = mlm.bert                      # frozen pretrained backbone\n",
    "\n",
    "miss = info.get(\"missing_keys\", [])\n",
    "head_random = any(any(t in k for t in (\"predictions\", \"cls.\", \"lm_head\")) for k in miss)\n",
    "print(\"\\nmissing keys:\", miss if miss else \"none\")\n",
    "print(\"MLM head randomly initialized:\", head_random)\n",
    "\n",
    "# --- functional check: can it fill masked genomic tokens? ------------------\n",
    "seqs = [crop(r.ref_window, r.offset, cfg.window_bp)[0] for r in probe.head(128).itertuples()]\n",
    "e = tok(seqs, padding=True, truncation=True, max_length=cfg.max_length, return_tensors=\"pt\")\n",
    "ids, am = e[\"input_ids\"].clone(), e[\"attention_mask\"]\n",
    "maskable = ~torch.isin(ids, torch.tensor(tok.all_special_ids)) & am.bool()\n",
    "torch.manual_seed(0)\n",
    "sel = maskable & (torch.rand(ids.shape) < 0.15)\n",
    "truth = ids.clone(); ids[sel] = tok.mask_token_id\n",
    "with torch.no_grad():\n",
    "    lg = mlm(input_ids=ids.cuda(), attention_mask=am.cuda(),\n",
    "             token_type_ids=torch.zeros_like(ids).cuda()).logits\n",
    "acc = (lg.argmax(-1).cpu()[sel] == truth[sel]).float().mean().item()\n",
    "print(f\"masked-token recovery: {acc:.4f}  (chance = 1/{tok.vocab_size} = {1/tok.vocab_size:.5f})\")\n",
    "MLM_OK = (not head_random) and acc > 0.05\n",
    "print(\"MLM head usable:\", MLM_OK)\n",
    "\n",
    "# --- probe 1: does a variant shift the representation? ---------------------\n",
    "@torch.no_grad()\n",
    "def encode(seq_list, bs=64):\n",
    "    mp, cl = [], []\n",
    "    for i in range(0, len(seq_list), bs):\n",
    "        b = tok(seq_list[i:i+bs], padding=True, truncation=True,\n",
    "                max_length=cfg.max_length, return_tensors=\"pt\")\n",
    "        b = {k: v.cuda() for k, v in b.items()}\n",
    "        b[\"token_type_ids\"] = torch.zeros_like(b[\"input_ids\"])\n",
    "        with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n",
    "            h = base(**b)[0].float()\n",
    "        m = b[\"attention_mask\"].unsqueeze(-1).float()\n",
    "        mp.append(((h * m).sum(1) / m.sum(1)).cpu()); cl.append(h[:, 0].cpu())\n",
    "    return torch.cat(mp).numpy(), torch.cat(cl).numpy()\n",
    "\n",
    "pairs = [ref_alt(r, cfg.window_bp) for r in probe.itertuples()]\n",
    "mp_r, cl_r = encode([a for a, _ in pairs])\n",
    "mp_a, cl_a = encode([b for _, b in pairs])\n",
    "\n",
    "def auc2(s):                          # signal in either direction\n",
    "    a = roc_auc_score(y, s)\n",
    "    return a, max(a, 1 - a)\n",
    "\n",
    "cos = 1 - (mp_r * mp_a).sum(1) / (np.linalg.norm(mp_r, axis=1) * np.linalg.norm(mp_a, axis=1))\n",
    "print(\"\\n=== probe 1: embedding shift (frozen backbone, no training) ===\")\n",
    "for nm, s in [(\"cosine dist (mean-pool)\", cos),\n",
    "              (\"L2 (mean-pool)\", np.linalg.norm(mp_r - mp_a, axis=1)),\n",
    "              (\"L2 (CLS)\",       np.linalg.norm(cl_r - cl_a, axis=1))]:\n",
    "    a, sig = auc2(s)\n",
    "    print(f\"  {nm:24} AUC {a:.4f} | |signal| {sig:.4f}\")\n",
    "\n",
    "# --- probe 2: is the reference base evolutionarily constrained? ------------\n",
