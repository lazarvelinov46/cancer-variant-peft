    "# Phase 3 · Step 11 — Head-architecture sweep on cached difference vectors (CPU ok)\n",
    "import numpy as np, torch, torch.nn as nn, json, time\n",
    "from sklearn.metrics import roc_auc_score\n",
    "\n",
    "CACHE_DIR = \"/kaggle/working/embeddings\"\n",
    "tr = np.load(f\"{CACHE_DIR}/emb_train_1024bp.npz\", allow_pickle=True)\n",
    "va = np.load(f\"{CACHE_DIR}/emb_val_1024bp.npz\",   allow_pickle=True)\n",
    "\n",
    "Xtr = (tr[\"h_alt\"] - tr[\"h_ref\"]).astype(np.float32); ytr = tr[\"label\"].astype(np.int64)\n",
    "Xva = (va[\"h_alt\"] - va[\"h_ref\"]).astype(np.float32); yva = va[\"label\"].astype(np.int64)\n",
    "\n",
    "# standardize on TRAIN stats only (applied to val — no leakage)\n",
    "mu, sd = Xtr.mean(0), Xtr.std(0) + 1e-6\n",
    "Xtr = (Xtr - mu) / sd; Xva = (Xva - mu) / sd\n",
    "print(f\"train {Xtr.shape} ({ytr.mean():.1%} pos) | val {Xva.shape} ({yva.mean():.1%} pos)\")\n",
    "\n",
    "dev = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "Xtr_t = torch.tensor(Xtr, device=dev); ytr_t = torch.tensor(ytr, device=dev)\n",
    "Xva_t = torch.tensor(Xva, device=dev)\n",
    "\n",
    "def mcc_curve(p, y):\n",
    "    o = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n",
    "    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n",
    "    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n",
    "    fp, fn = k - tp, P - tp; tn = N - fp\n",
    "    num = (tp * tn - fp * fn).astype(float)\n",
    "    den = np.sqrt((tp+fp).astype(float) * (tp+fn) * (tn+fp) * (tn+fn))\n",
    "    return np.divide(num, den, out=np.zeros_like(num), where=den > 0).max()\n",
    "\n",
    "def head(kind):\n",
    "    if kind == \"linear\": return nn.Linear(768, 2)\n",
    "    h = int(kind)\n",
    "    return nn.Sequential(nn.Linear(768, h), nn.GELU(), nn.Dropout(0.2), nn.Linear(h, 2))\n",
    "\n",
    "def train_head(kind, seed=0, epochs=60, lr=1e-3, wd=0.05):\n",
    "    torch.manual_seed(seed)\n",
    "    m = head(kind).to(dev)\n",
    "    opt = torch.optim.AdamW(m.parameters(), lr=lr, weight_decay=wd)\n",
    "    lossf = nn.CrossEntropyLoss()\n",
    "    n = len(Xtr_t); bs = 256\n",
    "    best_auc = best_mcc = 0.0\n",
    "    for ep in range(epochs):\n",
    "        m.train(); perm = torch.randperm(n, device=dev)\n",
    "        for i in range(0, n, bs):\n",
    "            idx = perm[i:i+bs]\n",
    "            opt.zero_grad()\n",
    "            lossf(m(Xtr_t[idx]), ytr_t[idx]).backward()\n",
    "            opt.step()\n",
    "        m.eval()\n",
    "        with torch.no_grad():\n",
    "            p = torch.softmax(m(Xva_t), 1)[:, 1].cpu().numpy()\n",
    "        auc = roc_auc_score(yva, p)\n",
    "        if auc > best_auc:\n",
    "            best_auc, best_mcc = auc, mcc_curve(p, yva)\n",
    "    return best_auc, best_mcc, sum(p.numel() for p in m.parameters())\n",
    "\n",
    "print(f\"\\n{'head':>8} {'params':>9} {'val AUC':>9} {'val MCC':>9}   (3-seed mean)\")\n",
    "print(\"-\" * 52)\n",
    "results = {}\n",
    "for kind in [\"linear\", \"128\", \"256\", \"512\", \"1024\"]:\n",
    "    t0 = time.perf_counter()\n",
    "    runs = [train_head(kind, s) for s in range(3)]\n",
    "    aucs, mccs, params = zip(*runs)\n",
    "    results[kind] = {\"auc\": float(np.mean(aucs)), \"auc_std\": float(np.std(aucs)),\n",
    "                     \"mcc\": float(np.mean(mccs)), \"params\": params[0]}\n",
    "    print(f\"{kind:>8} {params[0]:>9,} {np.mean(aucs):>9.4f} {np.mean(mccs):>9.4f}   \"\n",
    "          f\"±{np.std(aucs):.4f} auc | {time.perf_counter()-t0:.0f}s\")\n",
    "\n",
    "best = max(results, key=lambda k: results[k][\"auc\"])\n",
    "print(f\"\\nbest: {best}-head | val AUC {results[best]['auc']:.4f} | MCC {results[best]['mcc']:.4f}\")\n",
    "print(f\"zero-shot L2-norm baseline was AUC 0.6291 (full val)\")\n",
    "print(f\"gate for continuing: AUC > ~0.68\")\n",
    "json.dump(results, open(f\"{CACHE_DIR}/head_sweep.json\", \"w\"), indent=2)"
   ]
