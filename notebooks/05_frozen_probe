\nsched  = get_linear_schedule_with_warmup(opt, warmup, cfg.max_steps)\nscaler = torch.amp.GradScaler(\"cuda\", enabled=cfg.amp)\n\n# loss computed here, not by the model — lets the ceiling run pass class weights\nloss_fn = torch.nn.CrossEntropyLoss(\n    weight=None if class_w is None else class_w.cuda())\nprint(f\"AdamW lr {cfg.lr} | warmup {warmup}/{cfg.max_steps} | \"\n      f\"decay groups {len(decay)}/{len(no_decay)} | class weights \"\n      f\"{None if class_w is None else [round(w,3) for w in class_w.tolist()]}\")\n\n# --- train ------------------------------------------------------------------\ntrain_iter = cycle(train_loader)\nhistory, topk = [], []              # topk: (mcc, step, path)\nbest_mcc, stale, run_loss = -2.0, 0, []\nt_start = time.perf_counter()\n\nfor step in range(1, cfg.max_steps + 1):\n    model.train()\n    enc, ys = next(train_iter)\n    enc = {k: v.cuda(non_blocking=True) for k, v in enc.items()}\n    ys  = ys.cuda(non_blocking=True)\n\n    with torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=cfg.amp):\n        logits = model(**enc).logits\n    loss = loss_fn(logits.float(), ys)          # loss in fp32 for stability\n    scaler.scale(loss).backward()\n    scaler.unscale_(opt)\n    gnorm = torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.max_grad_norm)\n    scaler.step(opt); scaler.update()\n    opt.zero_grad(set_to_none=True); sched.step()\n    run_loss.append(loss.detach().item())       # detach — never retain the graph\n\n    if step % cfg.eval_every == 0 or step == cfg.max_steps:\n        lg, yv = predict(model, val_sel_loader, amp=cfg.amp)\n        thr_s, mcc_s = tune_threshold(prob_pos(lg), yv)\n        rec = {\"step\": step, \"train_loss\": float(np.mean(run_loss)),\n               \"grad_norm\": float(gnorm), \"lr\": sched.get_last_lr()[0],\n               \"val_sel_mcc\": mcc_s, \"val_sel_thr\": thr_s,\n               \"elapsed_s\": time.perf_counter() - t_start}\n        history.append(rec); run_loss = []\n    