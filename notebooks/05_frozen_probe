loat32); ytr = tr[\"label\"].astype(np.int64)\nXva = (va[\"h_alt\"] - va[\"h_ref\"]).astype(np.float32); yva = va[\"label\"].astype(np.int64)\n\n# standardize on TRAIN stats only (applied to val — no leakage)\nmu, sd = Xtr.mean(0), Xtr.std(0) + 1e-6\nXtr = (Xtr - mu) / sd; Xva = (Xva - mu) / sd\nprint(f\"train {Xtr.shape} ({ytr.mean():.1%} pos) | val {Xva.shape} ({yva.mean():.1%} pos)\")\n\ndev = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nXtr_t = torch.tensor(Xtr, device=dev); ytr_t = torch.tensor(ytr, device=dev)\nXva_t = torch.tensor(Xva, device=dev)\n\ndef mcc_curve(p, y):\n    o = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n    fp, fn = k - tp, P - tp; tn = N - fp\n    num = (tp * tn - fp * fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float) * (tp+fn) * (tn+fp) * (tn+fn))\n    return np.divide(num, den, out=np.zeros_like(num), where=den > 0).max()\n\ndef head(kind):\n    if kind == \"linear\": return nn.Linear(768, 2)\n    h = int(kind)\n    return nn.Sequential(nn.Linear(768, h), nn.GELU(), nn.Dropout(0.2), nn.Linear(h, 2))\n\ndef train_head(kind, seed=0, epochs=60, lr=1e-3, wd=0.05):\n    torch.manual_seed(seed)\n    m = head(kind).to(dev)\n    opt = torch.optim.AdamW(m.parameters(), lr=lr, weight_decay=wd)\n    lossf = nn.CrossEntropyLoss()\n    n = len(Xtr_t); bs = 256\n    best_auc = best_mcc = 0.0\n    for ep in range(epochs):\n        m.train(); perm = torch.randperm(n, device=dev)\n        for i in range(0, n, bs):\n            idx = perm[i:i+bs]\n            opt.zero_grad()\n            lossf(m(Xtr_t[idx]), ytr_t[idx]).backward()\n            opt.step()\n        m.eval()\n        with torch.no_grad():\n            p = torch.softmax(m(Xva_t), 1)[:, 1].cpu().numpy()\n        auc = roc_auc_score(yva, p)\n        if auc > best_auc:\n            best_auc, best_mcc = auc, mcc_curve(p, yva)\n    return best_auc, best_mcc