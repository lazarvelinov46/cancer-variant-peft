    "# Phase 3 · Step 6b — Load DNABERT-2 on GPU, verify attention path, one real step\n",
    "import sys, numpy as np, pandas as pd, torch\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification\n",
    "from transformers.models.bert.configuration_bert import BertConfig   # stock — see Step 5\n",
    "\n",
    "PQ = \"/kaggle/input/datasets/lazarvelinov46/cancer-variant-peft-processed/variant_windows_1024_split_v2.parquet\"\n",
    "df = pd.read_parquet(PQ)\n",
    "\n",
    "# --- v2 attachment guard (stale pin fails silently otherwise) ---------------\n",
    "exp = {\"train\": (434, 37241, 5309), \"val\": (155, 6450, 1125), \"test\": (40, 48328, 9284)}\n",
    "for sp, (g, n, p) in exp.items():\n",
    "    s = df[df.split == sp]\n",
    "    got = (s.gene.nunique(), len(s), int(s.label.sum()))\n",
    "    assert got == (g, n, p), f\"{sp}: expected {(g,n,p)}, got {got} — WRONG DATASET VERSION\"\n",
    "print(\"v2 confirmed: val 6,450 rows / 1,125 pos (17.4%)\")\n",
    "\n",
    "# --- representation helpers (these become the collator) --------------------\n",
    "def crop(seq, off, L):\n",
    "    n = len(seq)\n",
    "    if n <= L: return seq, off\n",
    "    start = max(0, min(off - L // 2, n - L))\n",
    "    return seq[start:start + L], off - start\n",
    "\n",
    "def ref_alt(row, L):\n",
    "    w, o = crop(row.ref_window, row.offset, L)\n",
    "    assert w[o] == row.ref, f\"offset mismatch at {row.chrom}:{row.pos}\"\n",
    "    return w, w[:o] + row.alt + w[o + 1:]\n",
    "\n",
    "batch_df = df[df.split == \"train\"].sample(cfg.batch_size, random_state=cfg.seed)\n",
    "pairs = [ref_alt(r, cfg.window_bp) for r in batch_df.itertuples()]\n",
    "labels = torch.tensor(batch_df.label.values, dtype=torch.long)\n",
    "print(f\"batch: {len(pairs)} pairs @ {cfg.window_bp} bp | {int(labels.sum())} positive\")\n",
    "\n",
    "# --- load (stock BertConfig, pinned revision) ------------------------------\n",
    "tok = AutoTokenizer.from_pretrained(cfg.model_name, revision=cfg.revision,\n",
    "                                    trust_remote_code=True)\n",
    "hf_cfg = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision,\n",
    "                                    num_labels=cfg.num_labels)\n",
    "model = AutoModelForSequenceClassification.from_pretrained(\n",
    "    cfg.model_name, revision=cfg.revision, trust_remote_code=True, config=hf_cfg)\n",
    "print(\"\\nloaded:\", type(model).__name__, \"|\", type(model).__module__)\n",
    "assert \"transformers_modules\" in type(model).__module__, \"got stock BERT, not DNABERT-2\"\n",
    "print(\"params:\", f\"{sum(p.numel() for p in model.parameters()):,}\")\n",
    "\n",
    "# --- attention path: read the module global, don't trust the warning -------\n",
    "mm = sys.modules[type(model).__module__]\n",
    "flash = {k: v for k, v in vars(mm).items() if \"flash\" in k.lower()}\n",
    "print(\"\\nflash-related globals in bert_layers:\")\n",
    "for k, v in flash.items():\n",
    "    print(f\"  {k:32} {v}\")\n",
    "assert flash, \"no flash globals found — inspect bert_layers manually before trusting timings\"\n",
    "assert all(v is None for v in flash.values()), \\\n",
    "    \"Triton FlashAttention is ACTIVE — timings will not match the validated eager path\"\n",
    "print(\"-> eager PyTorch attention confirmed\")\n",
    "\n",
    "model = model.cuda()\n",
    "\n",
    "# --- tokenize; token_type_ids forced to zero (Step 4) ----------------------\n",
    "enc = tok([a for a, _ in pairs], [b for _, b in pairs],\n",
    "          padding=True, truncation=True, max_length=cfg.max_length,\n",
    "          return_tensors=\"pt\")\n",
    "print(f\"\\ntokenized: input_ids {tuple(enc['input_ids'].shape)} \"\n",
    "      f\"| tti unique before zeroing {set(enc['token_type_ids'].flatten().tolist())}\")\n",
    "if cfg.zero_token_type_ids:\n",
    "    enc[\"token_type_ids\"] = torch.zeros_like(enc[\"input_ids\"])\n",
    "batch = {k: v.cuda() for k, v in enc.items()}\n",
    "labels = labels.cuda()\n",
    "\n",
    "# --- one instrumented forward + backward -----------------------------------\n",
    "model.train()\n",
    "opt = torch.optim.AdamW(model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay)\n",
    "scaler = torch.amp.GradScaler(\"cuda\", enabled=cfg.amp)\n",
    "\n",
    "torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n",
    "with torch.amp.autocast(\"cuda\", dtype=torch.float16, enabled=cfg.amp):\n",
    "    out = model(**batch, labels=labels)\n",
    "scaler.scale(out.loss).backward()\n",
    "scaler.unscale_(opt)\n",
    "gnorm = torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.max_grad_norm)\n",
    "scaler.step(opt); scaler.update(); opt.zero_grad(set_to_none=True)\n",
    "\n",
    "loss = float(out.loss)\n",
    "print(f\"\\nloss {loss:.4f} | grad_norm {float(gnorm):.4f} | logits {tuple(out.logits.shape)}\")\n",
