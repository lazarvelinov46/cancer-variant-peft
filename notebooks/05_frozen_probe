------------------------------------------------------------\ncollate = make_collate(tok, cfg)\ng = torch.Generator(); g.manual_seed(cfg.seed)\n\ntrain_loader = DataLoader(VariantDataset(train_sub, cfg.window_bp),\n                          batch_size=cfg.batch_size, shuffle=True, drop_last=True,\n                          collate_fn=collate, num_workers=2, generator=g)\nval_sel_loader  = DataLoader(VariantDataset(val_sel,  cfg.window_bp),\n                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\nval_full_loader = DataLoader(VariantDataset(val_full, cfg.window_bp),\n                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\ntest_loader     = DataLoader(VariantDataset(test_full, cfg.window_bp),\n                             batch_size=cfg.eval_batch_size, shuffle=False, collate_fn=collate)\n\ndef cycle(loader):\n    while True:\n        for b in loader:\n            yield b\n\nsteps_per_epoch = len(train_sub) // cfg.batch_size\nprint(f\"\\nsteps/epoch {steps_per_epoch} | {cfg.max_steps} steps = \"\n      f\"{cfg.max_steps/steps_per_epoch:.1f} epochs\")\n\n# --- verify one collated batch against the Step 4 budget --------------------\nenc, ys = next(iter(train_loader))\nprint(f\"\\nbatch: input_ids {tuple(enc['input_ids'].shape)} | labels {tuple(ys.shape)} \"\n      f\"| {int(ys.sum())} pos\")\nprint(f\"  token_type_ids all zero: {bool((enc['token_type_ids'] == 0).all())}\")\nprint(f\"  tokens used {enc['input_ids'].shape[1]} of max_length {cfg.max_length}\")\nassert enc[\"input_ids\"].shape[1] <= cfg.max_length\nassert (enc[\"token_type_ids\"] == 0).all(), \"segment ids leaked — see Step 4\"\nprint(\"\\ncell 1 ready\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T09:22:40.37287Z","iopub.execute_input":"2026-07-27T09:22:40.373562Z","iopub.status.idle":"2026-07-27T09:22:40.636984Z","shell.execute_reply.started":"2026-07-27T09:22:40.373511Z","shell.execute_reply":"2