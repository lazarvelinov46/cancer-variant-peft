   if not p.requires_grad:\n            continue\n        tr += p.numel()\n        if any(t in n for t in (\"lora_\", \"lora_magnitude\", \"dora_\")):\n            adapter += p.numel()\n        elif n.startswith((\"bert.embeddings\", \"bert.encoder\")):\n            backbone += p.numel()\n        else:\n            head += p.numel()\n    return {\"total\": tot, \"trainable\": tr, \"trainable_pct\": round(100 * tr / tot, 4),\n            \"head\": head, \"adapter\": adapter, \"backbone\": backbone}\n\n\ndef save_logits(path, **arrays):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    np.savez_compressed(path, **arrays)\n\n\n# --- sanity: an untrained model must score at chance ------------------------\nprint(\"\\nparams:\", json.dumps(param_report(model), indent=2))\n\nlg, yv = predict(model, val_sel_loader, amp=cfg.amp)\np = prob_pos(lg)\nprint(f\"\\nval-subsample predict: logits {lg.shape} | labels {yv.shape} \"\n      f\"| p range [{p.min():.4f}, {p.max():.4f}]\")\nassert len(yv) == len(val_sel) and (yv == val_sel.label.values).all(), \\\n    \"loader order does not match the frame — index alignment broken\"\n\nthr, best = tune_threshold(p, yv)\nm = metrics_at(p, yv, thr)\nprint(f\"\\nuntrained @ max-MCC threshold {thr:.4f}\")\nfor k in (\"mcc\", \"f1\", \"roc_auc\", \"auprc\", \"precision\", \"recall\"):\n    if k in m: print(f\"  {k:10} {m[k]:+.4f}\")\nprint(f\"  confusion  tp {m['tp']} tn {m['tn']} fp {m['fp']} fn {m['fn']}\")\n\nth_c, m_c = mcc_curve(p, yv)\nprint(f\"\\nthreshold sweep: {len(th_c)} cut points | \"\n      f\"MCC range [{m_c.min():+.4f}, {m_c.max():+.4f}] | @0.5 {metrics_at(p, yv, 0.5)['mcc']:+.4f}\")\nassert abs(m.get(\"roc_auc\", 0.5) - 0.5) < 0.12, \\\n    f\"untrained ROC-AUC {m.get('roc_auc'):.3f} — a random head should sit near 0.5\"\nprint(\"\\ncell 2 ready\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-24T09:53:51.953385Z","iopub.execute_input":"2026-07-24T09:53:51.95418Z","iopub.status.idle":"2026-07