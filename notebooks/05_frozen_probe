x_length=cfg.max_length, return_tensors=\"pt\")\nids, am = e[\"input_ids\"].clone(), e[\"attention_mask\"]\nmaskable = ~torch.isin(ids, torch.tensor(tok.all_special_ids)) & am.bool()\ntorch.manual_seed(0)\nsel = maskable & (torch.rand(ids.shape) < 0.15)\ntruth = ids.clone(); ids[sel] = tok.mask_token_id\nwith torch.no_grad():\n    lg = mlm(input_ids=ids.cuda(), attention_mask=am.cuda(),\n             token_type_ids=torch.zeros_like(ids).cuda()).logits\nacc = (lg.argmax(-1).cpu()[sel] == truth[sel]).float().mean().item()\nprint(f\"masked-token recovery: {acc:.4f}  (chance = 1/{tok.vocab_size} = {1/tok.vocab_size:.5f})\")\nMLM_OK = (not head_random) and acc > 0.05\nprint(\"MLM head usable:\", MLM_OK)\n\n# --- probe 1: does a variant shift the representation? ---------------------\n@torch.no_grad()\ndef encode(seq_list, bs=64):\n    mp, cl = [], []\n    for i in range(0, len(seq_list), bs):\n        b = tok(seq_list[i:i+bs], padding=True, truncation=True,\n                max_length=cfg.max_length, return_tensors=\"pt\")\n        b = {k: v.cuda() for k, v in b.items()}\n        b[\"token_type_ids\"] = torch.zeros_like(b[\"input_ids\"])\n        with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n            h = base(**b)[0].float()\n        m = b[\"attention_mask\"].unsqueeze(-1).float()\n        mp.append(((h * m).sum(1) / m.sum(1)).cpu()); cl.append(h[:, 0].cpu())\n    return torch.cat(mp).numpy(), torch.cat(cl).numpy()\n\npairs = [ref_alt(r, cfg.window_bp) for r in probe.itertuples()]\nmp_r, cl_r = encode([a for a, _ in pairs])\nmp_a, cl_a = encode([b for _, b in pairs])\n\ndef auc2(s):                          # signal in either direction\n    a = roc_auc_score(y, s)\n    return a, max(a, 1 - a)\n\ncos = 1 - (mp_r * mp_a).sum(1) / (np.linalg.norm(mp_r, axis=1) * np.linalg.norm(mp_a, axis=1))\nprint(\"\\n=== probe 1: embedding shift (frozen backbone, no training) ===\")\nfor nm, s in [(\"cosine dist (mean-pool)\", cos),\n              (\"L2 (mean-pool)\", np.li