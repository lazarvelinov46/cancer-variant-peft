().numpy()\n        if i % (bs * 40) == 0:\n            done = i + len(ch)\n            print(f\"  {done:>6}/{len(rows)}  {done/(time.perf_counter()-t0):6.0f} rows/s\")\n    return HR, HA\n\nfor split in [\"train\", \"val\"]:\n    sub = df[df.split == split].reset_index(drop=True)\n    print(f\"\\n{split}: {len(sub):,} rows\")\n    hr, ha = embed(sub, CACHE_BP)\n    y = sub.label.values.astype(np.int8)\n    genes = sub.gene.values.astype(str)\n    path = f\"{CACHE_DIR}/emb_{split}_{CACHE_BP}bp.npz\"\n    np.savez_compressed(path, h_ref=hr, h_alt=ha, label=y, gene=genes,\n                        mc=sub.mc.values.astype(str),\n                        hard_eval=(sub.hard_eval.values if \"hard_eval\" in sub else\n                                   np.zeros(len(sub), bool)))\n    # integrity: L2-norm AUC must reproduce the probe (0.6511 on the val subsample)\n    from sklearn.metrics import roc_auc_score\n    l2 = np.linalg.norm(hr - ha, axis=1)\n    a = roc_auc_score(y, l2); a = max(a, 1 - a)\n    md5 = hashlib.md5(open(path, \"rb\").read()).hexdigest()[:8]\n    print(f\"  saved {os.path.getsize(path)/1e6:.0f} MB | L2-norm full-{split} AUC {a:.4f} \"\n          f\"| mean |h_alt-h_ref| {l2.mean():.3f} | md5 {md5}\")\n\nprint(\"\\ncache complete:\", sorted(os.listdir(CACHE_DIR)))\nprint(\">>> Save Version now — do not let this session idle out. <<<\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T09:22:48.700667Z","iopub.execute_input":"2026-07-27T09:22:48.70145Z","iopub.status.idle":"2026-07-27T09:31:11.739288Z","shell.execute_reply.started":"2026-07-27T09:22:48.701397Z","shell.execute_reply":"2026-07-27T09:31:11.73861Z"}},"outputs":[{"name":"stderr","text":"/root/.cache/huggingface/modules/transformers_modules/zhihan1996/DNABERT-2-117M/7bce263b15377fc15361f52cfab88f8b586abda0/bert_layers.py:126: UserWarning: Unable to import Triton; defaulting MosaicBERT attention implementation to pytorch (this will reduce throughput when using this model).\n