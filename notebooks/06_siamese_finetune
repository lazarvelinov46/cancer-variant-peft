    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n    fp, fn = k - tp, P - tp; tn = N - fp\n    num = (tp * tn - fp * fn).astype(float)\n    den = np.sqrt((tp + fp).astype(float) * (tp + fn) * (tn + fp) * (tn + fn))\n    m = np.divide(num, den, out=np.zeros_like(num), where=den > 0)\n    j = int(m.argmax())\n    return float(m[j]), float(p[o][j])\n\ndef score(p, y):\n    mcc, thr = mcc_at_best(p, y)\n    return {\"auc\": float(roc_auc_score(y, p)), \"mcc\": mcc, \"thr\": thr}\n\n# ---------- checkpoint I/O ----------------------------------------------------\ndef save_ckpt(path, model, opt, sched, scaler, step):\n    torch.save({\"model\": model.state_dict(), \"opt\": opt.state_dict(),\n                \"sched\": sched.state_dict(), \"scaler\": scaler.state_dict(),\n                \"step\": step, \"cpu_rng\": torch.get_rng_state(),\n                \"cuda_rng\": torch.cuda.get_rng_state()}, path)\n\ndef load_ckpt(path, model, opt, sched, scaler):\n    c = torch.load(path, map_location=\"cuda\", weights_only=False)\n    model.load_state_dict(c[\"model\"]); opt.load_state_dict(c[\"opt\"])\n    sched.load_state_dict(c[\"sched\"]); scaler.load_state_dict(c[\"scaler\"])\n    torch.set_rng_state(c[\"cpu_rng\"]); torch.cuda.set_rng_state(c[\"cuda_rng\"])\n    return c[\"step\"]\n\n# ---------- verification on an UNTRAINED model --------------------------------\ntorch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\nm = fresh_model()\nn_bb  = sum(p.numel() for p in m.backbone.parameters())\nn_hd  = sum(p.numel() for p in m.head.parameters())\nprint(f\"\\ntrainable: backbone {n_bb:,} | head {n_hd:,} | total {n_bb+n_hd:,}\")\n\nt0 = time.perf_counter(); p_sel = evaluate(m, SEL_BATCHES); t_sel = time.perf_counter() - t0\nt0 = time.perf_counter(); p_val = evaluate(m, VAL_BATCHES); t_val = time.perf_counter() - t0\nprint(f\"eval wall-clock: subsample {t_sel:5.1f}s | full val {t_val:5.1f}s \"\n      f\"| eval VRAM {torch.cuda.max_memory_allocated()/2**30:.2f} GB\")