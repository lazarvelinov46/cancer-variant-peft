kaggle/input/**/{n}\", recursive=True); assert h, f\"{n} not found\"; return h[0]\n\ntn = np.load(_find(\"emb_train_1024bp.npz\"), allow_pickle=True)\nvn = np.load(_find(\"emb_val_1024bp.npz\"),   allow_pickle=True)\nDsub = (tn[\"h_alt\"] - tn[\"h_ref\"]).astype(np.float32)[SUB_EMB]\nysub = tn[\"label\"].astype(np.int64)[SUB_EMB]\nDva  = (vn[\"h_alt\"] - vn[\"h_ref\"]).astype(np.float32); yva = vn[\"label\"].astype(np.int64)\nassert len(Dsub) == N_TRAIN and ysub.mean() == 0.5, \"subset mismatch\"\nprint(f\"matched subset: {Dsub.shape} | {ysub.mean():.1%} pos | val {Dva.shape}\\n\")\n\ndef max_mcc(p, y):\n    o = np.argsort(-p, kind=\"mergesort\"); ys = y[o]\n    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n    fp, fn = k - tp, P - tp; tn_ = N - fp\n    num = (tp * tn_ - fp * fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float) * (tp+fn) * (tn_+fp) * (tn_+fn))\n    return np.divide(num, den, out=np.zeros_like(num), where=den > 0).max()\n\ndef head():\n    return nn.Sequential(nn.LayerNorm(768), nn.Linear(768, 256), nn.GELU(),\n                         nn.Dropout(0.2), nn.Linear(256, 2))\n\ndef run(seed, steps=3000, B=24, every=50):\n    torch.manual_seed(seed); r = np.random.default_rng(seed)\n    X, Y, V = torch.tensor(Dsub), torch.tensor(ysub), torch.tensor(Dva)\n    m = head(); opt = torch.optim.AdamW(m.parameters(), lr=1e-3, weight_decay=0.01)\n    lf = nn.CrossEntropyLoss()\n    pos, neg = np.flatnonzero(ysub == 1), np.flatnonzero(ysub == 0)\n    hist = []\n    for s in range(1, steps + 1):\n        ix = np.concatenate([r.choice(pos, B // 2, replace=False),\n                             r.choice(neg, B // 2, replace=False)])\n        m.train(); opt.zero_grad(set_to_none=True)\n        lf(m(X[ix]), Y[ix]).backward(); opt.step()\n        if s % every == 0:\n            m.eval()\n            with torch.no_grad():\n                p = torch.softmax(m(V), 1)[:, 1].numpy()\n            hist.append((s, roc_auc_score(yva[SEL], p[SEL]),\n                         roc_auc_score(yva, p), max_mcc(p, yva)))\n    return np.array(hist)\n\ndef select(H, cutoff):\n    \"\"\"Anchor protocol: top-3 by 2,000-row subsample, then best of those on full val.\"\"\"\n    E = H[H[:, 0] <= cutoff]\n    t3 = np.argsort(-E[:, 1], kind=\"mergesort\")[:3]\n    w  = t3[np.argmax(E[t3, 2])]\n    return E[w, 2], E[w, 3], int(E[w, 0])\n\nres = {1000: [], 3000: []}\nprint(f\"{'seed':>5} {'AUC@1k':>8} {'MCC@1k':>8} {'step':>6} {'AUC@3k':>8} {'MCC@3k':>8} {'step':>6}\")\nfor sd in [0, 1, 2, 3, 4]:\n    H = run(sd)\n    a1, m1, s1 = select(H, 1000); a3, m3, s3 = select(H, 3000)\n    res[1000].append((a1, m1)); res[3000].append((a3, m3))\n    print(f\"{sd:>5} {a1:>8.4f} {m1:>8.4f} {s1:>6} {a3:>8.4f} {m3:>8.4f} {s3:>6}\")\n\nprint(f\"\\n{'budget':<10} {'AUC mean':>9} {'AUC sd':>8} {'MCC mean':>9} {'MCC sd':>8}\")\nout = {}\nfor k in (1000, 3000):\n    A = np.array(res[k]); out[k] = (A[:,0].mean(), A[:,0].std(ddof=1),\n                                    A[:,1].mean(), A[:,1].std(ddof=1))\n    print(f\"{k:<10} {out[k][0]:>9.4f} {out[k][1]:>8.4f} {out[k][2]:>9.4f} {out[k][3]:>8.4f}\")\n\ng, gsd = out[1000][0], out[1000][1]\nprint(f\"\\nMATCHED GATE (N=4096, 1000 steps): {g:.4f} +/- {gsd:.4f} AUC\")\nprint(f\"  anchor must exceed ~{g + 2*gsd:.4f}\")\nprint(f\"  vs full-pool gate 0.7264 (N=37,241): {g - 0.7264:+.4f} \"\n      f\"-> cost of the 9.1x smaller training set\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-28T12:31:24.091932Z","iopub.execute_input":"2026-07-28T12:31:24.092587Z","iopub.status.idle":"2026-07-28T12:32:12.079332Z","shell.execute_reply.started":"2026-07-28T12:31:24.092548Z","shell.execute_reply":"2026-07-28T12:32:12.078314Z"}},"outputs":[{"name":"stdout","text":"matched subset: (4096, 768) | 50.0% pos | val (6450, 768)\n\n seed   AUC@1k   MCC@1k   step   AUC@3k   MCC@3k   step\n    0   0.7065   0.3868   1000   0.7065   0.3868   1000\n    1   0.7095   0.3572    