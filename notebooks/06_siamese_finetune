Add Input > Notebook Output > 05_frozen_probe).\")\n    return hits[0]\n\ntr = np.load(find(\"emb_train_1024bp.npz\"), allow_pickle=True)\nva = np.load(find(\"emb_val_1024bp.npz\"),   allow_pickle=True)\nDtr = (tr[\"h_alt\"] - tr[\"h_ref\"]).astype(np.float32); ytr = tr[\"label\"].astype(np.int64)\nDva = (va[\"h_alt\"] - va[\"h_ref\"]).astype(np.float32); yva = va[\"label\"].astype(np.int64)\nprint(f\"train {Dtr.shape} ({ytr.mean():.1%} pos) | val {Dva.shape} ({yva.mean():.1%} pos)\")\n\nnrm = np.linalg.norm(Dtr, axis=1)\nprint(f\"‖d‖ on train: mean {nrm.mean():.4f} sd {nrm.std():.4f} \"\n      f\"| log‖d‖ mean {np.log(nrm).mean():.3f} sd {np.log(nrm).std():.3f}\")\nprint(f\"‖d‖ alone, val AUC: {roc_auc_score(yva, np.linalg.norm(Dva, axis=1)):.4f}\"\n      f\"   (Step 8c reported 0.6511 on a 2,000-row subsample)\\n\")\n\ndef max_mcc(p, y):\n    o = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n    fp, fn = k - tp, P - tp; tn = N - fp\n    num = (tp*tn - fp*fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float) * (tp+fn) * (tn+fp) * (tn+fn))\n    return np.divide(num, den, out=np.zeros_like(num), where=den > 0).max()\n\n# ---------- head variants -----------------------------------------------------\nclass Head(nn.Module):\n    def __init__(self, mode, hidden=256, dropout=0.2):\n        super().__init__()\n        self.mode = mode\n        d_in = 769 if mode == \"ln_plus_norm\" else 768\n        self.norm = {\"layernorm\":    nn.LayerNorm(768),\n                     \"ln_plus_norm\": nn.LayerNorm(768),\n                     \"batchnorm\":    nn.BatchNorm1d(768),\n                     \"prestandard\":  nn.Identity()}[mode]\n        self.mlp = nn.Sequential(nn.Linear(d_in, hidden), nn.GELU(),\n                                 nn.Dropout(dropout), nn.Linear(hidden, 2))\n    def forward(self, d):\n        z = self.norm(d)\n        if self.mode == \"ln_plus_norm\":\n            z = torch.cat([z, torch.log(d.norm(dim=1, keepdim=True) + 1e-8)], 1)\n        return self.mlp(z)\n\ndef run(mode, steps=3000, B=24, seed=0):\n    torch.manual_seed(seed); rng = np.random.default_rng(seed)\n    Xtr, Xva = Dtr.copy(), Dva.copy()\n    if mode == \"prestandard\":                       # the original 0.734 recipe\n        mu, sd = Xtr.mean(0), Xtr.std(0) + 1e-6\n        Xtr, Xva = (Xtr - mu) / sd, (Xva - mu) / sd\n    Xtr_t = torch.tensor(Xtr); ytr_t = torch.tensor(ytr); Xva_t = torch.tensor(Xva)\n\n    m   = Head(mode)\n    opt = torch.optim.AdamW(m.parameters(), lr=1e-3, weight_decay=0.01)\n    lossfn = nn.CrossEntropyLoss()\n    pos, neg = np.flatnonzero(ytr == 1), np.flatnonzero(ytr == 0)\n    best = (0.0, 0.0, 0)\n    for s in range(1, steps + 1):\n        idx = np.concatenate([rng.choice(pos, B // 2), rng.choice(neg, B // 2)])\n        m.train(); opt.zero_grad(set_to_none=True)\n        loss = lossfn(m(Xtr_t[idx]), ytr_t[idx])\n        loss.backward(); opt.step()\n        if s % 250 == 0:\n            m.eval()\n            with torch.no_grad():\n                p = torch.softmax(m(Xva_t), 1)[:, 1].numpy()\n            a = roc_auc_score(yva, p)\n            if a > best[0]: best = (a, max_mcc(p, yva), s)\n    return best\n\nprint(f\"{'variant':<22} {'val AUC':>9} {'max MCC':>9} {'@step':>7}\")\nfor mode, label in [(\"prestandard\",  \"per-dim train stats\"),\n                    (\"batchnorm\",    \"BatchNorm1d(768)\"),\n                    (\"ln_plus_norm\", \"LayerNorm + log‖d‖\"),\n                    (\"layernorm\",    \"LayerNorm only\")]:\n    a, mcc, st = run(mode)\n    print(f\"{label:<22} {a:>9.4f} {mcc:>9.4f} {st:>7}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-28T09:43:21.049712Z","iopub.execute_input":"2026-07-28T09:43:21.050336Z","iopub.status.idle":"2026-07-28T09:43:54.395852Z","shell.execute_reply.started":"2026-07-28T09:43:21.050303Z","shell.execute_reply":"2026-07-28T09:43: