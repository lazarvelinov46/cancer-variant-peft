= (7, 5), f\"need T4 / cc 7.5 for cost comparability across arms — got {gpu}\"\n\n# ---------- config ------------------------------------------------------------\n@dataclass(frozen=True)\nclass Cfg:\n    model_name: str   = \"zhihan1996/DNABERT-2-117M\"\n    revision:   str   = \"7bce263b15377fc15361f52cfab88f8b586abda0\"\n    window_bp:  int   = 1024          # Step 8c: AUC 0.651 vs 0.618 at 512\n    max_length: int   = 256           # ~209 BPE tokens + specials; asserted no-trunc later\n    hidden:     int   = 256           # Step 11: 512/1024 overfit\n    dropout:    float = 0.2\n    out_root:   str   = \"/kaggle/working/runs\"\n    run_id:     str   = \"siamese_full_ft_n4096_seed0\"\n    seed:       int   = 0\n    sel_seed:   int   = 12345         # frozen across ALL runs\n    sel_n:      int   = 2000\ncfg = Cfg()\nos.makedirs(os.path.join(cfg.out_root, cfg.run_id), exist_ok=True)\n\n# ---------- load --------------------------------------------------------------\nDATA = \"/kaggle/input/cancer-variant-peft-processed\"\nprint(\"dataset dir:\", sorted(os.listdir(DATA)))\nPQ = os.path.join(DATA, \"variant_windows_1024_split_v2.parquet\")\nassert os.path.exists(PQ), \"v2 parquet missing — attach the LATEST dataset version\"\n\ndf = pd.read_parquet(PQ)\nneed = {\"gene\", \"chrom\", \"pos\", \"ref\", \"alt\", \"ref_window\", \"offset\",\n        \"label\", \"split\", \"hard_eval\"}\nassert need <= set(df.columns), f\"missing columns: {need - set(df.columns)}\"\nprint(f\"loaded {len(df):,} rows x {df.shape[1]} cols  |  mc present: {'mc' in df.columns}\")\n\n# ---------- v2 attachment guard (exact, not advisory) -------------------------\nEXPECT = {\"train\": (434, 37_241, 5_309),\n          \"val\":   (155,  6_450, 1_125),\n          \"test\":  ( 40, 48_328, 9_284)}\nprint(f\"\\n{'split':<6} {'genes':>6} {'rows':>8} {'pos':>7} {'pos%':>7}\")\nfor sp, exp in EXPECT.items():\n    s   = df[df.split == sp]\n    got = (s.gene.nunique(), len(s), int(s.label.sum()))\n    print(f\"{sp:<6} {got[0]:>6} {got[1]:>8,} {got[2]:>7,} {got[2]/got[1]:>6.1%}\")\n    assert got == exp, f\"{sp}: expected {exp}, got {got} — STALE dataset version\"\n\nhe = int(df.hard_eval.sum())\nassert he == 1_216 and df[df.hard_eval].split.eq(\"test\").all(), \\\n    f\"hard-eval set wrong: {he} rows, splits {df[df.hard_eval].split.unique()}\"\nprint(f\"hard-eval  : {he:,} movers, all test-side\")\n\ngs = {sp: set(df[df.split == sp].gene) for sp in EXPECT}\nfor a, b in ((\"train\",\"val\"), (\"train\",\"test\"), (\"val\",\"test\")):\n    assert not gs[a] & gs[b], f\"gene leakage {a}/{b}: {sorted(gs[a] & gs[b])[:5]}\"\nprint(\"gene-disjoint: OK (629 genes total)\")\n\n# ---------- window integrity --------------------------------------------------\nwl = df.ref_window.str.len()\nprint(f\"\\nwindow len : min {wl.min()} max {wl.max()} | offset min {df.offset.min()} \"\n      f\"max {df.offset.max()}\")\nchk = df.sample(3000, random_state=0)\nbad = [(r.chrom, r.pos) for r in chk.itertuples() if r.ref_window[r.offset] != r.ref]\nassert not bad, f\"offset/ref mismatch at {bad[:3]}\"\nprint(f\"offset->ref base verified on 3,000 sampled rows: OK\")\n\n# ---------- frozen val-selection subsample ------------------------------------\nval = (df[df.split == \"val\"]\n       .sort_values([\"chrom\", \"pos\", \"ref\", \"alt\"], kind=\"mergesort\")\n       .reset_index(drop=True))\nrng   = np.random.default_rng(cfg.sel_seed)\nn_pos = round(cfg.sel_n * val.label.mean())\npos_i = rng.choice(np.flatnonzero(val.label.values == 1), n_pos,            replace=False)\nneg_i = rng.choice(np.flatnonzero(val.label.values == 0), cfg.sel_n - n_pos, replace=False)\nval_sel = val.iloc[np.sort(np.concatenate([pos_i, neg_i]))].reset_index(drop=True)\n\nfp = hashlib.sha256(\n    \"|\".join(f\"{r.chrom}:{r.pos}{r.ref}>{r.alt}\" for r in val_sel.itertuples())\n    .encode()).hexdigest()[:16]\nprint(f\"\\nval_sel    : {len(val_sel):,} rows | {int(val_sel.label.sum())} pos \"\n      f\"({val_sel.label.mean():.1%}) | fingerprint {fp}\")\n\njson.dump({**asdict(cfg), \"val_sel_fingerprint\": fp, \"gpu\": gpu},\n          open(os.path.join(cfg.out_root, cfg.run_id, \"config.json\"), \"w\"), indent=2)\nprint(\"saved ->\", os.path.join(cfg.out_root, cfg.run_id, \"config.json\"))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Phase 3 · Step 14 — SiameseVariantClassifier: class, load, guards, smoke forward\nimport torch, torch.nn as nn, numpy as np\nfrom transformers import AutoModel, AutoTokenizer\nfrom transformers.models.bert.configuration_bert import BertConfig\n\ntorch.manual_seed(cfg.seed)\n\n# ---------- the model ---------------------------------------------------------\nclass SiameseVariantClassifier(nn.Module):\n    \"\"\"Shared DNABERT-2 backbone; classifies mean-pooled (h_alt - h_ref).\"\"\"\n\n    def __init__(self, backbone, hidden=256, dropout=0.2, n_classes=2):\n        super().__init__()\n        self.backbone = backbone\n        d = backbone.config.hidden_size\n        self.head = nn.Sequential(\n            nn.LayerNorm(d),\n            nn.Linear(d, hidden), nn.GELU(), nn.Dropout(dropout),\n            nn.Linear(hidden, n_classes),\n        )\n\n    def _pool(self, input_ids, attention_mask):\n        out = self.backbone(\n            input_ids=input_ids, attention_mask=attention_mask,\n            token_type_ids=torch.zeros_like(input_ids),   # segment row 1 untrained\n        )[0].float()                                      # fp32 BEFORE pooling\n        m = attention_mask.unsqueeze(-1).float()\n        return (out * m).sum(1) / m.sum(1).clamp(min=1.0)\n\n    def forward(self, ref_ids, ref_mask, alt_ids, alt_mask, return_pooled=False):\n        B = ref_ids.size(0)\n        h = self._pool(torch.cat([ref_ids, alt_ids], 0),\n                       torch.cat([ref_mask, alt_mask], 0))\n        h_ref, h_alt = h[:B], h[B:]\n        logits = self.head(h_alt - h_ref)\n        return (logits, h_ref, h_alt) if return_pooled else logits\n\n# ---------- load --------------------------------------------------------------\ntok = AutoTokenizer.from_pretrained(cfg.model_name, revision=cfg.revision,\n                                    trust_remote_code=True)\nbb_cfg   = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision)\nbackbone = AutoModel.from_pretrained(cfg.model_name, revision=cfg.revision,\n                                     trust_remote_code=True, config=bb_cfg)\n\nassert \"transformers_modules\" in type(backbone).__module__, \\\n    f\"remote code not used — got {type(backbone).__module__}\"\nmm = sys.modules[type(backbone).__module__]\nflash = {k: v for k, v in vars(mm).items() if \"flash\" in k.lower()}\nassert all(v is None for v in flash.values()), f\"FlashAttention live: {flash}\"\nprint(f\"backbone   : {type(backbone).__name__} | eager attention confirmed \"\n      f\"({len(flash)} flash symbols, all None)\")\n\ntorch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\nmodel = SiameseVariantClassifier(backbone, cfg.hidden, cfg.dropout).cuda()\nload_gb = torch.cuda.max_memory_allocated() / 2**30\n\nn_bb   = sum(p.numel() for p in model.backbone.parameters())\nn_head = sum(p.numel() for p in model.head.parameters())\nprint(f\"params     : backbone {n_bb:,} | head {n_head:,} \"\n      f\"({n_head/(n_bb+n_head):.3%} of total)\")\nprint(f\"load VRAM  : {load_gb:.3f} GB  (baseline, pre-training)\")\n\n# ---------- token budget ------------------------------------------------------\nsmp  = df.sample(1000, random_state=0)\nrefs = smp.ref_window.tolist()\nalts = [w[:512] + a + w[513:] for w, a in zip(refs, smp.alt)]\nlens = np.array([len(x) for x in tok(refs + alts)[\"input_ids\"]])\nsame = sum(len(r) == len(a) for r, a in\n           zip(tok(refs)[\"input_ids\"], tok(alts)[\"input_ids\"]))\nprint(f\"\\ntokens/1024bp: min {lens.min()} p50 {int(np.median(lens))} \"\n      f\"p99 {int(np.percentile(lens,99))} max {lens.max()}  (max_length {cfg.max_length})\")\nassert lens.max() <= cfg.max_length, \"TRUNCATION — raise cfg.max_length\"\nprint(f\"ref/alt equal token count: {same}/1000 \"\n      f\"({same/10:.1f}%) — joint padding handles the rest\")\n\n# ---------- smoke forward -----------------------------------------------------\nmodel.eval()\nb = smp.head(8)\nbr, ba = b.ref_window.tolist(), [w[:512]+a+w[513:] for w, a in zip(b.ref_window, b.alt)]\nenc = tok(br + ba, padding=True, truncation=True,\n          max_length=cfg.max_length, return_tensors=\"pt\")\nids, am = enc[\"input_ids\"].cuda(), enc[\"attention_mask\"].cuda()\nwith torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n    lg, hr, ha = model(ids[:8], am[:8], ids[8:], am[8:], return_pooled=True)\n\nd = (ha - hr)\nprint(f\"\\nlogits shape : {tuple(lg.shape)} | dtype {lg.dtype}\")\nprint(f\"||h_ref||    : {hr.norm(dim=1).mean():.4f}\")\nprint(f\"||h_alt-h_ref||: {d.norm(dim=1).mean():.4f} \"\n      f\"(rel {(d.norm(dim=1)/hr.norm(dim=1)).mean():.4%})\")\nprint(f\"pooled dtype : {hr.dtype}  (must be float32)\")\nassert hr.dtype == torch.float32, \"pooling fell back to fp16 — cancellation risk\"\n\nwith torch.no_grad():\n    z = model.head(torch.zeros(1, 768, device=\"cuda\"))\nprint(f\"head(0)      : {z.squeeze().tolist()}  <- ref-vs-ref ablation is degenerate; \"\n      f\"use random-other-base instead\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Phase 3 · Step 15 — pooler removal, collator, batch-ceiling + throughput sweep\nimport gc, time, torch, numpy as np\nfrom transformers import AutoModel\nfrom transformers.models.bert.configuration_bert import BertConfig\n\n# ---------- collator ----------------------------------------------------------\ndef make_batch(rows, tokenizer, max_length):\n    \"\"\"rows: DataFrame slice -> joint-padded ref/alt tensors (equal seq length).\"\"\"\n    refs = rows.ref_window.tolist()\n    alts = [w[:512] + a + w[513:] for w, a in zip(refs, rows.alt)]\n    enc  = tokenizer(refs + alts, padding=True, truncation=True,\n                     max_length=max_length, return_tensors=\"pt\")\n    B    = len(rows)\n    ids, am = enc[\"input_ids\"], enc[\"attention_mask\"]\n    return (ids[:B], am[:B], ids[B:], am[B:],\n            torch.tensor(rows.label.values, dtype=torch.long))\n\ndef fresh_model():\n    bb_cfg = BertConfig.from_pretrained(cfg.model_name, revision=cfg.revision)\n    try:\n        bb = AutoModel.from_pretrained(cfg.model_name, revision=cfg.revision,\n                                       trust_remote_code=True, config=bb_cfg,\n                                       add_pooling_layer=False)\n    except TypeError:\n        bb = AutoModel.from_pretrained(cfg.model_name, revision=cfg.revision,\n                                       trust_remote_code=True, config=bb_cfg)\n        bb.pooler = None                       # never in our forward path\n    assert getattr(bb, \"pooler\", None) is None, \"pooler still attached\"\n    return SiameseVariantClassifier(bb, cfg.hidden, cfg.dropout).cuda()\n\nm0 = fresh_model()\nn_bb   = sum(p.numel() for p in m0.backbone.parameters())\nn_head = sum(p.numel() for p in m0.head.parameters())\nprint(f\"pooler dropped | backbone {n_bb:,} (was 117,068,544, \"\n      f\"delta {117_068_544 - n_bb:,}) | head {n_head:,}\")\nprint(f\"full-FT trainable: {n_bb + n_head:,}\\n\")\ndel m0; gc.collect(); torch.cuda.empty_cache()\n\n# ---------- sweep -------------------------------------------------------------\npool = df[df.split == \"train\"]\nlossfn = torch.nn.CrossEntropyLoss()\nresults, ceiling = [], None\n\nprint(f\"{'B':>4} {'2B seqs':>8} {'ms/step':>9} {'peak GB':>9}  status\")\nfor B in (8, 16, 24, 32, 48, 64):\n    try:\n        torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n        model = fresh_model(); model.train()\n        opt    = torch.optim.AdamW(model.parameters(), lr=2e-5)\n        scaler = torch.amp.GradScaler(\"cuda\")\n        batch  = make_batch(pool.sample(B, random_state=1), tok, cfg.max_length)\n        ri, rm, ai, am_, y = [t.cuda() for t in batch]\n\n        for i in range(8):                      # 3 warmup + 5 timed\n            if i == 3:\n                torch.cuda.synchronize(); t0 = time.perf_counter()\n            opt.zero_grad(set_to_none=True)\n            with torch.amp.autocast(\"cuda\", dtype=torch.float16):\n                logits = model(ri, rm, ai, am_)\n            loss = lossfn(logits.float(), y)\n            scaler.scale(loss).backward()\n            scaler.step(opt); scaler.update()\n            _ = loss.detach().item()\n        torch.cuda.synchronize()\n        ms   = (time.perf_counter() - t0) / 5 * 1000\n        peak = torch.cuda.max_memory_allocated() / 2**30\n        results.append((B, ms, peak))\n        print(f\"{B:>4} {2*B:>8} {ms:>9.1f} {peak:>9.2f}  ok\")\n    except torch.cuda.OutOfMemoryError:\n        ceiling = B\n        print(f\"{B:>4} {2*B:>8} {'—':>9} {'—':>9}  OOM\")\n    finally:\n        for v in (\"opt\", \"scaler\", \"model\", \"ri\", \"rm\", \"ai\", \"am_\", \"y\"):\n            if v in dir(): globals().pop(v, None)\n        gc.collect(); torch.cuda.empty_cache()\n    if ceiling: break\n\n# ---------- read-out ----------------------------------------------------------\nif results:\n    print(f\"\\n{'B':>4} {'ms/step':>9} {'samples/s':>11} {'1000 steps':>12}\")\n    for B, ms, _ in results:\n        print(f\"{B:>4} {ms:>9.1f} {B/ms*1000:>11.1f} {ms*1000/60000:>11.1f}m\")\n    best = max(results, key=lambda r: r[0])\n    print(f\"\\nlargest fitting batch: {best[0]} | {best[2]:.2f} GB peak \"\n          f\"| 1000-step run ≈ {best[1]*1000/60000:.1f} min\")\nprint(f\"OOM ceiling: {ceiling if ceiling else 'not reached by B=64'}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Phase 3 · Step 16 — head normalisation bake-off on cached frozen embeddings (CPU)\nimport os, glob, numpy as np, torch, torch.nn as nn\nfrom sklearn.metrics import roc_auc_score\n\n# ---------- locate the cache --------------------------------------------------\ndef find(name):\n    hits = glob.glob(f\"/kaggle/input/notebooks/lazarvelinov46/05-frozen-probe/embeddings/{name}\", recursive=True)\n    assert hits, (f\"{name} not found. Attach notebook 05's output \"\n                  f\"(Add Input > Notebook Output > 05_frozen_probe).\")\n    return hits[0]\n\ntr = np.load(find(\"emb_train_1024bp.npz\"), allow_pickle=True)\nva = np.load(find(\"emb_val_1024bp.npz\"),   allow_pickle=True)\nDtr = (tr[\"h_alt\"] - tr[\"h_ref\"]).astype(np.float32); ytr = tr[\"label\"].astype(np.int64)\nDva = (va[\"h_alt\"] - va[\"h_ref\"]).astype(np.float32); yva = va[\"label\"].astype(np.int64)\nprint(f\"train {Dtr.shape} ({ytr.mean():.1%} pos) | val {Dva.shape} ({yva.mean():.1%} pos)\")\n\nnrm = np.linalg.norm(Dtr, axis=1)\nprint(f\"‖d‖ on train: mean {nrm.mean():.4f} sd {nrm.std():.4f} \"\n      f\"| log‖d‖ mean {np.log(nrm).mean():.3f} sd {np.log(nrm).std():.3f}\")\nprint(f\"‖d‖ alone, val AUC: {roc_auc_score(yva, np.linalg.norm(Dva, axis=1)):.4f}\"\n      f\"   (Step 8c reported 0.6511 on a 2,000-row subsample)\\n\")\n\ndef max_mcc(p, y):\n    o = np.argsort(-p, kind=\"mergesort\"); ys = y[o].astype(np.int64)\n    P, N = int(ys.sum()), len(ys) - int(ys.sum())\n    tp = np.cumsum(ys); k = np.arange(1, len(ys) + 1)\n    fp, fn = k - tp, P - tp; tn = N - fp\n    num = (tp*tn - fp*fn).astype(float)\n    den = np.sqrt((tp+fp).astype(float) * (tp+fn) * (tn+fp) * (tn+fn))\n    return np.divide(num, den, out=np.zeros_like(num), where=den > 0).max()\n\n# ---------- head variants -----------------------------------------------------\nclass Head(nn.Module):\n    def __init__(self, mode, hidden=256, dropout=0.2):\n        super().__init__()\n        self.mode = mode\n        d_in = 769 if mode == \"ln_plus_norm\" else 768\n        self.norm = {\"layernorm\":    nn.LayerNorm(768),\n                     \"ln_plus_norm\": nn.LayerNorm(7