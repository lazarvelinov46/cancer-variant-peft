d:>5} {r[0]:>9.4f} {r[1]:>9.4f} {r[2]:>10.4f} {r[3]:>10.4f}\")\n\nR = np.array(rows)\nprint(f\"\\n{'':>5} {'mean':>9} {'sd':>9} {'min':>9} {'max':>9}\")\nfor j, name in enumerate([\"best AUC\", \"best MCC\", \"final AUC\", \"final MCC\"]):\n    print(f\"{name:<10} {R[:,j].mean():>9.4f} {R[:,j].std(ddof=1):>9.4f} \"\n          f\"{R[:,j].min():>9.4f} {R[:,j].max():>9.4f}\")\n\nlo, hi = R[:,0].mean() - 2*R[:,0].std(ddof=1), R[:,0].mean() + 2*R[:,0].std(ddof=1)\nprint(f\"\\nDECISION GATE: frozen-backbone head reaches val AUC \"\n      f\"{R[:,0].mean():.4f} +/- {R[:,0].std(ddof=1):.4f} (1 sd)\")\nprint(f\"  the siamese anchor must exceed ~{hi:.4f} to claim fine-tuning helps\")\nprint(f\"  selection optimism (best - final): {(R[:,0]-R[:,2]).mean():+.4f} AUC\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-28T09:44:03.291654Z","iopub.execute_input":"2026-07-28T09:44:03.292619Z","iopub.status.idle":"2026-07-28T09:44:40.318061Z","shell.execute_reply.started":"2026-07-28T09:44:03.292590Z","shell.execute_reply":"2026-07-28T09:44:40.317010Z"}},"outputs":[{"name":"stdout","text":" seed  best AUC  best MCC  final AUC  final MCC\n    0    0.7283    0.3932     0.7174     0.4231\n    1    0.7206    0.4077     0.6905     0.3464\n    2    0.7264    0.3984     0.7199     0.4062\n    3    0.7317    0.4369     0.7315     0.4226\n    4    0.7264    0.4066     0.7141     0.3888\n\n           mean        sd       min       max\nbest AUC      0.7267    0.0040    0.7206    0.7317\nbest MCC      0.4086    0.0169    0.3932    0.4369\nfinal AUC     0.7147    0.0150    0.6905    0.7315\nfinal MCC     0.3974    0.0318    0.3464    0.4231\n\nDECISION GATE: frozen-backbone head reaches val AUC 0.7267 +/- 0.0040 (1 sd)\n  the siamese anchor must exceed ~0.7348 to claim fine-tuning helps\n  selection optimism (best - final): +0.0120 AUC\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# Phase 3 · Step 18 — gate under the anchor's selection protocol (CPU)\n# Requires cell 5 in memory (Dtr/Dva/ytr/yva, Head, max_mcc) + parquet attached.\nimport hashlib, pandas as pd\n\nPQ = \"/kaggle/input/datasets/lazarvelinov46/cancer-variant-peft-processed/variant_windows_1024_split_v2.parquet\"\ndfv = pd.read_parquet(PQ)\n\n# ---------- npz <-> parquet alignment ----------------------------------------\nval_u = dfv[dfv.split == \"val\"].reset_index(drop=True)          # == npz row order\nva_lab = np.load(find(\"emb_val_1024bp.npz\"), allow_pickle=True)[\"label\"].astype(np.int64)\nassert np.array_equal(va_lab, val_u.label.values.astype(np.int64)), \"npz/parquet misaligned\"\nprint(f\"alignment verified on {len(val_u):,} val rows\")\nval_u = val_u.assign(_npz=np.arange(len(val_u)))\n\n# ---------- rebuild the frozen subsample, then map back -----------------------\nval_s = (val_u.sort_values([\"chrom\", \"pos\", \"ref\", \"alt\"], kind=\"mergesort\")\n              .reset_index(drop=True))\nrng   = np.random.default_rng(12345)\nn_pos = round(2000 * val_s.label.mean())\npi = rng.choice(np.flatnonzero(val_s.label.values == 1), n_pos,        replace=False)\nni = rng.choice(np.flatnonzero(val_s.label.values == 0), 2000 - n_pos, replace=False)\nsel = val_s.iloc[np.sort(np.concatenate([pi, ni]))]\n\nfp = hashlib.sha256(\"|\".join(f\"{r.chrom}:{r.pos}{r.ref}>{r.alt}\"\n                             for r in sel.itertuples()).encode()).hexdigest()[:16]\nassert fp == \"46fbf402505ab8a1\", f\"fingerprint drift: {fp}\"\nSEL = sel._npz.values                                            # indices into Dva\nprint(f\"subsample {len(SEL):,} rows | {int(yva[SEL].sum())} pos \"\n      f\"({yva[SEL].mean():.1%}) | fingerprint {fp} OK\\n\")\n\n# ---------- three selection rules, five seeds ---------------------------------\ndef gate(seed, steps=3000, B=24, every=250):\n    torch.manual_seed(seed); r = np.random.default_rng(seed)\n    Xtr_t, ytr_t, Xva_t = torch.tensor(Dtr), torch.tensor(ytr), torch.tensor(Dva)\n    m = Head(\"layernorm\")\n    opt = torch.optim.AdamW(m.parameters(), lr=1e-3, weight_decay=0.01)\n    lossfn = nn.CrossEntropyLoss()\n    pos, neg = np.flatnonzero(ytr == 1), np.flatnonzero(ytr == 0)\n    hist = []\n    for s in range(1, steps + 1):\n        idx = np.concatenate([r.choice(pos, B // 2), r.choice(neg, B // 2)])\n        m.train(); opt.zero_grad(set_to_none=True)\n        lossfn(m(Xtr_t[idx]), ytr_t[idx]).backward(); opt.step()\n        if s % every == 0:\n            m.eval()\n            with torch.no_grad():\n                p = torch.softmax(m(Xva_t), 1)[:, 1].numpy()\n            hist.append((roc_auc_score(yva[SEL], p[SEL]),      # selection signal\n                         roc_auc_score(yva, p), max_mcc(p, yva)))\n    H = np.array(hist)\n    top3 = np.argsort(-H[:, 0], kind=\"mergesort\")[:3]           # anchor protocol\n    win  = top3[np.argmax(H[top3, 1])]\n    return H[win, 1], H[win, 2], H[:, 1].max(), H[-1, 1]\n\nrows = np.array([gate(s) for s in [0, 1, 2, 3, 4]])\nnames = [\"anchor protocol AUC\", \"anchor protocol MCC\", \"best-of-12 AUC\", \"final AUC\"]\nprint(f\"{'':<22} {'mean':>8} {'sd':>8} {'min':>8} {'max':>8}\")\nfor j, n in enumerate(names):\n    c = rows[:, j]\n    print(f\"{n:<22} {c.mean():>8.4f} {c.std(ddof=1):>8.4f} {c.min():>8.4f} {c.max():>8.4f}\")\n\ng, gsd = rows[:, 0].mean(), rows[:, 0].std(ddof=1)\nprint(f\"\\nGATE (anchor-comparable): {g:.4f} +/- {gsd:.4f}\")\nprint(f\"  anchor must exceed ~{g + 2*gsd:.4f} to claim fine-tuning helps\")\nprint(f\"  protocol correction vs best-of-12: {g - rows[:, 2].mean():+.4f} AUC\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-28T09:44:46.501892Z","iopub.execute_input":"2026-07-28T09:44:46.502429Z","iopub.status.idle":"2026-07-28T09:45:25.341190Z","shell.execute_reply.started":"2026-07-28T09:44:46.502399Z","shell.execute_reply":"2026-07-28T09:45:25.340442Z"}},"outputs":[{"name":"stdout","text":"alignment verified on 6,450 val rows\nsubsample 2,000 rows | 349 pos (17.4%) | fingerprint 46f