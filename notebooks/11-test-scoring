< len(y) else np.nan\n\nMIS = strat_te == \"missense\"\nLOF = strat_te == \"LoF\"\n\n# ---------- 1. gene-clustered bootstrap -----------------------------------\ndef quantities(idx):\n    y = y_te[idx]\n    m, l = MIS[idx], LOF[idx]\n    q = {}\n    q[\"comp_gain_auc\"]   = auc_or_nan(y, COMP[idx]) - auc_or_nan(y, tier_te[idx])\n    q[\"comp_gain_auprc\"] = ap_or_nan(y, COMP[idx])  - ap_or_nan(y, tier_te[idx])\n    q[\"mis_full_probe\"]  = (auc_or_nan(y[m], S[\"full\"][idx][m])\n                            - auc_or_nan(y[m], S[\"probe\"][idx][m]))\n    q[\"mis_lora_full\"]   = (auc_or_nan(y[m], S[\"lora\"][idx][m])\n                            - auc_or_nan(y[m], S[\"full\"][idx][m]))\n    q[\"lof_lora_full\"]   = (auc_or_nan(y[l], S[\"lora\"][idx][l])\n                            - auc_or_nan(y[l], S[\"full\"][idx][l]))\n    q[\"dod\"]             = q[\"mis_lora_full\"] - q[\"lof_lora_full\"]\n    q[\"overall_lora_full\"] = auc_or_nan(y, S[\"lora\"][idx]) - auc_or_nan(y, S[\"full\"][idx])\n    return q\n\npoint = quantities(np.arange(len(y_te)))\nboot = collections.defaultdict(list)\nfor b in range(B_BOOT):\n    pick = rng.choice(genes, size=len(genes), replace=True)\n    idx = np.concatenate([GIDX[g] for g in pick])\n    for k, v in quantities(idx).items():\n        if np.isfinite(v):\n            boot[k].append(v)\n\nprint(\"\\n\" + \"=\" * 78)\nprint(f\"GENE-CLUSTERED CONFIDENCE INTERVALS  ({B_BOOT} resamples of 40 genes)\")\nprint(\"=\" * 78)\nLBL = {\"comp_gain_auc\":   \"composite - rule, AUC\",\n       \"comp_gain_auprc\": \"composite - rule, AUPRC\",\n       \"mis_full_probe\":  \"full FT - probe, missense AUC\",\n       \"mis_lora_full\":   \"LoRA - full FT, missense AUC\",\n       \"lof_lora_full\":   \"LoRA - full FT, LoF AUC\",\n       \"dod\":             \"difference-of-differences\",\n       \"overall_lora_full\": \"LoRA - full FT, overall AUC\"}\nprint(f\"{'quantity':<32}{'point':>9}{'95% CI':>22}{'excl. 0':>9}{'n':>7}\")\nCI = {}\nfor k, lab in LBL