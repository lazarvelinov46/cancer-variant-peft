ert abs(mcc_c - mcc_own) <= 0.005, (\n    f\"\\n*** STOP — the §3 probe threshold does not transfer to the collate path \"\n    f\"(MCC {mcc_c:.6f} vs {mcc_own:.6f}). Substituting a threshold here would be \"\n    f\"an undeclared deviation from §3. This is a §6 disclosure decision for \"\n    f\"Lazar, not an automatic fix. Do not run T6. ***\")\nprint(f\"    TRANSFER OK — §3 threshold is valid for S2 on test\")\n\nthr_rule, mcc_rule = max_mcc_thr(tier_va, y_va)\nTHR[\"rule\"] = thr_rule\nprint(f\"\\n  S1 rule   {thr_rule:.6f}   (val max-MCC, val MCC {mcc_rule:.4f}) \"\n      f\"-> decision = tier >= {thr_rule:.0f}\")\nprint(f\"  S5 composite: 2*tier + p_full, threshold-free (AUC/AUPRC only, §2 S5)\")\n\njson.dump({\"thr\": THR, \"composite\": \"2*tier + p_full (pre-commitment §2 S5)\",\n           \"policy\": \"pre-commitment §3 — validation max-MCC at 17.4% \"\n                     \"prevalence, from each run's metrics.json; never re-tuned\"},\n          open(\"/kaggle/working/test_thresholds.json\", \"w\"), indent=2)\n\nprint(\"\\n\" + \"=\" * 74)\nprint(\"T5 OK — mapping verified, strata built, §3 thresholds validated.\")\nprint(\"Next: T6 — 5 systems x 5 strata, per §4.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── nb11 · cell T6 — the §4 reporting matrix (CPU, ~1 min) ─────────────────\n# NEW cell, after T5. Replaces nothing. Tier B only — no exploratory analysis.\n# Every cell of systems x metrics x strata is reported. None omitted.\n\nimport json\nimport numpy as np, pandas as pd\nfrom sklearn.metrics import roc_auc_score, average_precision_score, matthews_corrcoef\n\n# ---------- systems, per pre-commitment §2 --------------------------------\nSCORES = {\n    \"S1 consequence rule\": tier_te,\n    \"S2 frozen probe\":     P_TE[\"probe\"],\n    \"S3 full FT\":          P_TE[\"full\"],\n    \"S4 LoRA r=16\":        P_TE[\"lora\"],\n    \"S5 composite\":        2.0 * tier_te + P_TE[\"full\"],   # §2 S5\n}\nTHRESH = {\"S1 consequence rule\": THR[\"rule\"], \"S2 frozen probe\": THR[\"probe\"],\n          \"S3 full FT\": THR[\"full\"], \"S4 LoRA r=16\": THR[\"lora\"],\n          \"S5 composite\": None}                            # threshold-free\n\nSTRATA = {\n    \"overall\":           np.ones(len(y_te), bool),\n    \"LoF\":               strat_te == \"LoF\",\n    \"missense\":          strat_te == \"missense\",\n    \"silent/non-coding\": strat_te == \"silent/non-coding\",\n    \"hard-eval\":         hard,\n}\n\ndef row(sysname, stratname, mask):\n    y, p = y_te[mask], SCORES[sysname][mask]\n    thr  = THRESH[sysname]\n    n, npos, nneg = int(mask.sum()), int(y.sum()), int((y == 0).sum())\n    r = {\"system\": sysname, \"stratum\": stratname, \"n\": n,\n         \"pos\": npos, \"neg\": nneg}\n    both = 0 < npos < n\n    r[\"auc\"]   = float(roc_auc_score(y, p)) if both else np.nan\n    r[\"auprc\"] = float(average_precision_score(y, p)) if both else np.nan\n    if thr is None:                       # S5: AUC/AUPRC only, §2\n        for k in (\"mcc\", \"f1\", \"precision\", \"recall\", \"tp\", \"tn\", \"fp\", \"fn\"):\n            r[k] = np.nan\n        return r\n    yh = (p >= thr).astype(int)\n    tp = int(((yh == 1) & (y == 1)).sum()); tn = int(((yh == 0) & (y == 0)).sum())\n    fp = int(((yh == 1) & (y == 0)).sum()); fn = int(((yh == 0) & (y == 1)).sum())\n    prec = tp / (tp + fp) if tp + fp else 0.0\n    rec  = tp / (tp + fn) if tp + fn else 0.0\n    r.update({\"mcc\": float(matthews_corrcoef(y, yh)) if both else np.nan,\n              \"f1\": 2 * prec * rec / (prec + rec) if prec + rec else 0.0,\n              \"precision\": prec, \"recall\": rec,\n              \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn})\n    return r\n\nM = pd.DataFrame([row(s, k, m) for s in SCORES for k, m in STRATA.items()])\n\n# ---------- self-check: the rule's AUC is determined by the counts --------\nrule_auc = float(M[(M.system == \"S1 consequence rule\") &\n                   (M.stratum == \"overall\")].auc.iloc[0])\nprint(\"=\" * 78); print(\"SELF-CHECK\")\nprint(f\"  S1 overall AUC {rule_auc:.6f}  (predicted from counts: ~0.9700)\")\nassert abs(rule_auc - 0.9700) < 0.002, (\n    f\"*** rule AUC {rule_auc:.6f} far from the count-determined 0.9700 — \"\n    f\"tier and label vectors may be misaligned. STOP. ***\")\nprint(f\"  tier/label alignment confirmed by construction  OK\")\n\n# ---------- the matrix ----------------------------------------------------\npd.set_option(\"display.width\", 200)\nfor k in STRATA:\n    d = M[M.stratum == k]\n    n, npos, nneg = int(d.n.iloc[0]), int(d.pos.iloc[0]), int(d.neg.iloc[0])\n    print(\"\\n\" + \"=\" * 78)\n    print(f\"{k.upper()}   n={n:,} | pos {npos:,} ({npos/n:.1%}) | neg {nneg:,}\")\n    if min(npos, nneg) < 50:\n        print(f\"  *** only {min(npos, nneg)} rows in the minority class — every \"\n              f\"figure below rests on those; report with counts, no weight ***\")\n    print(\"=\" * 78)\n    print(f\"{'system':<22}{'AUC':>8}{'MCC':>8}{'AUPRC':>8}{'F1':>8}\"\n          f\"{'prec':>8}{'rec':>8}{'tp':>7}{'tn':>8}{'fp':>7}{'fn':>7}\")\n    for _, r in d.iterrows():\n        f = lambda v, w=8, p=4: (f\"{v:>{w}.{p}f}\" if pd.notna(v) else f\"{'—':>{w}}\")\n        g = lambda v, w=7: (f\"{int(v):>{w},}\" if pd.notna(v) else f\"{'—':>{w}}\")\n        print(f\"{r.system:<22}{f(r.auc)}{f(r.mcc)}{f(r.auprc)}{f(r.f1)}\"\n              f\"{f(r.precision)}{f(r.recall)}{g(r.tp)}{g(r.tn,8)}{g(r.fp)}{g(r.fn)}\")\n\n# ---------- oracle upper bound, §3 ---------------------------------------\nprint(\"\\n\" + \"=\" * 78)\nprint(\"ORACLE UPPER BOUND — max-MCC tuned ON TEST\")\nprint(\"  NOT PROSPECTIVELY ACHIEVABLE. Shown per §3; never used for comparison.\")\nprint(\"=\" * 78)\nprint(f\"{'system':<22}{'MCC @ val thr':>15}{'MCC @ test max':>16}\"\n      f\"{'gap':>9}{'test thr':>11}\")\norc = []\nfor s in (\"S2 frozen probe\", \"S3 full FT\", \"S4 LoRA r=16\"):\n    p = SCORES[s]\n    t_thr, t_mcc = max_mcc_thr(p, y_te)\n    v_mcc = float(M[(M.system == s) & (M.stratum == \"overall\")].mcc.iloc[0])\n    orc.append({\"system\": s, \"mcc_val_thr\": v_mcc, \"mcc_test_max\": t_mcc,\n                \"gap\": t_mcc - v_mcc, \"test_thr\": t_thr})\n    print(f\"{s:<22}{v_mcc:>15.4f}{t_mcc:>16.4f}{t_mcc-v_mcc:>+9.4f}{t_thr:>11.4f}\")\n\n# ---------- headline, in the order §7 requires ---------------------------\nprint(\"\\n\" + \"=\" * 78); print(\"HEADLINE (§7.1 — the rule is reported first)\")\nprint(\"=\" * 78)\nov = M[M.stratum == \"overall\"].set_index(\"system\")\nmm = M[M.stratum == \"missense\"].set_index(\"system\")\nprint(f\"{'system':<22}{'overall AUC':>13}{'missense AUC':>14}{'val AUC':>10}\")\nVAL = {\"S1 consequence rule\": 0.9474, \"S2 frozen probe\": 0.7328,\n       \"S3 full FT\": 0.8066, \"S4 LoRA r=16\": 0.7924, \"S5 composite\": 0.9626}\nfor s in SCORES:\n    print(f\"{s:<22}{ov.loc[s,'auc']:>13.4f}{mm.loc[s,'auc']:>14.4f}\"\n          f\"{VAL[s]:>10.4f}\")\nprint(f\"\\n  S5 - S1 gain: {ov.loc['S5 composite','auc']-ov.loc['S1 consequence rule','auc']:+.4f} AUC\"\n      f\" | {ov.loc['S5 composite','auprc']-ov.loc['S1 consequence rule','auprc']:+.4f} AUPRC\"\n      f\"   (val: +0.0151 / +0.1088)\")\n\nM.to_csv(\"/kaggle/working/test_matrix.csv\", index=False)\njson.dump(orc, open(\"/kaggle/working/test_oracle.json\", \"w\"), indent=2)\nprint(f\"\\n-> /kaggle/working/test_matrix.csv ({len(M)} rows) + test_oracle.json\")\nprint(f\"\\n>>> Quick Save. Next: T7 — Tier C exploratory diagnostics. <<<\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── nb11 · cell T7-PRE (REPLACEMENT) — session recovery for T7 (CPU) ───────\n# Replaces T7-PRE in full. Requires: Add Input -> Notebook -> 11-test-scoring\n# (latest version). Saved files live in the VERSION OUTPUT, not /kaggle/working.\n\nimport os, glob, json\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score, average_precision_score\nfrom sc