93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#  nb11 · cell T1 — verify environment, inputs, checkpoints (CPU, ~30 s) ─\n# Run AFTER the manual kernel restart. No model load, no GPU compute.\n\nimport os, sys, glob, json, importlib\nimport numpy as np, pandas as pd, torch\n\nprint(\"=\" * 74); print(\"A. PINS\")\nimport transformers, peft, sklearn, einops\nprint(f\"  python       {sys.version.split()[0]}\")\nprint(f\"  torch        {torch.__version__}\")\nprint(f\"  transformers {transformers.__version__}\")\nprint(f\"  peft         {peft.__version__}\")\nprint(f\"  sklearn      {sklearn.__version__}\")\nprint(f\"  einops       {einops.__version__}\")\nassert transformers.__version__ == \"4.43.4\", \\\n    f\"transformers {transformers.__version__} != 4.43.4 — HARD FAIL, rerun T0\"\n\n# triton/torchao must be GONE — peft can drag triton back in as a torch dep\nfor mod in (\"triton\", \"torchao\"):\n    try:\n        importlib.import_module(mod)\n        raise AssertionError(\n            f\"*** {mod} IS IMPORTABLE — T0's uninstall was undone by the install \"\n            f\"step. Re-run `pip uninstall -y {mod}` and restart before continuing.\")\n    except ImportError:\n        print(f\"  {mod:<12} absent  OK\")\n\nprint(\"\\n\" + \"=\" * 74); print(\"B. DEVICE\")\nassert torch.cuda.is_available(), \"no GPU — attach a T4 accelerator\"\ncap = torch.cuda.get_device_capability(0)\nprint(f\"  device 0     {torch.cuda.get_device_name(0)}  cc {cap[0]}.{cap[1]}\")\nprint(f\"  visible      {torch.cuda.device_count()} device(s)\")\nassert cap == (7, 5), f\"need T4 / cc 7.5 for comparability — got cc {cap}\"\ntorch.cuda.set_device(0)\n\nprint(\"\\n\" + \"=\" * 74); print(\"C. ATTACHED INPUTS\")\nfor d in sorted(glob.glob(\"/kaggle/input/*/*/*\")):\n    print(f\"  {d}\")\n\ndef find_one(pattern, what):\n    hits = glob.glob(pattern, recursive=True)\n    assert len(hits) == 1, f\"{what}: expected 1 match for {pattern}, got {hits}\"\n    return hits[0]\n\nCKPT_DIR = os.path.dirname(find_one(\n    \"/kaggle/input/**/checkpoints/full_ft_step3200.pt\", \"nb09 checkpoints\"))\nNB09_RUNS = os.path.dirname(os.path.dirname(find_one(\n    \"/kaggle/input/**/runs/full_lr2e-05_n37241_s0_fd_nopatience/metrics.json\",\n    \"nb09 runs\")))\nPQ = find_one(\"/kaggle/input/**/variant_windows_1024_split_v2.parquet\", \"v2 parquet\")\nEMB_VAL = find_one(\"/kaggle/input/**/emb_val_1024bp.npz\", \"nb05 val embeddings\")\nprint(f\"\\n  CKPT_DIR   {CKPT_DIR}\")\nprint(f\"  NB09_RUNS  {NB09_RUNS}\")\nprint(f\"  PQ         {PQ}\")\nprint(f\"  EMB_VAL    {EMB_VAL}\")\n\nprint(\"\\n\" + \"=\" * 74); print(\"D. CHECKPOINTS\")\nEXPECT_CK = {\n    \"full_ft_step3200.pt\": dict(params=116_676_866, step=3200, arm=\"full\",\n                                auc=0.8065783620239958, gate=\"gate_f6\"),\n    \"lora_r16_step3000.pt\": dict(params=3_148_034, step=3000, arm=\"lora\",\n                                 auc=0.792393781950965, gate=\"gate_f7\"),\n}\nCK = {}\nfor fn, exp in EXPECT_CK.items():\n    p = os.path.join(CKPT_DIR, fn)\n    assert os.path.exists(p), f\"{fn} missing from {CKPT_DIR}\"\n    c = torch.load(p, map_location=\"cpu\", weights_only=False)\n    n_p = sum(v.numel() for v in c[\"state_dict\"].values())\n    print(f\"\\n  {fn}  ({os.path.getsize(p)/2**20:.2f} MB)\")\n    print(f\"    arm {c['arm']} | step {c['step']} | tensors {len(c['state_dict'])}\"\n          f\" | params {n_p:,}\")\n    print(f\"    val AUC {c['val_auc']!r}\")\n    print(f\"    val MCC {c['val_mcc']:.6f} | val thr {c['val_thr']:.6f}\")\n    print(f\"    run_id  {c['run_id']}\")\n    print(f\"    {exp['gate']} = {c.get(exp['gate'])}\")\n    assert n_p == exp[\"params\"],  f\"{fn}: {n_p:,} params != {exp['params']:,}\"\n    assert c[\"step\"] == exp[\"step\"] and c[\"arm\"] == exp[\"arm\"]\n    assert c[\"val_auc\"] == exp[\"auc\"], f\"{fn}: val_auc {c['val_auc']!r}\"\n    assert c.get