"Test windows are longer than any val window. STOP — scoring now would \"\n    f\"silently truncate and invalidate every test number. ***\")\nprint(f\"  headroom {MAXLEN - int(L.max())} tokens  OK\")\ndel raw, L; gc.collect()\n\nTEST_BATCHES = prebatch(te_f, B_EVAL)\nlens = [b[0].shape[1] for b in TEST_BATCHES]\nprint(f\"  {len(TEST_BATCHES)} batches of <={B_EVAL} | padded len \"\n      f\"{min(lens)}-{max(lens)} | {time.perf_counter()-t0:.0f}s\")\nassert max(lens) < MAXLEN\nY_TEST = y_of(TEST_BATCHES)\nassert len(Y_TEST) == 48_328 and np.array_equal(Y_TEST, te_f.label.values), \\\n    \"y_of(TEST_BATCHES) is not in te_f order\"\nprint(f\"  y_of(TEST_BATCHES) matches te_f order  OK\")\n\nn_seq = 2 * len(te_f)\nprint(f\"\\n  projected {3*n_seq/np.mean([205,155,206])/60:.0f} min for 3 passes\")\n\n# ---------- score ----------------------------------------------------------\nSYS = [(\"probe\", lambda: build_probe(torch.load(HEAD_INIT, map_location=\"cpu\",\n                                                weights_only=False)[\"state_dict\"])),\n       (\"full\",  lambda: build_full(CK[\"full\"][\"state_dict\"])),\n       (\"lora\",  lambda: build_lora_ck(CK[\"lora\"][\"state_dict\"], CK[\"lora\"][\"r\"]))]\n\nP_TEST, RATE_T, PEAK_T = {}, {}, {}\nfor name, builder in SYS:\n    print(\"\\n\" + \"=\" * 74); print(f\"{name.upper()}\")\n    torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n    m = builder()\n    t0 = time.perf_counter()\n    p = evaluate(m, TEST_BATCHES)\n    dt = time.perf_counter() - t0\n    RATE_T[name] = n_seq / dt\n    PEAK_T[name] = torch.cuda.max_memory_allocated() / 2**30\n    del m; gc.collect(); torch.cuda.empty_cache()\n\n    assert p.shape == (48_328,) and np.isfinite(p).all(), \"bad predictions\"\n    P_TEST[name] = p\n    print(f\"  {dt/60:.1f} min | {RATE_T[name]:.0f} seq/s | \"\n          f\"peak {PEAK_T[name]:.2f} GB\")\n    print(f\"  p range {p.min():.6f}..{p.max():.6f} | mean {p.mean():.6f}\")\n    print(f\"  sanity AUC {roc_auc_score(Y_TEST, p):.6f}\")\n\n# ---------- persist --------------------------------------------------------\nOUT = \"/kaggle/working/test_logits.npz\"\nnp.savez_compressed(\n    OUT,\n    p_probe=P_TEST[\"probe\"], p_full=P_TEST[\"full\"], p_lora=P_TEST[\"lora\"],\n    label=Y_TEST,\n    gene=te_f.gene.values.astype(str),\n    mc=te_f.mc.values.astype(str),\n    hard_eval=te_f.hard_eval.values.astype(bool),\n    variation_id=te_f.variation_id.values.astype(str))\n\nmeta = {\"n\": int(len(te_f)), \"pos\": int(Y_TEST.sum()),\n        \"thr_full\": CK[\"full\"][\"val_thr\"], \"thr_lora\": CK[\"lora\"][\"val_thr\"],\n        \"step_full\": CK[\"full\"][\"step\"], \"step_lora\": CK[\"lora\"][\"step\"],\n        \"seq_per_s\": RATE_T, \"peak_gb\": PEAK_T,\n        \"note\": \"thresholds frozen from validation at 17.4% prevalence; \"\n                \"never re-tuned on test\"}\njson.dump(meta, open(\"/kaggle/working/test_meta.json\", \"w\"), indent=2)\n\nprint(\"\\n\" + \"=\" * 74)\nprint(f\"saved {OUT} ({os.path.getsize(OUT)/2**20:.1f} MB) + test_meta.json\")\nprint(f\"  arrays: p_probe p_full p_lora label gene mc hard_eval variation_id\")\nprint(f\"\\n  inference cost: \" + \" | \".join(f\"{k} {v:.0f}\" for k, v in RATE_T.items())\n      + \" seq/s\")\nprint(f\"\\n>>> Quick Save with output NOW — 30 GPU-min of logits are in this file.\")\nprint(f\"    Next: T5, all metrics and strata, CPU only. <<<\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── nb11 · cell T5 (REPLACEMENT 2) — tiers, strata, frozen thresholds (CPU) ─\n# Replaces T5 in full. No metrics matrix — that is T6.\n# Mapping: nb10 D4 verbatim. Thresholds: pre-commitment §3, from metrics.json.\n# Composite: pre-commitment §2 S5 — 2*tier + p_full. Not a runtime choice.\n\nimport os, json, collections\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score, average_precision_score, matthews_corrcoef\n\nZ = np.load(\"/kaggle/working/test_logits.npz\", allow_pickle=True)\ny_te, mc_te = Z[\"label\"].astype(int), Z[\"mc\"]\nhard, gene_te = Z[\"hard_eval\"].astype(bool), Z[\"gene\"].astype(str)\nP_TE = {\"probe\": Z[\"p_probe\"], \"full\": Z[\"p_full\"], \"lora\": Z[\"p_lora\"]}\nassert len(y_te) == 48_328 and y_te.sum() == 9_284 and hard.sum() == 1_216\n\nLOF = {\"SO:0001587\", \"SO:0001575\", \"SO:0001574\"}   # nonsense, splice donor/acceptor\nMIS = {\"SO:0001583\", \"SO:0001582\"}                 # missense, initiator codon\ndef stratum(s):\n    ts = {t.split(\"|\")[0] for t in str(s).split(\",\") if t}\n    if ts & LOF: return \"LoF\"\n    if ts & MIS: return \"missense\"\n    return \"silent/non-coding\"\n\ndef max_mcc_thr(p, y):\n    cand = np.unique(p)\n    if len(cand) > 4000:\n        cand = np.unique(np.quantile(p, np.linspace(0, 1, 4000)))\n    b = max(((float(matthews_corrcoef(y, (p >= t).astype(int))), float(t))\n             for t in cand), key=lambda z: z[0])\n    return b[1], b[0]\n\n# ---------- A. mapping must reproduce nb10 D4 on validation ---------------\nprint(\"=\" * 74); print(\"A. MAPPING VERIFICATION (validation)\")\nzv = np.load(EMB_VAL, allow_pickle=True)\ny_va = zv[\"label\"].astype(int)\nstrat_va = np.array([stratum(s) for s in zv[\"mc\"]])\ntier_va  = np.select([strat_va == \"LoF\", strat_va == \"missense\"], [2.0, 1.0], 0.0)\nEXP_VA = {\"LoF\": (582, 575), \"missense\": (1514, 535), \"silent/non-coding\": (4354, 15)}\nprint(f\"  {'stratum':<20}{'rows':>7}{'pos':>7}{'rate':>8}   (nb10 D4)\")\nfor k, (er, ep) in EXP_VA.items():\n    m = strat_va == k\n    print(f\"  {k:<20}{m.sum():>7,}{y_va[m].sum():>7,}{y_va[m].mean():>8.1%}   ({er:,} / {ep})\")\n    assert (m.sum(), int(y_va[m].sum())) == (er, ep), f\"{k} drift\"\nrva, pva = roc_auc_score(y_va, tier_va), average_precision_score(y_va, tier_va)\nprint(f\"\\n  rule AUC {rva:.4f} (nb10 0.9474) | AUPRC {pva:.4f} (nb10 0.7591)\")\nassert abs(rva - 0.9474) < 5e-5 and abs(pva - 0.7591) < 5e-5\nprint(f\"  MAPPING REPRODUCES nb10 D4 EXACTLY  OK\")\n\n# ---------- B. test strata + composition shift ----------------------------\nprint(\"\\n\" + \"=\" * 74); print(\"B. TEST STRATA\")\nstrat_te = np.array([stratum(s) for s in mc_te])\ntier_te  = np.select([strat_te == \"LoF\", strat_te == \"missense\"], [2.0, 1.0], 0.0)\nEST = {\"LoF\": 4_400, \"missense\": 11_300, \"silent/non-coding\": 32_600}  # §4 estimates\nprint(f\"  {'stratum':<20}{'rows':>8}{'pos':>8}{'rate':>8}{'val rate':>10}{'§4 est':>9}\")\nfor k in (\"LoF\", \"missense\", \"silent/non-coding\"):\n    m, mv = strat_te == k, strat_va == k\n    print(f\"  {k:<20}{m.sum():>8,}{y_te[m].sum():>8,}{y_te[m].mean():>8.1%}\"\n          f\"{y_va[mv].mean():>10.1%}{EST[k]:>9,}\")\nassert sum((strat_te == k).sum() for k in EST) == len(y_te)\n\nprint(f\"\\n  composition shift (val -> test):\")\nfor k in EST:\n    ft, fv = (strat_te == k).mean(), (strat_va == k).mean()\n    print(f\"    {k:<20} test {ft:>6.1%} | val {fv:>6.1%} | {ft-fv:+.1%}\")\n\nprint(f\"\\n  hard-eval: {hard.sum():,} rows | {y_te[hard].sum():,} pos \"\n      f\"({y_te[hard].mean():.1%})\")\nprint(f\"    by stratum: \" + \" | \".join(\n    f\"{k} {int((strat_te[hard]==k).sum()):,} ({int(y_te[hard & (strat_te==k)].sum()):,} pos)\"\n    for k in EST))\n\n# §4: strata with too few positives are 'not estimable', not a number\nprint(f\"\\n  estimability (§4):\")\nfor k in EST:\n    m = strat_te == k\n    npos, nneg = int(y_te[m].sum()), int((~y_te[m].astype(bool)).sum())\n    ok = 0 < npos < m.sum()\n    print(f\"    {k:<20} pos {npos:>6,} neg {nneg:>6,} -> \"\n          f\"{'estimable' if ok else 'NOT ESTIMABLE'}\")\n\n# ---------- C. gene concentration [Tier C — exploratory] ------------------\nprint(\"\\n\" + \"=\" * 74); print(\"C. GENE CONCENTRATION  [Tier C — exploratory]\")\ncnt = collections.Counter(gene_te); top = cnt.most_common(6)\nprint(f\"  40 genes | largest {top[0][1]:,} ({top[0][1]/len(y_te):.1%}) | \"\n      f\"top 5 = {sum(c for _, c in top[:5])/len(y_te):.1%} of rows\")\nfor