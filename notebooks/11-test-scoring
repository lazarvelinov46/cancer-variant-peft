ert c.get(exp[\"gate\"]) == \"passed\", f\"{fn}: {exp['gate']} not passed\"\n    assert c[\"head_fp\"] == \"b6cb4a599948be4d\"\n    assert c[\"plan_fp\"] == \"eb23370c46db3b12\"\n    CK[c[\"arm\"]] = c\n    if c[\"arm\"] == \"lora\":\n        print(f\"    r {c['r']} | alpha {c['lora_alpha']} | {c['lora_config']}\")\n        print(f\"    model {c['model_id']} @ {c['revision'][:12]}\")\n\nHEAD_INIT = os.path.join(CKPT_DIR, \"head_init_fulldata_n37241_s0.pt\")\nassert os.path.exists(HEAD_INIT), \"head_init missing — needed for the frozen probe\"\nhi = torch.load(HEAD_INIT, map_location=\"cpu\", weights_only=False)\nprint(f\"\\n  head_init_fulldata_n37241_s0.pt\")\nprint(f\"    keys {sorted(hi.keys())} | fingerprint {hi.get('fingerprint')}\")\nassert hi.get(\"fingerprint\") == \"b6cb4a599948be4d\"\n\nprint(\"\\n\" + \"=\" * 74); print(\"E. GATE N11 REFERENCE LOGITS\")\nREF_VAL = {}\nfor arm, rid, step in [(\"full\", \"full_lr2e-05_n37241_s0_fd_nopatience\", 3200),\n                       (\"lora\", \"lora_r16_lr0.0001_n37241_s0_fulldata\", 3000)]:\n    z = np.load(os.path.join(NB09_RUNS, rid, \"val_logits_top3.npz\"))\n    key = f\"p_s{step}\"\n    assert key in z.files, f\"{rid}: {key} absent, has {z.files}\"\n    REF_VAL[arm] = {\"p\": z[key], \"y\": z[\"label\"], \"step\": step, \"rid\": rid}\n    print(f\"  {arm:<5} {key}  {z[key].shape[0]:,} rows | \"\n          f\"{int(z['label'].sum()):,} pos ({z['label'].mean():.1%}) | \"\n          f\"p range {z[key].min():.6f}..{z[key].max():.6f}\")\n    assert z[key].shape[0] == 6450 and int(z[\"label\"].sum()) == 1125\n\nprint(\"\\n\" + \"=\" * 74); print(\"F. DATA\")\ndf = pd.read_parquet(PQ)\nprint(f\"  {len(df):,} rows x {df.shape[1]} cols\")\nfor col in (\"gene\", \"ref_window\", \"offset\", \"ref\", \"alt\", \"label\",\n            \"split\", \"mc\", \"hard_eval\"):\n    assert col in df.columns, f\"column {col} missing\"\nEXPECT_SPLIT = {\"train\": (434, 37_241, 5_309), \"val\": (155, 6_450, 1_125),\n                \"test\": (40, 48_328, 9_284)}\nfor sp, exp in EXPECT_SPLIT.items():\n    s = df[df.split == sp]\n    got = (s.gene.nunique(), len(s), int(s.label.sum()))\n    print(f\"  {sp:<6} genes {got[0]:>4} | rows {got[1]:>7,} | \"\n          f\"pos {got[2]:>6,} ({got[2]/got[1]:.1%})\")\n    assert got == exp, f\"{sp}: {got} != {exp} — STALE dataset version\"\nhe = df[df.hard_eval]\nassert len(he) == 1216 and he.split.eq(\"test\").all()\nprint(f\"  hard_eval {len(he):,} rows, all test-side  OK\")\nprint(f\"  test mc terms: {df[df.split=='test'].mc.nunique()} distinct\")\n\nprint(\"\\n\" + \"=\" * 74)\nprint(\"T1 OK — environment, checkpoints and gate references verified.\")\nprint(\"Test set NOT touched. Next: T2 (port build/collate/evaluate from nb09).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T15:46:26.816134Z","iopub.execute_input":"2026-09-13T15:46:26.816512Z","iopub.status.idle":"2026-09-13T15:46:40.950709Z","shell.execute_reply.started":"2026-09-13T15:46:26.816482Z","shell.execute_reply":"2026-09-13T15:46:40.949911Z"}},"outputs":[{"name":"stdout","text":"==========================================================================\nA. PINS\n  python       3.12.13\n  torch        2.10.0+cu128\n  transformers 4.43.4\n  peft         0.19.1\n  sklearn      1.6.1\n  einops       0.8.2\n  triton       absent  OK\n  torchao      absent  OK\n\n==========================================================================\nB. DEVICE\n  device 0     Tesla T4  cc 7.5\n  visible      2 device(s)\n\n==========================================================================\nC. ATTACHED INPUTS\n  /kaggle/input/datasets/lazarvelinov46/cancer-variant-peft-processed\n  /kaggle/input/notebooks/lazarvelinov46/05-frozen-probe\n  /kaggle/input/notebooks/lazarvelinov46/09-lpft-grid-runner\n  /kaggle/input/notebooks/lazarvelinov46/11-test-scoring\n\n  CKPT_DIR   /kaggle/input/notebooks/lazarvelinov46/09-lpft-grid-runner/checkpoints\n  NB09_RUNS  /kaggle/input/notebooks