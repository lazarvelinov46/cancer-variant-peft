0001583\", \"SO:0001582\"}\ndef stratum(s):\n    ts = {t.split(\"|\")[0] for t in str(s).split(\",\") if t}\n    if ts & LOF_SO: return \"LoF\"\n    if ts & MIS_SO: return \"missense\"\n    return \"silent/non-coding\"\n\nstrat_te = np.array([stratum(s) for s in mc_te])\ntier_te  = np.select([strat_te == \"LoF\", strat_te == \"missense\"], [2.0, 1.0], 0.0)\n\nprint(\"\\n\" + \"=\" * 74); print(\"REBUILT\")\nprint(f\"  {len(y_te):,} rows | {y_te.sum():,} pos | {len(np.unique(gene_te))} genes\")\nfor k, exp in ((\"LoF\", (6955, 6931)), (\"missense\", (3856, 1920)),\n               (\"silent/non-coding\", (37517, 433))):\n    m = strat_te == k\n    print(f\"  {k:<20}{m.sum():>7,} rows {int(y_te[m].sum()):>7,} pos\")\n    assert (int(m.sum()), int(y_te[m].sum())) == exp, f\"{k} != T5\"\n\n# ---------- confirm we reproduce T6 exactly -------------------------------\nprint(\"\\n\" + \"=\" * 74); print(\"REPRODUCES T6\")\nCOMP = 2.0 * tier_te + P_TE[\"full\"]\nfor lab, got, exp, tol in [\n        (\"S1 rule AUC\",      roc_auc_score(y_te, tier_te),            0.970026, 5e-6),\n        (\"S1 rule AUPRC\",    average_precision_score(y_te, tier_te),  0.9223,   5e-4),\n        (\"S2 probe AUC\",     roc_auc_score(y_te, P_TE[\"probe\"]),      0.8090,   5e-4),\n        (\"S3 full AUC\",      roc_auc_score(y_te, P_TE[\"full\"]),       0.8359,   5e-4),\n        (\"S4 lora AUC\",      roc_auc_score(y_te, P_TE[\"lora\"]),       0.8594,   5e-4),\n        (\"S5 composite AUC\", roc_auc_score(y_te, COMP),               0.9859,   5e-4)]:\n    ok = abs(got - exp) < tol\n    print(f\"  {'OK ' if ok else 'BAD'} {lab:<20}{got:>10.6f}  (T6 {exp})\")\n    assert ok, f\"{lab}: {got:.6f} != T6 {exp}\"\n\nprint(\"\\n\" + \"=\" * 74)\nprint(f\"T7-PRE OK — restored from {ROOT}\")\nprint(\"Run T7 next. No GPU needed.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── nb11 · cell T7 — robustness and decomposition (CPU, ~2-4 min) ──────────\n# NEW cell, after T7-PRE. Replaces nothing.\n\nimport json, collections\nimport numpy as np, pandas as pd\nfrom sklearn.metrics import roc_auc_score, average_precision_score\nfrom scipy.stats import binomtest\n\nrng = np.random.default_rng(0)\nB_BOOT = 1000\n\ngenes = np.unique(gene_te)\nGIDX = {g: np.flatnonzero(gene_te == g) for g in genes}\nprint(f\"{len(genes)} gene clusters | {len(y_te):,} rows\")\n\nCOMP = 2.0 * tier_te + P_TE[\"full\"]\nS = {\"rule\": tier_te, \"probe\": P_TE[\"probe\"], \"full\": P_TE[\"full\"],\n     \"lora\": P_TE[\"lora\"], \"composite\": COMP}\n\nNAMES = {\"672\": \"BRCA1\", \"675\": \"BRCA2\", \"324\": \"APC\", \"472\": \"ATM\",\n         \"4763\": \"NF1\", \"7249\": \"TSC2\", \"5728\": \"PTEN\", \"7157\": \"TP53\",\n         \"4292\": \"MLH1\", \"5395\": \"PMS2\", \"2956\": \"MSH6\", \"4436\": \"MSH2\"}\nnm = lambda g: f\"{g}({NAMES[g]})\" if g in NAMES else g\n\ndef auc_or_nan(y, p):\n    return float(roc_auc_score(y, p)) if 0 < y.sum() < len(y) else np.nan\n\ndef ap_or_nan(y, p):\n    return float(average_precision_score(y, p)) if 0 < y.sum() < len(y) else np.nan\n\nMIS = strat_te == \"missense\"\nLOF = strat_te == \"LoF\"\n\n# ---------- 1. gene-clustered bootstrap -----------------------------------\ndef quantities(idx):\n    y = y_te[idx]\n    m, l = MIS[idx], LOF[idx]\n    q = {}\n    q[\"comp_gain_auc\"]   = auc_or_nan(y, COMP[idx]) - auc_or_nan(y, tier_te[idx])\n    q[\"comp_gain_auprc\"] = ap_or_nan(y, COMP[idx])  - ap_or_nan(y, tier_te[idx])\n    q[\"mis_full_probe\"]  = (auc_or_nan(y[m], S[\"full\"][idx][m])\n                            - auc_or_nan(y[m], S[\"probe\"][idx][m]))\n    q[\"mis_lora_full\"]   = (auc_or_nan(y[m], S[\"lora\"][idx][m])\n                            - auc_or_nan(y[m], S[\"full\"][idx][m]))\n    q[\"lof_lora_full\"]   = (auc_or_nan(y[l], S[\"lora\"][idx][l])\n                            - auc_or_nan(y[l], S[\"full\"][idx][l]))\n    q[\"dod\"]             = q[\"mis_lora_full\"] - q[\"lof_lora_full\"]\n    q[\"overall_lora_full\"] = auc_or_nan(y, S[\"lora\"][idx]) - auc_or_nan(y, S[\"full\"][idx])\n    return q\n\npoint = quantities(np.arange(len(y_te)))\nboot = collections.defaultdict(list)\nfor b in range(B_BOOT):\n    pick = rng.choice(genes, size=len(genes), replace=True)\n    idx = np.concatenate([GIDX[g] for g in pick])\n    for k, v in quantities(idx).items():\n        if np.isfinite(v):\n            boot[k].append(v)\n\nprint(\"\\n\" + \"=\" * 78)\nprint(f\"GENE-CLUSTERED CONFIDENCE INTERVALS  ({B_BOOT} resamples of 40 genes)\")\nprint(\"=\" * 78)\nLBL = {\"comp_gain_auc\":   \"composite - rule, AUC\",\n       \"comp_gain_auprc\": \"composite - rule, AUPRC\",\n       \"mis_full_probe\":  \"full FT - probe, missense AUC\",\n       \"mis_lora_full\":   \"LoRA - full FT, missense AUC\",\n       \"lof_lora_full\":   \"LoRA - full FT, LoF AUC\",\n       \"dod\":             \"difference-of-differences\",\n       \"overall_lora_full\": \"LoRA - full FT, overall AUC\"}\nprint(f\"{'quantity':<32}{'point':>9}{'95% CI':>22}{'excl. 0':>9}{'n':>7}\")\nCI = {}\nfor k, lab in LBL.items():\n    v = np.array(boot[k])\n    lo, hi = np.percentile(v, [2.5, 97.5])\n    excl = \"yes\" if (lo > 0 or hi < 0) else \"no\"\n    CI[k] = {\"point\": point[k], \"lo\": float(lo), \"hi\": float(hi),\n             \"excludes_zero\": excl == \"yes\", \"n_boot\": int(len(v))}\n    print(f\"{lab:<32}{point[k]:>+9.4f}   {lo:>+8.4f} .. {hi:>+8.4f}\"\n          f\"{excl:>9}{len(v):>7}\")\n\nnb_ = []\nfor b in range(200):\n    i = rng.integers(0, len(y_te), len(y_te))\n    if 0 < y_te[i].sum() < len(i):\n        nb_.append(auc_or_nan(y_te[i], COMP[i]) - auc_or_nan(y_te[i], tier_te[i]))\nnlo, nhi = np.percentile(nb_, [2.5, 97.5])\nprint(f\"\\n  composite - rule AUC, naive row-level CI: {nlo:+.4f} .. {nhi:+.4f} \"\n      f\"(width {nhi-nlo:.4f})\")\nprint(f\"  gene-clustered width {CI['comp_gain_auc']['hi']-CI['comp_gain_auc']['lo']:.4f}\"\n      f\"  -> naive is {(CI['comp_gain_auc']['hi']-CI['comp_gain_auc']['lo'])/(nhi-nlo):.1f}x too narrow\")\n\n# ---------- 2. within-gene vs between-gene decomposition ------------------\nprint(\"\\n\" + \"=\" * 78)\nprint(\"WITHIN-GENE vs BETWEEN-GENE DECOMPOSITION\")\nprint(\"  pooled AUC = (W*within + Bp*between)/(W+Bp), an exact identity over\")\nprint(\"  concordant pos-neg pairs. 'within' is the clinically meaningful part.\")\nprint(\"=\" * 78)\nW = sum(int(y_te[i].sum()) * int((y_te[i] == 0).sum()) for i in GIDX.values())\nTOT = int(y_te.sum()) * int((y_te == 0).sum())\nBp = TOT - W\nprint(f\"  same-gene pos-neg pairs {W:,} of {TOT:,} ({W/TOT:.1%}) | \"\n      f\"cross-gene {Bp:,} ({Bp/TOT:.1%})\")\nprint(f\"\\n{'system':<12}{'pooled':>9}{'within':>9}{'between':>10}{'genes used':>12}\")\nDEC = {}\nfor name, p in S.items():\n    num, den, used = 0.0, 0, 0\n    for g, i in GIDX.items():\n        yg = y_te[i]\n        npos, nneg = int(yg.sum()), int((yg == 0).sum())\n        if npos == 0 or nneg == 0:\n            continue\n        num += roc_auc_score(yg, p[i]) * npos * nneg; den += npos * nneg; used += 1\n    within = num / den\n    pooled = roc_auc_score(y_te, p)\n    between = (pooled * TOT - within * W) / Bp\n    DEC[name] = {\"pooled\": pooled, \"within\": within, \"between\": between,\n                 \"genes_used\": used}\n    print(f\"{name:<12}{pooled:>9.4f}{within:>9.4f}{between:>10.4f}{used:>12}\")\n\n# ---------- 3. per-gene missense lift -------------------------------------\nprint(\"\\n\" + \"=\" * 78)\nprint(\"PER-GENE MISSENSE AUC  (full FT vs frozen probe)\")\nprint(\"=\" * 78)\nrows = []\nfor g, i in GIDX.items():\n    im = i[MIS[i]]\n    yg = y_te[im]\n    if len(im) < 20 or not (0 < yg.sum() < len(yg)):\n        continue\n    rows.append({\"gene\": g, \"n\": len(im), \"pos\": int(yg.sum()),\n                 \"probe\": roc_auc_score(yg, S[\"probe\"][im]),\n                 \"full\":  roc_auc_score(yg, S[\"full\"][im]),\n                 \"lora\":  roc_auc_score(yg, S[\"lora\"][im])})\nG = pd.DataFrame(rows)\nG[\"full_minus_probe\"] = G[\"full\"] - G[\"probe\"]\nG[\"lora_minus_full\"]  = G[\"lora\"] - G[\"full\"]\nG = G.sort_values(\"n\", ascending=False)\nprint(f\"  {len(G)} genes with >=20 missense rows and both classes \"\n      f\"({G.n.sum():,} of {MIS.sum():,} missense rows)\")\npos_lift = int((G.full_minus_probe > 0).sum())\nbt = binomtest(pos_lift, len(G), 0.5)\nprint(f\"  full FT > probe in {pos_lift}/{len(G)} genes | sign test p={bt.pvalue:.4f}\")\nprint(f\"  median lift {G.full_minus_probe.median():+.4f} | \"\n      f\"mean {G.full_minus_probe.mean():+.4f} | \"\n      f\"IQR {G.full_minus_probe.quantile(.25):+.4f}..{G.full_minus_probe.quantile(.75):+.4f}\")\nprint(f\"\\n{'gene':<14}{'n':>6}{'pos':>6}{'probe':>8}{'full':>8}{'lora':>8}\"\n      f\"{'full-probe':>12}\")\nfor _, r in G.head(12).iterrows():\n    print(f\"{nm(r.gene):<14}{int(r.n):>6}{int(r.pos):>6}{r.probe:>8.4f}\"\n          f\"{r['full']:>8.4f}{r.lora:>8.4f}{r.full_minus_probe:>+12.4f}\")\n\nG.to_csv(\"/kaggle/working/test_per_gene.csv\", index=False)\njson.dump({\"post_test\": True, \"n_boot\": B_BOOT, \"n_genes\": len(genes),\n           \"clustered_ci\": CI, \"decomposition\": DEC,\n           \"per_gene_missense\": {\"n_genes\": len(G), \"full_gt_probe\": pos_lift,\n                                 \"sign_test_p\": float(bt.pvalue),\n                                 \"median_lift\": float(G.full_minus_probe.median())}},\n          open(\"/kaggle/working/test_robustness.json\", \"w\"), indent=2)\nprint(f\"\\n-> test_robustness.json + test_per_gene.csv\")\nprint(f\">>> Quick Save immediately — /kaggle/working does not survive. <<<\")","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}