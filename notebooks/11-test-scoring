40, 48_328, 9_284)}\nfor sp, exp in EXPECT_SPLIT.items():\n    s = df[df.split == sp]\n    got = (s.gene.nunique(), len(s), int(s.label.sum()))\n    print(f\"  {sp:<6} genes {got[0]:>4} | rows {got[1]:>7,} | \"\n          f\"pos {got[2]:>6,} ({got[2]/got[1]:.1%})\")\n    assert got == exp, f\"{sp}: {got} != {exp} — STALE dataset version\"\nhe = df[df.hard_eval]\nassert len(he) == 1216 and he.split.eq(\"test\").all()\nprint(f\"  hard_eval {len(he):,} rows, all test-side  OK\")\nprint(f\"  test mc terms: {df[df.split=='test'].mc.nunique()} distinct\")\n\nprint(\"\\n\" + \"=\" * 74)\nprint(\"T1 OK — environment, checkpoints and gate references verified.\")\nprint(\"Test set NOT touched. Next: T2 (port build/collate/evaluate from nb09).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T17:49:45.687433Z","iopub.execute_input":"2026-09-01T17:49:45.687949Z","iopub.status.idle":"2026-09-01T17:49:59.488128Z","shell.execute_reply.started":"2026-09-01T17:49:45.687918Z","shell.execute_reply":"2026-09-01T17:49:59.487228Z"}},"outputs":[{"name":"stdout","text":"==========================================================================\nA. PINS\n  python       3.12.13\n  torch        2.10.0+cu128\n  transformers 4.43.4\n  peft         0.19.1\n  sklearn      1.6.1\n  einops       0.8.2\n  triton       absent  OK\n  torchao      absent  OK\n\n==========================================================================\nB. DEVICE\n  device 0     Tesla T4  cc 7.5\n  visible      2 device(s)\n\n==========================================================================\nC. ATTACHED INPUTS\n  /kaggle/input/datasets/lazarvelinov46/cancer-variant-peft-processed\n  /kaggle/input/notebooks/lazarvelinov46/05-frozen-probe\n  /kaggle/input/notebooks/lazarvelinov46/09-lpft-grid-runner\n\n  CKPT_DIR   /kaggle/input/notebooks/lazarvelinov46/09-lpft-grid-runner/checkpoints\n  NB09_RUNS  /kaggle/input/notebooks/lazarvelinov46/09-lpft-grid-runner/runs\n  PQ         /kaggle/input/datasets/lazarvelinov46/cancer-variant-peft-processed/variant_windows_1024_split_v2.parquet\n  EMB_VAL    /kaggle/input/notebooks/lazarvelinov46/05-frozen-probe/embeddings/emb_val_1024bp.npz\n\n==========================================================================\nD. CHECKPOINTS\n\n  full_ft_step3200.pt  (445.13 MB)\n    arm full | step 3200 | tensors 142 | params 116,676,866\n    val AUC 0.8065783620239958\n    val MCC 0.565574 | val thr 0.771458\n    run_id  full_lr2e-05_n37241_s0_fd_nopatience\n    gate_f6 = passed\n\n  lora_r16_step3000.pt  (12.05 MB)\n    arm lora | step 3000 | tensors 102 | params 3,148,034\n    val AUC 0.792393781950965\n    val MCC 0.555726 | val thr 0.751592\n    run_id  lora_r16_lr0.0001_n37241_s0_fulldata\n    gate_f7 = passed\n    r 16 | alpha 32 | {'lora_dropout': 0.05, 'bias': 'none', 'lora_target_modules': ['Wqkv', 'dense', 'gated_layers', 'wo'], 'task_type': None}\n    model zhihan1996/DNABERT-2-117M @ 7bce263b1537\n\n  head_init_fulldata_n37241_s0.pt\n    keys ['arch', 'cached_sel_auc', 'converged_step', 'fingerprint', 'n_train', 'out_of_grid', 'seed', 'state_dict', 'subset_fp', 'trained_on'] | fingerprint b6cb4a599948be4d\n\n==========================================================================\nE. GATE N11 REFERENCE LOGITS\n  full  p_s3200  6,450 rows | 1,125 pos (17.4%) | p range 0.073258..0.999997\n  lora  p_s3000  6,450 rows | 1,125 pos (17.4%) | p range 0.096343..0.999999\n\n==========================================================================\nF. DATA\n  92,019 rows x 20 cols\n  train  genes  434 | rows  37,241 | pos  5,309 (14.3%)\n  val    genes  155 | rows   6,450 | pos  1,125 (17.4%)\n  test   genes   40 | rows  48,328 | pos  9,284 (19.2%)\n  hard_eval 1,216 rows, all test-side  OK\n  test mc terms: 115 distinct\n\n==========================================================================\nT1 OK — environment, checkpoints and gate references verified.\nTest set NOT touched. Next: T2 (port build/collate/evaluate from nb09).\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ── nb11 · cell T2 (REPLACEMENT) — port from nb09 B2/B3 + CPU metric check ──\n# Replaces T2 in full. CPU only — no .cuda(), test untouched.\n\nimport os, sys, json, time, gc\nimport numpy as np, pandas as pd, torch, torch.nn as nn\nfrom transformers import AutoModel, AutoTokenizer\nfrom transformers.models.bert.configuration_bert import BertConfig\nfrom peft import LoraConfig, get_peft_model\nfrom sklearn.metrics import (roc_auc_score, average_precision_score,\n                             matthews_corrcoef)\n\n# peft 0.19.1 does isinstance(w, torch.distributed.tensor.DTensor) without\n# importing that submodule; torch 2.10 does not expose it implicitly. nb09 got\n# it for free via bitsandbytes. We import it directly — reinstalling bnb here\n# would risk pulling triton back in. No numerical effect.\nprint(f\"torch.distributed.tensor before: {hasattr(torch.distributed, 'tensor')}\")\nimport torch.distributed.tensor  # noqa: F401\nprint(f\"torch.distributed.tensor after : {hasattr(torch.distributed, 'tensor')}\")\n\nMODEL_ID = \"zhihan1996/DNABERT-2-117M\"\nREVISION = \"7bce263b15377fc15361f52cfab88f8b586abda0\"\nMAXLEN, B_EVAL = 256, 64          # nb09 B2: 101 val batches of <=64\nSHARED = os.path.join(NB09_RUNS, \"shared\")\n\npc = json.load(open(os.path.join(SHARED, \"peft_config.json\")))\nprint(f\"\\npeft_config.json: targets {pc['lora_target_modules']} | \"\n      f\"dropout {pc['lora_dropout']} | bias {pc['bias']} | task {pc['task_type']}\")\nck_lc = CK[\"lora\"][\"lora_config\"]\nfor k in (\"lora_dropout\", \"bias\", \"lora_target_modules\", \"task_type\"):\n    assert pc[k] == ck_lc[k], f\"peft_config.json {k}={pc[k]!r} != checkpoint {ck_lc[k]!r}\"\nprint(\"  matches the config embedded in lora_r16_step3000.pt  OK\")\n\ntok  = AutoTokenizer.from_pretrained(MODEL_ID, revision=REVISION,\n                                     trust_remote_code=True)\nbcfg = BertConfig.from_pretrained(MODEL_ID, revision=REVISION)\nprint(f\"tokenizer: vocab {tok.vocab_size:,}\")\n\n# ---------- verbatim from nb09 B3 ------------------------------------------\ndef fresh_backbone():\n    return AutoModel.from_pretrained(MODEL_ID, revision=REVISION, trust_remote_code=True,\n                                     config=bcfg, add_pooling_layer=False)\n\ndef new_head():\n    return nn.Sequential(nn.LayerNorm(768), nn.Linear(768, 256), nn.GELU(),\n                         nn.Dropout(0.2), nn.Linear(256, 2))\n\nclass SiameseVariantClassifier(nn.Module):\n    def __init__(self, backbone, head):\n        super().__init__(); self.backbone, self.head = backbone, head\n    def _pool(self, ids, mask):\n        out = self.backbone(input_ids=ids, attention_mask=mask,\n                            token_type_ids=torch.zeros_like(ids))[0].float()\n        m = mask.unsqueeze(-1).float()\n        return (out * m).sum(1) / m.sum(1).clamp(min=1.0)\n    def forward(self, ref_ids, ref_mask, alt_ids, alt_mask):\n        B = ref_ids.size(0)\n        h = self._pool(torch.cat([ref_ids, alt_ids], 0),\n                       torch.cat([ref_mask, alt_mask], 0))\n        with torch.amp.autocast(\"cuda\", enabled=False):\n            return self.head(h[B:] - h[:B])\n\ndef eager_ok(bb):\n    \"\"\"flash_attn_* symbols must all be None, including through the PEFT wrapper.\"\"\"\n    inner = getattr(getattr(bb, \"base_model\", None), \"model\", bb)\n    mod   = sys.modules[type(inner).__module__]\n    fl    = {k: v for k, v in vars(mod).items() if \"flash\" in k.lower()}\n    return bool(fl) and all(v is None for v in fl.values()), sorted(fl)\n\ndef build_lora(bb, r):\n    return get_peft_model(bb, LoraConfig(\n        r=r, lora_alpha=2 * r, lora_dropout=pc[\"lora_dropout\"], bias=pc[\"bias\"],\n        target_modules=pc[\"lora_target_modules\"], task_type=pc[\"task_type\"]))\n\ndef n_train(m): return sum(p.numel() for p in m.parameters() if p.requires_grad)\n\n# ---------- verbatim from nb09 B2 ------------------------------------------\ndef collate(rows):\n    \"\"\"Joint-tokenize ref+alt so both pad to ONE common length (BPE lengths differ\n    for 27.0% of train / 29.1% of val pairs). offset is 512 on every row.\"\"\"\n    refs = rows.ref_window.tolist()\n    alts = [w[:512] + a + w[513:] for w, a in zip(refs, rows.alt)]\n    enc  = tok(refs + alts, padding=True, truncation=True,\n               max_length=MAXLEN, return_tensors=\"pt\")\n    n = len(rows); ids, am = enc[\"input_ids\"], enc[\"attention_mask\"]\n    return (ids[:n], am[:n], ids[n:], am[n:],\n            torch.tensor(rows.label.values, dtype=torch.long))\n\ndef prebatch(frame, B):\n    \"\"\"Tokenize once, reuse across all evals. Dynamic padding per batch.\"\"\"\n    return [collate(frame.iloc[i:i+B]) for i in range(0, len(frame), B)]\n\ndef y_of(batches):\n    \"\"\"Labels in the exact order `evaluate` returns predictions. NEVER a global.\"\"\"\n    return torch.cat([b[4] for b in batches]).numpy()\n\ndef evaluate(m, batches):\n    m.eval(); out = []\n    with torch.no_grad(), torch.amp.autocast(\"cuda\", dtype=torch.float16):\n        for ri, rm, ai, am_, y in batches:\n            out.append(torch.softmax(m(ri.cuda(), rm.cuda(), ai.cuda(), am_.cuda())\n                                     .float(), 1)[:, 1].cpu())\n    return torch.cat(out).numpy()\n\ndef metrics_at(p, y, thr):\n    yhat = (p >= thr).astype(int)\n    tp = int(((yhat == 1) & (y == 1)).sum()); tn = int(((yhat == 0) & (y == 0)).sum())\n    fp = int(((yhat == 1) & (y == 0)).sum()); fn = int(((yhat == 0) & (y == 1)).sum())\n    prec = tp / (tp + fp) if tp + fp else 0.0\n    rec  = tp / (tp + fn) if tp + fn else 0.0\n    return {\"auc\": float(roc_auc_score(y, p)), \"auprc\": float(average_precision_score(y, p)),\n            \"f1\": 2 * prec * rec / (prec + rec) if prec + rec else 0.0,\n            \"precision\": prec, \"recall\": rec, \"tp\": tp, \"tn\": tn, \"fp\": fp, \"fn\": fn}\n\ndef mcc_at(p, y, thr):\n    \"\"\"MCC at a FIXED threshold. Test thresholds are frozen from val, never tuned.\"\"\"\n    return float(matthews_corrcoef(y, (p >= thr).astype(int)))\n\n# ---------- val frame must match the cached npz row-for-row ----------------\nprint(\"\\n\" + \"=\" * 74); print(\"VAL FRAME ALIGNMENT\")\nva_f = df[df.split == \"val\"].reset_index(drop=True)\nz = np.load(EMB_VAL)\nassert len(va_f) == 6450 == z[\"label\"].shape[0]\nassert np.array_equal(va_f.label.values.astype(np.int8), z[\"label\"]), \\\n    \"va_f label order != emb_val npz — parquet ordering changed\"\nassert np.array_equal(va_f.gene.values.astype(str), z[\"gene\"].astype(str)), \\\n    \"va_f gene order != emb_val npz\"\nprint(f\"  va_f {len(va_f):,} rows, label+gene order matches emb_val_1024bp.npz  OK\")\nfor arm in (\"full\", \"lora\"):\n    assert np.array_equal(REF_VAL[arm][\"y\"], va_f.label.values), \\\n        f\"{arm} stored val logits are not in va_f order\"\nprint(f\"  stored val logits are in va_f order for both arms  OK\")\n\n# ---------- structural checks (CPU) ----------------------------------------\nprint(\"\\n\" + \"=\" * 74); print(\"STRUCTURE\")\nt0 = time.perf_counter()\nbb0, hd0 = fresh_backbone(), new_head()\nnb_, nh_ = (sum(p.numel() for p in bb0.parameters()),\n            sum(p.numel() for p in hd0.parameters()))\nassert (nb_, nh_) == (116_477_952, 198_914), (nb_, nh_)\nok, fl = eager_ok(bb0); assert ok, fl\nprint(f\"  backbone {nb_:,} | head {nh_:,} | eager: {ok} ({len(fl)} symbols)\")\nassert nb_ + nh_ == 116_676_866 == sum(v.numel() for v in CK[\"full\"][\"state_dict\"].values())\nprint(f\"  full-FT checkpoint param count matches bare backbone+head  OK\")\n\nm16 = SiameseVariantClassifier(build_lora(fresh_backbone(), 16), new_head())\ntot = n_train(m16); assert tot - nh_ == 2_949_120, f\"adapter {tot-nh_:,}\"\nassert tot == 3_148_034 == sum(v.numel() for v in CK[\"lora\"][\"state_dict\"].values())\nok2, _ = eager_ok(m16.backbone); assert ok2, \"eager lost through PEFT wrapper